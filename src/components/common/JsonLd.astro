---
import { getJsonLdBlocks } from '~/config/schema';
import type { JsonLdContext } from '~/config/schema/types';

const { title, description, article, schemaMode, schemaOverride, business } = Astro.props as JsonLdContext;

const blocks = getJsonLdBlocks(Astro.url.pathname, { title, description, article, schemaMode, schemaOverride, business });
---

{
  blocks.map((block) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
  ))
}
