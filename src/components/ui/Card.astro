---
/**
 * Card atom — the visual shell for every card on the site.
 *
 * variant:
 *   bordered  (default) — cream bg + rounded + configurable offset shadow + optional
 *                         coloured header band. Used for numbered bucket cards,
 *                         testimonials, service cards, etc.
 *
 *   pillar    — cream bg + rounded + single drop-shadow. Has a label+icon header row
 *               (icon floats to the top-right corner), and a body below. Used for
 *               the "Four Pillars" feature cards (Figma node 2:316).
 *
 *   schedule  — card-light bg + rounded + flat mist offset shadow. Has a calendar-
 *               icon+day-label header band, then a body of event rows from the default
 *               slot. Used for the weekly schedule section (Figma node 2:431).
 *
 *   testimonial — dark glass card (white/10 → white/[0.02] gradient), rounded-[16px],
 *                 p-6. Quote-mark icon (mix-blend-overlay), Fraunces italic quote text,
 *                 small uppercase attribution line. No slot needed — use `quote` and
 *                 `label` props. Used in the testimonials carousel (Figma node 2:1305).
 *
 *   feature     — bg-feature-card (cool #F1F5F8), border border-card-border-light,
 *                 rounded-[16px], overflow-clip. Header band: 40×40 icon tile
 *                 (calendar or book) + uppercase category label. Body: Fraunces 28px
 *                 title, description, and a CTA button.
 *                 Layouts via `featured` / `speaker`:
 *                   compact (default) — title + description row + ghost CTA.
 *                   featured={true}   — tall, grey image placeholder + solid primary CTA.
 *                   speaker set       — session card (Figma 64:1201): title, speaker
 *                                       row, description, ghost CTA pinned bottom-right.
 *                 Used in WrittenWorkSection (2:1375) and SessionCards (64:1201).
 *
 *   dark        — navy→primary gradient shell, rounded-[64px], p-48. Slot holds
 *                 body (eyebrow + heading + copy) and a CTA pinned with mt-auto.
 *                 Used in DuoCards (Figma node 64:1086).
 *
 *   outlined    — 4px navy border, same radius/padding as dark. Slot holds body + CTA.
 *                 Used in DuoCards (Figma node 64:1086).
 *
 *   podcast     — episode card (Figma 121:924 / 121:1293). Cream bg-page fill,
 *                 navy type, tan tag, ghost-light CTA. Same cream card on the
 *                 tan wash (121:916) and the white section (121:1286).
 *
 * ── bordered ──
 * header band:
 *   label          — eyebrow-style text in the band (omit to suppress band entirely)
 *   labelBg        — CSS class for the band background (default: 'bg-card-mist')
 *   labelTextColor — CSS class for the band text (default: 'text-secondary')
 *
 * shadow:
 *   The default shadow is shadow-card (blue accent).
 *   Override via class= (e.g. class="shadow-card-mist" or class="shadow-card-pink").
 *
 * ── pillar ──
 *   label     — eyebrow category label shown left in the header row (e.g. "MOVEMENT")
 *   iconBg    — when true, wraps the <slot name="icon"> in a bg-cta rounded-bl-[12px]
 *               container. Use for icons that don't already carry their own bg.
 *               Default: false (icon SVG occupies the 50×50 area directly).
 *   <slot name="icon"> — SVG for the top-right icon area
 *   <slot>             — card body (heading, description, etc.)
 *
 * Usage:
 *   <Card label="Fill this first">…</Card>
 *
 *   <Card variant="pillar" label="MOVEMENT">
 *     <Fragment slot="icon"><svg>…</svg></Fragment>
 *     <p class="font-heading text-h4 …">Heading</p>
 *     <p class="font-sans text-[12px] …">Description</p>
 *   </Card>
 *
 *   <Card variant="pillar" label="SLEEP" iconBg={true}>
 *     <Fragment slot="icon"><svg>…</svg></Fragment>
 *     …
 *   </Card>
 */

import { twMerge } from 'tailwind-merge';
import Button from '~/components/ui/Button.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';

export interface Props {
  /** Visual treatment. Default: 'bordered'. */
  variant?: 'bordered' | 'pillar' | 'schedule' | 'testimonial' | 'feature' | 'dark' | 'outlined' | 'podcast';

  /**
   * Unused for podcast card chrome (Figma 121:924 and 121:1293 share the same
   * cream fill). Kept so callers can still pass the section tone through.
   */
  tone?: 'light' | 'dark';

  // ── shared ──
  /** Eyebrow / category label shown in the header area. */
  label?: string;
  /** Extra classes on the card root (e.g. to swap the shadow utility). */
  class?: string;

  // ── bordered only ──
  /** CSS class(es) for the header band background. */
  labelBg?: string;
  /** CSS class(es) for the header band label text. */
  labelTextColor?: string;

  // ── testimonial only ──
  /** The quote text (Fraunces italic, 22px). Used by variant="testimonial". */
  quote?: string;

  // ── podcast only ──
  /** 'live' shows a green Live badge + platform links. 'coming-soon' shows a muted badge. */
  status?: 'live' | 'coming-soon';
  /** Spotify episode / show URL. Shown only when status='live'. */
  spotifyUrl?: string;
  /** YouTube episode / playlist URL. Shown only when status='live'. */
  youtubeUrl?: string;

  // ── feature only ──
  /** Card heading (Fraunces 28px text-primary). Used by variant="feature". */
  title?: string;
  /** Body paragraph. Used by variant="feature". */
  description?: string;
  /** CTA button text. Used by variant="feature". Default: "Explore". */
  ctaText?: string;
  /** CTA button href. Used by variant="feature". */
  ctaHref?: string;
  /** Icon shown in the header tile: 'calendar' | 'book'. Default: 'book'. */
  iconType?: 'calendar' | 'book';
  /**
   * When true, renders the tall featured layout: image placeholder (grey box) above
   * the title+description, and a solid primary CTA button. Default: false.
   */
  featured?: boolean;
  /**
   * Speaker / attribution line (session cards). When set on variant="feature"
   * (and featured is false), renders the people-icon row and pins the CTA
   * to the bottom-right so a grid of cards lines up.
   */
  speaker?: string;

  // ── pillar only ──
  /**
   * When true, wraps the `icon` slot in a `bg-cta rounded-bl-[12px]` container.
   * Use for small (≤20px) icons that need the tan background tile treatment.
   * Default: false — the icon SVG fills the 50×50 area directly (for icons that
   * already carry their own background, like the Movement / Food SVGs).
   */
  iconBg?: boolean;
}

const {
  variant = 'bordered',
  label,
  labelBg = 'bg-card-mist',
  labelTextColor = 'text-secondary',
  iconBg = false,
  quote,
  title,
  description,
  ctaText = 'Explore',
  ctaHref = '#',
  iconType = 'book',
  featured = false,
  speaker,
  tone = 'light',
  status,
  spotifyUrl,
  youtubeUrl,
  class: className = '',
} = Astro.props;

// ── bordered ──
const borderedBase =
  'bg-card rounded-none overflow-hidden border-8 border-section-grey flex flex-col gap-4 items-start p-6';

// ── pillar ──
// Single soft drop-shadow (no coloured offset), cream bg, overflow-hidden so
// the icon's rounded-bl-[12px] corner clips properly at the card edge.
const pillarBase =
  'bg-page rounded-none overflow-hidden flex flex-col items-end border-8 border-section-grey';

// ── schedule ──
// Flat mist-color offset shadow, card-light bg (slightly off-white), overflow-hidden.
// Header band: bg-card-light, calendar icon + day label.
// Default slot holds event rows.
const scheduleBase =
  'bg-card rounded-none overflow-hidden flex flex-col gap-4 items-start pb-4 border-8 border-section-grey';

// ── testimonial ──
// Dark glass gradient card. Fixed 512px width is applied at the slide level (Swiper).
// Quote mark SVG (mix-blend-overlay) + Fraunces italic quote + small uppercase attribution.
const testimonialBase =
  'bg-card rounded-none overflow-hidden flex flex-col gap-4 p-4 h-full';

// ── feature ──
// Cool-tinted light card (bg-feature-card). Border + rounded-[16px] + overflow-clip.
// Header: 40×40 icon tile + category label. Body: Fraunces 28px title + description + CTA.
// featured=false → compact with ghost/frosted CTA.
// featured=true  → tall, grey image placeholder, solid primary CTA.
const featureBase =
  'bg-feature-card border-8 border-section-grey rounded-none overflow-clip flex flex-col items-start';

// ── dark / outlined (promo shells, Figma 64:1086) ──
// Shared layout: equal-height flex column, CTA pinned via mt-auto in the slot.
const promoBase =
  'flex h-full min-w-0 flex-col items-start gap-10 rounded-none p-8 md:gap-16 md:p-12';
const darkBase =
  `${promoBase} bg-section-dark`;
const outlinedBase = `${promoBase} bg-card border-8 border-card-dark`;

// ── podcast ──
// Cream card (#f6f5f0 ≈ bg-page), navy type, tan tag, ghost-light CTA.
// Same shell on the tan wash (121:916) and the white section (121:1286).
const podcastBase =
  'flex h-full min-w-0 flex-col items-start gap-3 rounded-none bg-page border-8 border-section-grey p-6';

const variantBase: Record<string, string> = {
  bordered: borderedBase,
  pillar: pillarBase,
  schedule: scheduleBase,
  testimonial: testimonialBase,
  feature: featureBase,
  dark: darkBase,
  outlined: outlinedBase,
  podcast: podcastBase,
};

const base = variantBase[variant] ?? borderedBase;
const cls = twMerge(base, className);

const hasPillarIcon = variant === 'pillar' && Astro.slots.has('icon');

// Header icon tiles are 36px (size-9) on mobile for every card type.
// Desktop restores Figma sizes: pillar 50px, feature 40px.
const pillarIconTile =
  'size-9 shrink-0 sm:size-[50px]';
const featureIconTile =
  'size-9 shrink-0 sm:size-[40px]';
const iconBgGlyph =
  '[&>svg]:size-3.5 sm:[&>svg]:size-5';

// ── Feature card icon tiles ──
// Calendar tile: 14px icon centred in 40×40 bg-card-light rounded-br-[12px] box.
// (The tile bg/radius is applied by the wrapper div, not the SVG itself.)
const calendarTile14Svg = `<svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14" aria-hidden="true"><path d="M13.86 3.08C13.86 2.56 13.65 2.06 13.29 1.69C12.92 1.33 12.42 1.12 11.9 1.12H11.41V0.64C11.41 0.38 11.21 0.15 10.94 0.14C10.88 0.14 10.81 0.15 10.75 0.17C10.69 0.19 10.63 0.23 10.58 0.28C10.53 0.32 10.5 0.38 10.47 0.44C10.44 0.5 10.43 0.56 10.43 0.63V1.12H3.57V0.64C3.57 0.38 3.37 0.15 3.1 0.14C3.04 0.14 2.97 0.15 2.91 0.17C2.85 0.19 2.79 0.23 2.74 0.28C2.69 0.32 2.66 0.38 2.63 0.44C2.6 0.5 2.59 0.56 2.59 0.63V1.12H2.1C1.58 1.12 1.08 1.33 0.71 1.69C0.35 2.06 0.14 2.56 0.14 3.08V3.45C0.14 3.48 0.15 3.51 0.18 3.53C0.2 3.56 0.23 3.57 0.26 3.57H13.74C13.77 3.57 13.8 3.56 13.82 3.53C13.85 3.51 13.86 3.48 13.86 3.45V3.08ZM0.14 11.9C0.14 12.42 0.35 12.92 0.71 13.29C1.08 13.65 1.58 13.86 2.1 13.86H11.9C12.42 13.86 12.92 13.65 13.29 13.29C13.65 12.92 13.86 12.42 13.86 11.9V4.67C13.86 4.64 13.85 4.61 13.82 4.59C13.8 4.56 13.77 4.55 13.74 4.55H0.26C0.23 4.55 0.2 4.56 0.18 4.59C0.15 4.61 0.14 4.64 0.14 4.67V11.9Z" fill="currentColor"/></svg>`;

// Book tile: 40×40 SVG with bg-card-light rounded-br-[28px] path built into the vector.
const bookTileSvg = `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0 0H40V28C40 34.6274 34.6274 40 28 40H0V0Z" fill="#E4EDF2"/><path d="M18.096 13.91C16.816 13.306 15.028 13.011 12.633 13C12.408 12.997 12.186 13.062 11.999 13.187C11.845 13.289 11.719 13.428 11.632 13.59C11.545 13.752 11.5 13.933 11.5 14.116V24.128C11.5 24.805 11.987 25.316 12.633 25.316C15.15 25.316 17.675 25.548 19.187 26.96C19.208 26.98 19.234 26.993 19.262 26.998C19.29 27.003 19.319 26.999 19.345 26.988C19.371 26.977 19.394 26.959 19.409 26.935C19.425 26.911 19.433 26.884 19.433 26.856V15.058C19.433 14.979 19.416 14.9 19.382 14.828C19.349 14.755 19.3 14.691 19.24 14.639C18.893 14.346 18.508 14.101 18.096 13.91ZM28 13.186C27.812 13.062 27.591 12.997 27.365 13C24.971 13.011 23.182 13.305 21.903 13.91C21.49 14.101 21.105 14.345 20.759 14.637C20.698 14.69 20.649 14.754 20.616 14.827C20.583 14.899 20.566 14.978 20.566 15.057V26.855C20.566 26.882 20.574 26.908 20.589 26.931C20.604 26.954 20.626 26.971 20.651 26.982C20.676 26.992 20.704 26.995 20.731 26.99C20.758 26.985 20.783 26.972 20.802 26.953C21.711 26.061 23.307 25.315 27.367 25.315C27.667 25.315 27.956 25.197 28.168 24.987C28.381 24.777 28.5 24.492 28.5 24.195V14.117C28.5 13.933 28.455 13.752 28.368 13.589C28.281 13.427 28.154 13.288 28 13.186Z" fill="#567F9B"/></svg>`;

// Inline quote-mark SVG (24×19, mix-blend-mode:overlay + opacity 0.5, fill #F5F4EF) for testimonial
const quoteSvg = `<svg viewBox="0 0 24 19" fill="none" xmlns="http://www.w3.org/2000/svg" width="24" height="19" aria-hidden="true"><g opacity="0.5" style="mix-blend-mode:overlay"><path d="M5.761 10.312C7.307 10.312 8.477 10.701 9.273 11.479C10.068 12.258 10.466 13.254 10.466 14.467C10.466 15.795 9.989 16.882 9.034 17.729C8.08 18.577 6.909 19 5.523 19C3.932 19 2.614 18.428 1.568 17.283C0.523 16.138 0 14.341 0 11.891C0 9.579 0.432 7.599 1.295 5.95C2.182 4.279 3.284 2.951 4.602 1.967C5.92 0.982 7.239 0.353 8.557 0.078C9.057 -0.036 9.455 -0.025 9.75 0.112C10.045 0.227 10.216 0.444 10.261 0.765C10.329 1.062 10.261 1.349 10.057 1.623C9.852 1.875 9.432 2.127 8.795 2.379C7.659 2.814 6.682 3.398 5.864 4.13C5.045 4.84 4.42 5.618 3.989 6.465C3.58 7.29 3.375 8.091 3.375 8.869C3.375 9.327 3.489 9.682 3.716 9.934C3.966 10.186 4.409 10.312 5.045 10.312H5.761ZM19.295 10.312C20.841 10.312 22.011 10.701 22.807 11.479C23.602 12.235 24 13.231 24 14.467C24 15.795 23.523 16.882 22.568 17.729C21.614 18.577 20.443 19 19.057 19C17.466 19 16.148 18.428 15.102 17.283C14.057 16.115 13.534 14.318 13.534 11.891C13.534 9.579 13.966 7.599 14.829 5.95C15.716 4.279 16.818 2.951 18.136 1.967C19.455 0.982 20.773 0.353 22.091 0.078C22.591 -0.036 22.989 -0.025 23.284 0.112C23.58 0.227 23.75 0.444 23.795 0.765C23.864 1.04 23.795 1.314 23.591 1.589C23.386 1.864 22.966 2.127 22.329 2.379C21.193 2.814 20.216 3.398 19.398 4.13C18.58 4.84 17.966 5.618 17.557 6.465C17.148 7.29 16.943 8.091 16.943 8.869C16.943 9.327 17.057 9.682 17.284 9.934C17.511 10.186 17.943 10.312 18.58 10.312H19.295Z" fill="#F5F4EF"/></g></svg>`;

// Inline calendar SVG (13×13, #7BA3BD fill = text-secondary) for schedule header
const calendarSvg = `<svg viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-[13px] shrink-0"><path d="M12.87 2.86C12.87 2.377 12.678 1.914 12.337 1.573C11.996 1.232 11.533 1.04 11.05 1.04H10.595V0.598C10.595 0.353 10.407 0.143 10.162 0.13C10.1 0.128 10.039 0.137 9.981 0.159C9.923 0.18 9.871 0.213 9.826 0.256C9.782 0.298 9.746 0.349 9.722 0.406C9.698 0.462 9.685 0.523 9.685 0.585V1.04H3.315V0.598C3.315 0.353 3.127 0.143 2.882 0.13C2.82 0.128 2.759 0.137 2.701 0.159C2.643 0.18 2.591 0.213 2.546 0.256C2.502 0.298 2.466 0.349 2.442 0.406C2.418 0.462 2.405 0.523 2.405 0.585V1.04H1.95C1.467 1.04 1.004 1.232 0.663 1.573C0.322 1.914 0.13 2.377 0.13 2.86V3.201C0.13 3.231 0.142 3.26 0.163 3.282C0.185 3.303 0.214 3.315 0.244 3.315H12.756C12.786 3.315 12.815 3.303 12.837 3.282C12.858 3.26 12.87 3.231 12.87 3.201V2.86ZM0.13 11.05C0.13 11.533 0.322 11.996 0.663 12.337C1.004 12.678 1.467 12.87 1.95 12.87H11.05C11.533 12.87 11.996 12.678 12.337 12.337C12.678 11.996 12.87 11.533 12.87 11.05V4.339C12.87 4.309 12.858 4.28 12.837 4.258C12.815 4.237 12.786 4.225 12.756 4.225H0.244C0.214 4.225 0.185 4.237 0.163 4.258C0.142 4.28 0.13 4.309 0.13 4.339V11.05Z" fill="currentColor"/></svg>`;

// People / group icon (16×16) for feature session speaker row
const peopleSvg = `<svg viewBox="0 0 16 16" fill="currentColor" class="size-4 shrink-0" aria-hidden="true"><path d="M10.5 8c-.642 0-1.263-.287-1.75-.808-.473-.508-.761-1.185-.812-1.906-.054-.77.18-1.477.661-1.993C9.078 2.778 9.75 2.5 10.5 2.5c.744 0 1.418.283 1.897.797.483.52.718 1.225.664 1.988-.053.722-.341 1.399-.813 1.906C11.763 7.713 11.143 8 10.5 8z"/><path d="M14.619 13.5H6.38a.627.627 0 01-.621-.638c.263-1.057.915-1.933 1.885-2.534.86-.533 1.957-.827 3.086-.827 1.152 0 2.219.281 3.085.814.972.598 1.625 1.479 1.887 2.548a.627.627 0 01-.083.324.63.63 0 01-.23.228.627.627 0 01-.37.085z"/><path d="M4.593 8.125c-1.1 0-2.066-1.022-2.156-2.279a2.12 2.12 0 01.563-1.676A2.076 2.076 0 014.593 3.5c.625 0 1.188.24 1.591.674.41.44.61 1.034.563 1.672-.09 1.256-1.056 2.279-2.154 2.279z"/><path d="M6.645 9.108c-.55-.269-1.263-.403-2.051-.403-.92 0-1.814.24-2.517.675-.797.495-1.334 1.215-1.55 2.085a.625.625 0 00.19.637.628.628 0 00.436.398H4.77a.066.066 0 00.065-.058c.265-1.064.886-1.963 1.804-2.619a.069.069 0 00.004-.115c-.054-.03-.11-.06-.198-.1z"/></svg>`;
---

{variant === 'pillar' ? (
  <div class={cls}>

    {/* ── Header row: label (left) + icon (right, top-corner) ── */}
    <div class="flex min-h-9 w-full shrink-0 items-center gap-4 pl-4 sm:min-h-[50px]">
      {label && (
        <span class="flex-1 font-sans text-[12px] uppercase tracking-[0.06em] text-accent">
          {label}
        </span>
      )}

      {hasPillarIcon && (
        iconBg ? (
          <div class:list={['flex items-center justify-center rounded-bl-[8px] bg-cta sm:rounded-bl-[12px]', pillarIconTile, iconBgGlyph]}>
            <slot name="icon" />
          </div>
        ) : (
          <div class:list={['overflow-clip [&>svg]:size-full', pillarIconTile]}>
            <slot name="icon" />
          </div>
        )
      )}
    </div>

    {/* ── Body ── */}
    <div class="flex w-full flex-1 flex-col gap-4 px-4 pb-4">
      <slot />
    </div>

  </div>
) : variant === 'schedule' ? (
  <div class={cls}>

    {/* ── Header band: calendar icon + day label ── */}
    <div class="bg-card-light flex w-full shrink-0 items-center gap-2 p-4">
      <span class="text-secondary" set:html={calendarSvg} />
      {label && (
        <span class="font-sans text-[12px] uppercase tracking-[0.06em] text-secondary">
          {label}
        </span>
      )}
    </div>

    {/* ── Event rows ── */}
    <slot />

  </div>
) : variant === 'testimonial' ? (
  <div class={cls}>

    {/* Quote mark (mix-blend-overlay) */}
    <span set:html={quoteSvg} />

    {/* ── Quote text — Fraunces italic, 22px, light cream ── */}
    {quote && (
      <p class="type-quote flex-1 text-heading">
        {quote}
      </p>
    )}

    {/* ── Attribution — small uppercase sans, muted ── */}
    {label && (
      <p class="font-sans text-[14px] uppercase tracking-[0.06em] text-eyebrow">
        {label}
      </p>
    )}

  </div>
) : variant === 'feature' ? (
  <div class={cls}>

    {/* ── Header: icon tile + category label ── */}
    <div class="flex w-full shrink-0 items-center gap-3 pb-4">
      {iconType === 'calendar' ? (
        <div class:list={['flex items-center justify-center rounded-br-[8px] bg-card-light text-accent sm:rounded-br-[12px]', featureIconTile]}>
          <span class="[&>svg]:size-3.5" set:html={calendarTile14Svg} />
        </div>
      ) : (
        <span class:list={['overflow-clip [&_svg]:size-full', featureIconTile]} set:html={bookTileSvg} />
      )}
      {label && (
        <span class="font-sans text-[12px] uppercase tracking-[0.06em] text-accent">
          {label}
        </span>
      )}
    </div>

    {featured ? (
      /* ── TALL / FEATURED layout: image placeholder + footer row ── */
      <div class="flex w-full flex-1 flex-col gap-6 px-4 pb-4">
        {/* TODO: replace with <Image> when asset is ready */}
        <HeroImagePlaceholder
          fill
          label={title ? `${title} image placeholder` : undefined}
          class="min-h-[160px] w-full flex-1 rounded-[16px]"
        />
        <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-start">
          <div class="flex min-w-0 flex-1 flex-col gap-4">
            {title && (
              <p class="font-heading text-h4 text-primary">{title}</p>
            )}
            {description && (
              <p class="font-sans text-[12px] leading-[1.3] text-default">{description}</p>
            )}
          </div>
          <Button
            variant="primary"
            text={ctaText}
            href={ctaHref}
            hideNote={true}
            class="shrink-0 whitespace-nowrap"
          />
        </div>
      </div>
    ) : speaker ? (
      /* ── SESSION layout: title + speaker + description, ghost CTA bottom-right ── */
      <div class="flex w-full flex-1 flex-col gap-4 px-4 pb-4">
        {title && (
          <p class="font-heading text-h4 text-primary">{title}</p>
        )}
        <div class="flex w-full flex-1 flex-col items-end gap-6">
          <div class="flex w-full flex-col items-start gap-3">
            <div class="flex items-center gap-1.5 text-muted">
              <span class="opacity-60" set:html={peopleSvg} />
              <span class="font-sans text-[12px] uppercase tracking-[0.06em] text-muted opacity-60">
                {speaker}
              </span>
            </div>
            {description && (
              <p class="font-sans text-[12px] leading-[1.3] text-muted">{description}</p>
            )}
          </div>
          <Button
            variant="ghost"
            tone="light"
            text={ctaText}
            href={ctaHref}
            hideNote={true}
            class="mt-auto self-end shrink-0 whitespace-nowrap"
          />
        </div>
      </div>
    ) : (
      /* ── COMPACT layout: title + description row + ghost CTA ── */
      <div class="flex w-full flex-col gap-4 px-4 pb-4">
        {title && (
          <p class="font-heading text-h4 text-primary">{title}</p>
        )}
        <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center sm:gap-6">
          {description && (
            <p class="flex-1 font-sans text-[12px] leading-[1.3] text-default">{description}</p>
          )}
          <Button
            variant="ghost"
            tone="light"
            text={ctaText}
            href={ctaHref}
            hideNote={true}
            class="shrink-0 whitespace-nowrap"
          />
        </div>
      </div>
    )}

  </div>
) : variant === 'podcast' ? (
  <div class={cls}>
    <div class="flex w-full flex-col gap-3">
      <div class="flex w-full items-start justify-between gap-3">
        {title && (
          <p class="font-heading text-h4 font-normal leading-none text-heading">
            {title}
          </p>
        )}
        {status && (
          <span class:list={[
            'shrink-0 rounded-full px-3 py-1.5 font-sans text-[10px] uppercase tracking-[0.08em] leading-none whitespace-nowrap',
            status === 'live'
              ? 'bg-accent/15 text-accent font-semibold'
              : 'bg-primary/10 text-primary/50',
          ]}>
            {status === 'live' ? 'Live Now' : 'Coming Soon'}
          </span>
        )}
        {!status && label && (
          <span class="shrink-0 rounded-full bg-cta px-4 py-2 font-sans text-[11px] uppercase tracking-[0.06em] text-eyebrow shadow-[4px_4px_2px_rgba(0,0,0,0.05)]">
            {label}
          </span>
        )}
      </div>
      {/* Show part category label when no status badge already consumed it */}
      {label && status && (
        <span class="font-sans text-[11px] uppercase tracking-[0.06em] text-eyebrow">
          {label}
        </span>
      )}
      {description && (
        <p class="font-sans text-body leading-[1.3] text-primary/60">
          {description}
        </p>
      )}
    </div>

    <div class="mt-auto flex w-full flex-wrap items-center gap-3">
      {status === 'live' && spotifyUrl && (
        <a
          href={spotifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Listen on Spotify"
          class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#1DB954] transition-opacity hover:opacity-80"
        >
          {/* Spotify "S" glyph */}
          <svg viewBox="0 0 24 24" fill="white" class="size-5" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424a.623.623 0 01-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 11-.277-1.215c3.809-.87 7.076-.496 9.712 1.115a.622.622 0 01.207.857zm1.223-2.722a.78.78 0 01-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 01-.973-.518.781.781 0 01.518-.973c3.632-1.102 8.147-.568 11.234 1.328a.78.78 0 01.258 1.072zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71a.937.937 0 11-.543-1.794c3.548-1.076 9.45-.868 13.18 1.336a.937.937 0 01-.32 1.615z"/></svg>
        </a>
      )}
      {status === 'live' && youtubeUrl && (
        <a
          href={youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Watch on YouTube"
          class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#FF0000] transition-opacity hover:opacity-80"
        >
          {/* YouTube play triangle */}
          <svg viewBox="0 0 24 24" fill="white" class="size-5" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      )}
      {status === 'coming-soon' && (
        <span class="flex h-10 shrink-0 items-center gap-1.5 font-sans text-[12px] text-primary/40 italic">
          Episode drops soon
        </span>
      )}
      {ctaHref && ctaHref !== '#' && (
        <Button
          variant="ghost"
          tone="light"
          text={ctaText}
          href={ctaHref}
          hideNote={true}
          class="ml-auto h-10 shrink-0 whitespace-nowrap rounded-[12px] px-5 py-3 text-[12px]"
        />
      )}
    </div>
  </div>
) : variant === 'dark' || variant === 'outlined' ? (
  <div class={cls}>
    <slot />
  </div>
) : (
  <div class={cls}>
    {label && (
      <div class:list={['flex items-center px-4 py-2 shrink-0 w-full', labelBg]}>
        <span class:list={['type-eyebrow font-script', labelTextColor]}>{label}</span>
      </div>
    )}
    <slot />
  </div>
)}
