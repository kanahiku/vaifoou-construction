---
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface ProjectTag {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description: string;
  tags?: ProjectTag[];
  beforeImage?: ContentImage;
  afterImage?: ContentImage;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  title,
  description,
  tags = [],
  beforeImage,
  afterImage,
  beforeLabel = 'Before',
  afterLabel = 'After',
} = Astro.props;

const frames = [
  { label: beforeLabel, image: beforeImage },
  { label: afterLabel, image: afterImage },
];
---

<article class="flex flex-col overflow-hidden border border-banner-line bg-white">
  <div class="grid grid-cols-1 gap-px bg-banner-line md:grid-cols-2">
    {
      frames.map((label) => (
        <div class="relative bg-section-grey p-2">
          <div class="relative aspect-[9/16] w-full overflow-hidden bg-card">
            {label.image?.src ? (
              <Image
                src={label.image.src}
                alt={label.image.alt || `${title} ${label.label.toLowerCase()} photo`}
                class="absolute inset-0 h-full w-full max-w-none object-cover"
                widths={[480, 640, 828, 960, 1200]}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                width={900}
                height={1600}
                layout="cover"
                format="webp"
                quality={84}
              />
            ) : (
              <div class="h-full w-full bg-section-grey" aria-hidden="true" />
            )}
          </div>
          <div class="absolute left-3 top-3 bg-heading px-2.5 py-1 font-display text-[11px] font-bold leading-4 tracking-[0.8px] text-page-end uppercase">
            {label.label}
          </div>
        </div>
      ))
    }
  </div>

  <div class="flex flex-1 flex-col gap-5 p-6 md:p-8">
    <div class="flex flex-col gap-1">
      <h2
        class="font-display text-[24px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[28px] md:leading-8"
      >
        {title}
      </h2>
      <p class="mt-3 font-body text-[15px] font-normal leading-7 text-banner-note">
        {description}
      </p>
    </div>

    {
      tags.length > 0 && (
        <div class="flex flex-col gap-3">
          <p class="font-body text-[12px] font-bold leading-4 tracking-[1px] text-muted uppercase">
            Services Tied to This Project
          </p>
          <div class="flex flex-wrap gap-2">
            {tags.map(({ label, href }) =>
              href ? (
                <a
                  href={href}
                  class="border border-banner-line bg-card px-3 py-2 font-display text-[13px] font-bold leading-4 tracking-[0.6px] text-heading uppercase transition-colors hover:border-nav-cta hover:text-nav-cta"
                >
                  {label}
                </a>
              ) : (
                <span class="border border-banner-line bg-card px-3 py-2 font-display text-[13px] font-bold leading-4 tracking-[0.6px] text-heading uppercase">
                  {label}
                </span>
              )
            )}
          </div>
        </div>
      )
    }
  </div>
</article>
