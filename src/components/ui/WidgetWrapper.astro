---
import type { HTMLTag } from 'astro/types';
import type { Widget } from '~/types';
import { twMerge } from 'tailwind-merge';

export interface Props extends Widget {
  containerClass?: string;
  ['as']?: HTMLTag;
}

const { id, isDark = false, containerClass = '', bg, as = 'section', animate = true } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="relative not-prose scroll-mt-[72px]" {...id ? { id } : {}}>
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-[1]" aria-hidden="true">
    <slot name="bg">
      {
        bg ? (
          <Fragment set:html={bg} />
        ) : (
          <div class:list={['absolute inset-0', { 'bg-dark dark:bg-transparent': isDark }]} />
        )
      }
    </slot>
  </div>
  <div
    class:list={[
      twMerge(
        [
          'relative mx-auto max-w-container px-5 py-8 text-default motion-safe:md:px-16 md:py-16 lg:py-20',
          animate &&
            'intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
        ]
          .filter(Boolean)
          .join(' '),
        containerClass
      ),
      { dark: isDark },
    ]}
  >
    <slot />
  </div>
</WrapperTag>
