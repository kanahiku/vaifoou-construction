---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

interface ExtendedProps extends Props {
  isDark?: boolean;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  isDark = false,
  classes = {},
} = Astro.props as ExtendedProps;

const {
  container: containerClass = '',
  title: titleClass = '',
  subtitle: subtitleClass = '',
} = classes;

// Barlow Condensed for the heading, Work Sans for the subtitle
const titleTypography = 'text-h2 font-normal font-display leading-none';
const subtitleTypography = 'text-body font-normal font-body';

// Color classes based on isDark
const titleColor = isDark ? 'text-headline-dark' : 'text-headline-light';
const subtitleColor = isDark ? 'text-headline-subtitle-dark' : 'text-headline-subtitle-light';
const displayTitle = tagline ? `${tagline}: ${title}` : title;
---

{
  (displayTitle || subtitle) && (
    <div class={twMerge('mb-[30px] text-left', containerClass)}>
      {displayTitle && (
        <h2
          class={twMerge(titleTypography, titleColor, titleClass)}
          set:html={displayTitle}
        />
      )}

      {subtitle && <p class={twMerge('mt-6', subtitleTypography, subtitleColor, subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
