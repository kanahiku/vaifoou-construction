---
/**
 * ComparisonTable — the single shared table component for the entire site.
 *
 * Visual design matches the "Service Scope" table on /services/:
 *  • Bordered container with overflow clip
 *  • Dark full-width header bar (bg-footer)
 *  • Alternating row backgrounds (bg-white / bg-section-grey)
 *  • Vertical column dividers
 *
 * Used directly by BlogArticleBody, CmsSections, and internally by ServiceTable.
 */

export interface TableRow {
  /** Text shown in the first (feature/label) column. */
  feature: string;
  /** One value per data column; length must match `columns`. */
  values: string[];
}

export interface Props {
  /** Header for the row-label column. Defaults to "Feature". */
  featureLabel?: string;
  /** Headers for the data columns (1–4 supported). */
  columns: string[];
  /** Table rows. */
  rows: TableRow[];
  /** Optional caption rendered below the table. */
  caption?: string;
  /**
   * Minimum width of the scrollable table (CSS value).
   * Auto-calculated from column count when omitted.
   */
  minWidth?: string;
}

const { featureLabel = 'Feature', columns, rows, caption, minWidth } = Astro.props;

const autoMinWidth =
  columns.length <= 1 ? '380px' : columns.length === 2 ? '560px' : '680px';
const tableMinWidth = minWidth ?? autoMinWidth;

/** Strip bullet characters and collapse line-breaks so cell text is always inline. */
const cleanCell = (value?: string) =>
  String(value ?? '')
    .replace(/\s*[•·]\s*/g, ', ')
    .replace(/\s*[\r\n]+\s*(?:[-*]\s*)?/g, '; ')
    .replace(/\s{2,}/g, ' ')
    .replace(/,\s*;/g, ';')
    .trim();
---

<div class="overflow-x-auto">
  <div class="overflow-hidden border border-banner-line" style={`min-width: ${tableMinWidth}`}>
    <table class="w-full border-collapse text-left">

      {/* ── Header ── */}
      <thead>
        <tr class="border-b border-white/10 bg-footer">
          <th class="px-6 py-4 font-display text-[13px] font-bold leading-4 tracking-[1.3px] text-page-end uppercase">
            {featureLabel}
          </th>
          {columns.map((col) => (
            <th class="border-l border-white/10 px-6 py-4 font-display text-[13px] font-bold leading-4 tracking-[1.3px] text-page-end uppercase">
              {col}
            </th>
          ))}
        </tr>
      </thead>

      {/* ── Body ── */}
      <tbody>
        {rows.map(({ feature, values }, ri) => (
          <tr class:list={['border-b border-banner-line last:border-b-0', ri % 2 === 0 ? 'bg-white' : 'bg-card']}>

            {/* Feature / label column */}
            <td class="px-6 py-4 font-display text-[15px] font-semibold leading-6 tracking-[0.2px] text-heading uppercase">
              {cleanCell(feature)}
            </td>

            {/* Data columns */}
            {values.map((val) => (
              <td class="border-l border-banner-line px-6 py-4 font-body text-[15px] font-normal leading-6 text-banner-note">
                {cleanCell(val)}
              </td>
            ))}

          </tr>
        ))}
      </tbody>

    </table>

    {caption && (
      <p class="border-t border-banner-line px-6 py-3 font-body text-[13px] text-muted/70">
        {caption}
      </p>
    )}
  </div>
</div>
