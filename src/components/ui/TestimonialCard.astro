---
/**
 * TestimonialCard — a single curated testimonial card.
 *
 * `tone="light"` matches the homepage review grid.
 * `tone="featured"` matches the reviews page: stars, name, quote on a dark card.
 * Data comes from Sanity `testimonial` documents via getTestimonials().
 */
import { Icon } from 'astro-icon/components';
import type { ReviewPlatform } from '~/lib/content/types';

export interface Props {
  quote: string;
  name: string;
  location?: string;
  /** Attribution subtitle — job title, tenure, or context (e.g. "Homeowner, Kailua") */
  tenure?: string;
  /** Number of stars to show. Default: 5 */
  stars?: number;
  /** Dark featured card used on the reviews page. */
  tone?: 'light' | 'featured';
  platform?: ReviewPlatform;
  /** ISO date (YYYY-MM-DD) from the original review, when known. */
  reviewedAt?: string;
}

const {
  quote,
  name,
  location,
  tenure,
  stars = 5,
  tone = 'light',
  platform,
  reviewedAt,
} = Astro.props;

const attribution = tenure || location || '';
const displayedPlatform = tone === 'featured' ? (platform ?? 'google') : platform;
const platformLabel =
  displayedPlatform === 'yelp'
    ? 'Yelp'
    : displayedPlatform === 'google'
      ? 'Google'
      : displayedPlatform === 'thumbtack'
        ? 'Thumbtack'
        : '';
const platformIcon =
  displayedPlatform === 'google'
    ? 'tabler:brand-google'
    : displayedPlatform === 'thumbtack'
        ? 'tabler:pin-filled'
        : null;
const formattedDate = reviewedAt
  ? new Date(`${reviewedAt}T00:00:00`).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : '';
---

{
  tone === 'featured' ? (
    <article class="flex h-full flex-col border border-accent/40 bg-card-dark p-6 md:p-8">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-0.5 text-page" aria-label={`${stars} out of 5 stars`}>
          {Array.from({ length: stars }).map(() => (
            <Icon name="tabler:star-filled" class="size-4" aria-hidden="true" />
          ))}
        </div>
        {platformLabel && (
          <span class="inline-flex items-center gap-1.5 text-page/80" title={`Reviewed on ${platformLabel}`}>
            {displayedPlatform === 'yelp' ? (
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.35 2.1c1.1-.18 2.05.63 2.05 1.74v6.34c0 .45-.36.82-.82.82h-1.16a.82.82 0 0 1-.81-.72L9.84 4.05c-.12-.95.56-1.78 1.51-1.95Z" />
                <path d="M20.78 8.28c.52.98.08 2.18-.96 2.58l-5.9 2.27a.82.82 0 0 1-1.05-.47l-.4-1.08a.82.82 0 0 1 .37-1l5.46-3.09c.84-.48 2.03-.07 2.48.79Z" />
                <path d="M19.82 18.17c-.77.8-2.05.78-2.8-.04l-4.27-4.66a.82.82 0 0 1 .05-1.15l.85-.78a.82.82 0 0 1 1.07-.03l4.9 3.92c.75.6.85 2.04.2 2.74Z" />
                <path d="M9.94 21.74c-1.1-.16-1.82-1.22-1.56-2.3l1.47-6.15a.82.82 0 0 1 .98-.61l1.12.27c.44.1.72.54.64.98l-1.05 6.18c-.16.95-.64 1.77-1.6 1.63Z" />
                <path d="M2.5 14.86c-.2-1.1.6-2.06 1.72-2.07l6.32-.08c.45 0 .82.35.83.8l.02 1.16c0 .45-.34.82-.78.84l-6.27.37c-.96.05-1.67-.07-1.84-1.02Z" />
              </svg>
            ) : platformIcon ? (
              <Icon name={platformIcon} class="size-5" aria-hidden="true" />
            ) : (
              <span class="font-display text-[13px] font-bold leading-none tracking-[0.5px] uppercase">{platformLabel}</span>
            )}
            <span class="sr-only">{platformLabel}</span>
          </span>
        )}
      </div>

      <h3 class="mt-5 font-display text-[22px] font-bold leading-6 tracking-[0.4px] text-page uppercase">
        {name}
      </h3>
      {formattedDate && (
        <p class="mt-1 font-body text-[13px] font-medium leading-5 text-page/60">{formattedDate}</p>
      )}
      <p class="mt-4 font-body text-[15px] font-normal italic leading-[26px] text-page/85">
        &ldquo;{quote}&rdquo;
      </p>
    </article>
  ) : (
    <article class="flex h-full flex-col justify-between border border-banner-line bg-white p-4 md:p-8">
      <div class="flex flex-col gap-4 pb-8">
        <div class="flex items-center gap-0.5 text-nav-cta" aria-label={`${stars} out of 5 stars`}>
          {Array.from({ length: stars }).map(() => (
            <Icon name="tabler:star-filled" class="size-4" aria-hidden="true" />
          ))}
        </div>

        <p class="font-body text-[15px] font-normal italic leading-[26px] text-heading">
          &ldquo;{quote}&rdquo;
        </p>
      </div>

      <div class="border-t border-banner-line pt-4">
        <p class="font-display text-[18px] font-bold leading-5 tracking-[0.5px] text-heading uppercase">
          {name}
        </p>
        {attribution && (
          <p class="mt-1 font-body text-[13px] font-normal leading-4 text-muted">{attribution}</p>
        )}
      </div>
    </article>
  )
}
