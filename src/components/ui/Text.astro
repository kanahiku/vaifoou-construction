---
/**
 * Text atom — one component for all body and UI text.
 *
 * Font: Work Sans for all body variants. Barlow Condensed for "button" variant.
 * Sizes come from brand.ts → type{} → CSS variables → text-body / text-body-lg etc.
 *
 * variant  (controls visual scale and default semantic element):
 *   body-lg → <p>      mobile/desktop from brand.ts   lede paragraphs, hero subtitles
 *   body    → <p>      mobile/desktop from brand.ts   standard paragraph copy ← default
 *   small   → <p>      fixed small size               footnotes, footer taglines
 *   caption → <p>      fixed caption size             timestamps, metadata
 *   button  → <span>   Barlow Condensed 14px          CTA label inside a custom control
 *                                                      (without button chrome)
 *
 * color:
 *   muted   → text-muted (warm grey)   ← default
 *   default → text-default (near-black)
 *   white   → text-page (warm off-white) — use on dark sections
 *   inherit → no color class — pass custom token via class=
 *
 * as:  Override the semantic element (e.g. as="span" for inline text).
 *
 * Usage:
 *   <Text>Regular paragraph copy.</Text>
 *   <Text variant="body-lg" color="white">Lede on a dark section.</Text>
 *   <Text variant="small" color="white">Footer tagline.</Text>
 *   <Text variant="button">CTA label inside a custom control.</Text>
 *   <Text html="Copy with <strong>bold</strong> or a <a href='/'>link</a>." />
 */
import { twMerge } from 'tailwind-merge';

type Variant = 'body-lg' | 'body' | 'small' | 'caption' | 'button';
type Color   = 'default' | 'muted' | 'white' | 'inherit';

export interface Props {
  /** Visual scale + default semantic element. Defaults to 'body'. */
  variant?: Variant;
  /** Override semantic element independently of visual scale. */
  as?: 'p' | 'span' | 'div';
  /** Text colour preset. Defaults to 'muted'. */
  color?: Color;
  /** Render HTML string via set:html instead of using the slot. */
  html?: string;
  class?: string;
}

const { variant = 'body', as: asOverride, color = 'muted', html, class: className = '' } = Astro.props;

// Default semantic element per variant
const defaultElement: Record<Variant, string> = {
  'body-lg': 'p',
  body:      'p',
  small:     'p',
  caption:   'p',
  button:    'span',
};
const Tag = (asOverride ?? defaultElement[variant as Variant]) as any;

// Visual scale per variant
const scale: Record<string, string> = {
  'body-lg': 'text-body-lg font-normal',
  body:      'text-body font-normal',
  small:     'text-small font-normal',
  caption:   'text-[11px] leading-[1.3] font-normal',
  // button variant = Barlow Condensed (display font) at button size
  button:    'font-display [font-size:var(--aw-text-button)] leading-none font-normal',
};

const colors: Record<string, string> = {
  default: 'text-default',
  muted:   'text-muted',
  white:   'text-page',
  inherit: '',
};

// twMerge only handles the color + className layer so `text-body-lg` (font-size utility)
// is never stripped by twMerge's text-* conflict resolution.
const overrideCls = twMerge(colors[color as string] ?? '', className);
// button → Barlow Condensed (font-display); all body variants → Work Sans (font-body)
const face = variant === 'button' ? 'font-display' : 'font-body';
const cls = [face, scale[variant as string] ?? '', overrideCls].filter(Boolean).join(' ');
---

{html ? <Tag class={cls} set:html={html} /> : <Tag class={cls}><slot /></Tag>}
