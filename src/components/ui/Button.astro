---
/**
 * Button atom — single component for all CTA variants.
 *
 * Font: Barlow Condensed 14px (font-display). Square corners (border-radius: 0).
 * Hover: 200ms ease, fill/color swap, 1px lift — defined in tailwind.css btn utilities.
 * Do not add per-page hover classes.
 *
 * Variants:
 *   primary            → filled accent (terracotta #964025), warm off-white text
 *   secondary          → filled secondary accent (hover = darker)
 *   ghost tone=dark    → 2px warm off-white outline — use on dark/photo sections
 *   ghost tone=light   → 2px near-black outline — use on light/cream sections
 *   link               → inline accent text link (Work Sans, 14px)
 *
 * Backward-compat aliases: 'ghost-dark' and 'ghost-light' still resolve correctly
 * so existing data objects (actions arrays, CMS entries) don't need updating.
 *
 * Usage:
 *   <Button variant="primary" text="Get a free quote" href="/contact" />
 *   <Button variant="ghost" text="View our work" href="/projects" />
 *   <Button variant="ghost" tone="light" text="Learn more" href="/about" />
 *   <Button variant="link" text="Read more" href="/blog" />
 */
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import type { CallToAction } from '~/types';
import CTANote from '~/components/ui/CTANote.astro';
import { PRIMARY_CTA_NOTE } from '~/config/cta';

export interface Props extends CallToAction {
  /**
   * Controls ghost button surface.
   * tone="dark"  → white-border glass  (default — for hero / dark / photo sections)
   * tone="light" → dark-border          (for light / grey sections)
   * Only used when variant="ghost".
   */
  tone?: 'dark' | 'light';
  /** lg 16×40 · md 8×24 · sm 8×16. Ignored when variant="link". */
  size?: 'lg' | 'md' | 'sm';
}

const {
  variant = 'primary',
  tone = 'dark',
  size = 'lg',
  target,
  text = Astro.slots.render('default'),
  icon = '',
  class: className = '',
  type,
  hideNote = false,
  noteTone = 'light',
  ...rest
} = Astro.props;

// Resolve ghost based on tone; keep legacy aliases for data-driven action arrays.
const variantClass: Record<string, string> = {
  primary:      'btn-primary',
  secondary:    'btn-secondary',
  tertiary:     'btn-secondary',
  ghost:        tone === 'light' ? 'btn-ghost-light' : 'btn-ghost-dark',
  'ghost-dark':  'btn-ghost-dark',   // backward compat
  'ghost-light': 'btn-ghost-light',  // backward compat
  link:         'btn-link',
};

const sizeClass = { lg: 'cta-lg', md: 'cta-md', sm: 'cta-sm' }[size];
const isPhoneIcon = icon === 'tabler:phone' || icon === 'phone';
const isArrowIcon = /(?:arrow|chevron)/i.test(icon);
const shouldRenderIcon = Boolean(icon) && (variant === 'link' || !isArrowIcon);
const showNote = variant === 'primary' && !hideNote && Boolean(PRIMARY_CTA_NOTE);
const isNativeButton = type === 'button' || type === 'submit' || type === 'reset';
const buttonClass = twMerge(
  variantClass[variant] ?? '',
  variant === 'link' ? '' : sizeClass,
  className,
  showNote && 'w-auto self-start',
);
---

{
  showNote ? (
    <div class="flex flex-col gap-1.5 w-full">
      {isNativeButton ? (
        <button type={type} class={buttonClass} {...rest}>
          <Fragment set:html={text} />
          {shouldRenderIcon && (isPhoneIcon ? (
            <PhoneIcon class="ml-1 -mr-1.5 inline-block rtl:mr-1 rtl:-ml-1.5" />
          ) : (
            icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />
          ))}
        </button>
      ) : (
        <a class={buttonClass} {...(target ? { target, rel: 'noopener noreferrer' } : {})} {...rest}>
          <Fragment set:html={text} />
          {shouldRenderIcon && (isPhoneIcon ? (
            <PhoneIcon class="ml-1 -mr-1.5 inline-block rtl:mr-1 rtl:-ml-1.5" />
          ) : (
            icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />
          ))}
        </a>
      )}
      <CTANote tone={noteTone} />
    </div>
  ) : isNativeButton ? (
    <button type={type} class={buttonClass} {...rest}>
      <Fragment set:html={text} />
      {shouldRenderIcon && (isPhoneIcon ? (
            <PhoneIcon class="ml-1 -mr-1.5 inline-block rtl:mr-1 rtl:-ml-1.5" />
          ) : (
            icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />
          ))}
    </button>
  ) : (
    <a class={buttonClass} {...(target ? { target, rel: 'noopener noreferrer' } : {})} {...rest}>
      <Fragment set:html={text} />
      {shouldRenderIcon && (isPhoneIcon ? (
            <PhoneIcon class="ml-1 -mr-1.5 inline-block rtl:mr-1 rtl:-ml-1.5" />
          ) : (
            icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />
          ))}
    </a>
  )
}
