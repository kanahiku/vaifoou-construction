---
/**
 * Photo that fills its positioned parent (heroes, cards, split frames).
 * Parent must be `relative` (and usually `overflow-hidden`).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Load immediately for photos above the fold. */
  eager?: boolean;
  class?: string;
}

const { src, alt, eager = false, class: className = '' } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={src.width}
  height={src.height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['absolute inset-0 h-full w-full max-w-none object-cover', className]}
/>
