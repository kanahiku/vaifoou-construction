---
/**
 * Photo that fills its positioned parent (heroes, cards, split frames).
 * Parent must be `relative` (and usually `overflow-hidden`).
 */
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Load immediately for photos above the fold. */
  eager?: boolean;
  class?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  quality?: number;
}

const {
  src,
  alt,
  eager = false,
  class: className = '',
  width = 1600,
  height = 900,
  widths = [400, 640, 960, 1200, 1600],
  sizes = '100vw',
  quality = 72,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  layout="cover"
  format="webp"
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['absolute inset-0 h-full w-full max-w-none object-cover', className]}
/>
