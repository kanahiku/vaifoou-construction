---
import { site } from '~/config/site';

export interface Props {
  label?: string;
  fill?: boolean;
  class?: string;
  style?: string;
}

const {
  label = `${site.name} photo placeholder`,
  fill = false,
  class: className = '',
  style,
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col items-center justify-center gap-3 bg-section-grey text-center text-heading/35',
    fill
      ? 'w-full h-full max-w-none rounded-none'
      : 'mx-auto rounded-md w-full max-w-[500px] h-full aspect-square',
    className,
  ]}
  style={style}
  role="img"
  aria-label={label}
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
    ></path>
  </svg>
  <span class="px-4 font-heading text-h4 leading-tight">{site.name} placeholder</span>
</div>
