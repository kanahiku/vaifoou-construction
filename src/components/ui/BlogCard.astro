---
import HeroImagePlaceholder from './HeroImagePlaceholder.astro';
import { Image } from 'astro:assets';
import { getFormattedDate } from '~/utils/utils';
import { getBlogPermalink } from '~/lib/content';
import type { BlogPost } from '~/lib/content/types';

export interface Props {
  post: BlogPost;
  variant?: 'dark' | 'light';
}

const { post, variant = 'light' } = Astro.props;
const href = getBlogPermalink(post.slug);
const publishDate = new Date(post.publishDate);

const arrowIcon = `<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z"/></svg>`;

const isDark = variant === 'dark';
const cardBg   = isDark ? 'bg-section-dark border-white/10 hover:border-nav-cta' : 'bg-white border-banner-line hover:border-nav-cta hover:bg-section-grey/40';
const dateCl   = isDark ? 'text-page/50' : 'text-muted';
const titleCl  = isDark ? 'text-page-end group-hover:text-nav-cta' : 'text-heading group-hover:text-nav-cta';
const bodyCl   = isDark ? 'text-page/70' : 'text-banner-note';
const linkCl   = isDark ? 'text-nav-cta' : 'text-nav-cta';
---

<a
  href={href}
  class:list={[
    'group flex flex-col gap-0 border transition-colors',
    !isDark && 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta',
    cardBg,
  ]}
>
  {/* Image */}
  <div class="relative w-full shrink-0 overflow-hidden" style="aspect-ratio: 16/9;">
    {post.image?.src ? (
      <Image
        src={post.image.src}
        alt={post.image.alt || post.title}
        width={640}
        height={360}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <HeroImagePlaceholder
        fill
        hideLabel
        class="absolute inset-0"
        label={`${post.title} photo placeholder`}
      />
    )}
  </div>

  {/* Content */}
  <div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
    <time
      datetime={post.publishDate}
      class:list={['font-body text-[11px] font-bold leading-4 tracking-[1.1px] uppercase', dateCl]}
    >
      {getFormattedDate(publishDate)}
    </time>

    <h3 class:list={[
      'font-display text-[18px] font-bold leading-tight tracking-[-0.1px] uppercase transition-colors md:text-[20px]',
      titleCl,
    ]}>
      {post.title}
    </h3>

    <p class:list={['font-body text-[14px] font-normal leading-[1.7] flex-1 line-clamp-3', bodyCl]}>
      {post.excerpt}
    </p>

    <span class:list={[
      'mt-auto flex items-center gap-1.5 font-body text-[13px] font-semibold leading-4 tracking-[0.5px] uppercase',
      linkCl,
    ]}>
      Read article <Fragment set:html={arrowIcon} />
    </span>
  </div>
</a>
