---
/**
 * One photo below `md`, another from `md` up. If only one source is passed,
 * that image is used at every breakpoint.
 */
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

interface Props {
  desktop?: ContentImage;
  mobile?: ContentImage;
  class?: string;
  widths?: number[];
  mobileWidths?: number[];
  sizes?: string;
  mobileSizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
  layout?: 'constrained' | 'full-width' | 'fixed' | 'cover' | 'none';
  format?: 'avif' | 'jpeg' | 'jpg' | 'png' | 'webp';
  quality?: number | string;
}

const {
  desktop,
  mobile,
  class: className,
  widths = [400, 768, 1200],
  mobileWidths = [400, 640, 828],
  sizes = '(max-width: 768px) 100vw, 50vw',
  mobileSizes = '100vw',
  loading = 'eager',
  fetchpriority,
  width = 700,
  height,
  layout = 'cover',
  format = 'webp',
  quality = 72,
} = Astro.props;

const desktopSrc = desktop?.src?.trim();
const mobileSrc = mobile?.src?.trim();
const fallbackAlt = "Vaifoou Construction masonry and concrete work on O'ahu";
const shared = desktopSrc && mobileSrc ? desktopSrc === mobileSrc : false;
const showPair = Boolean(desktopSrc && mobileSrc && !shared);
const single = desktopSrc ? desktop : mobileSrc ? mobile : undefined;
---

{
  showPair && desktop && mobile ? (
    <>
      <Image
        src={mobile.src}
        alt={mobile.alt || desktop.alt || fallbackAlt}
        class:list={['md:hidden', className]}
        widths={mobileWidths}
        sizes={mobileSizes}
        loading={loading}
        fetchpriority={fetchpriority}
        width={width}
        height={height}
        layout={layout}
        format={format}
        quality={quality}
      />
      <Image
        src={desktop.src}
        alt={desktop.alt || mobile.alt || fallbackAlt}
        class:list={['hidden md:block', className]}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        width={width}
        height={height}
        layout={layout}
        format={format}
        quality={quality}
      />
    </>
  ) : (
    single && (
      <Image
        src={single.src}
        alt={single.alt || fallbackAlt}
        class={className}
        widths={desktopSrc ? widths : mobileWidths}
        sizes={desktopSrc ? sizes : mobileSizes}
        loading={loading}
        fetchpriority={fetchpriority}
        width={width}
        height={height}
        layout={layout}
        format={format}
        quality={quality}
      />
    )
  )
}
