---
import type { ImageMetadata } from 'astro';
import { MOTIF, motifFadeMask, parseMotifOpacity } from '~/config/motif';

interface Props {
  color: string;
  opacity?: number | string;
  opacityFallback?: string;
  fade?: typeof MOTIF.fade;
  pattern?: ImageMetadata | null;
  size?: string;
  repeat?: string;
  position?: string;
  /** `luminance` for black-on-white tiles. `alpha` for black paths on transparent. */
  maskMode?: 'luminance' | 'alpha';
  class?: string;
}

const {
  color,
  opacity,
  opacityFallback = '0.1',
  fade = MOTIF.fade,
  pattern = MOTIF.pattern,
  size = MOTIF.size,
  repeat = MOTIF.repeat,
  position = 'center',
  maskMode = 'luminance',
  class: className = '',
} = Astro.props;

const fadeMask = motifFadeMask(fade);
const opacityValue = parseMotifOpacity(opacity, opacityFallback);
const fadeStyle = fadeMask
  ? `-webkit-mask-image: ${fadeMask}; mask-image: ${fadeMask};`
  : '';

/**
 * `cover` + `center` rescales whenever the section height changes (FAQ).
 * Size to width only and pin to the top so the pattern stays put.
 * The fade stays on this full-section layer so it still runs top → bottom
 * across the visible block, not across the SVG artboard.
 */
const lockToWidth = size === 'cover' || size === 'contain';
const motifSize = lockToWidth ? '100% auto' : size;
const motifPosition = lockToWidth ? 'top' : position;

const motifStyle = pattern
  ? [
      `opacity: ${opacityValue}`,
      `background-color: ${color}`,
      `-webkit-mask-image: url('${pattern.src}')`,
      `mask-image: url('${pattern.src}')`,
      `-webkit-mask-size: ${motifSize}`,
      `mask-size: ${motifSize}`,
      `-webkit-mask-repeat: ${repeat}`,
      `mask-repeat: ${repeat}`,
      `-webkit-mask-position: ${motifPosition}`,
      `mask-position: ${motifPosition}`,
      `-webkit-mask-mode: ${maskMode}`,
      `mask-mode: ${maskMode}`,
    ].join('; ')
  : '';
---
{pattern && (

<div
  class:list={['absolute inset-0 overflow-hidden pointer-events-none', className]}
  style={fadeStyle}
  aria-hidden="true"
>
  <div class="absolute inset-0" style={motifStyle}></div>
</div>
)}
