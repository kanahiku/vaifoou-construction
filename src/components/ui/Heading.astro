---
/**
 * Heading atom — one component for every heading level and the eyebrow label.
 *
 * Font: Barlow Condensed for all variants (h1–h4 and eyebrow).
 * Sizes come from brand.ts → type{} → CSS variables → text-h* utilities.
 *
 * variant  (controls visual scale and default semantic element):
 *   h1      → <h1>   mobile/desktop from brand.ts   hero / page title
 *   h2      → <h2>   mobile/desktop from brand.ts   section headings
 *   h3      → <h3>   mobile/desktop from brand.ts   subsection / card titles
 *   h4      → <h4>   mobile/desktop from brand.ts   small card / sidebar titles
 *   eyebrow → <p>    type-eyebrow utility            uppercase label above headings
 *
 * color:
 *   default  → near-black heading token (h1–h4) / accent terracotta (eyebrow)
 *   white    → warm off-white page color — use on dark/photo sections
 *   muted    → text-muted (warm grey)
 *   inherit  → no color class — pass a custom token via class=
 *
 * as:  Override the semantic element while keeping the visual scale.
 *
 * Usage:
 *   <Heading variant="h1">Built to last.</Heading>
 *   <Heading variant="h2" html="Projects <em>we're proud of</em>" />
 *   <Heading variant="h3" color="white">On a dark section</Heading>
 *   <Heading variant="eyebrow">Our Services</Heading>
 *   <Heading variant="h2" color="inherit" class="text-accent">Custom colour</Heading>
 */
import { twMerge } from 'tailwind-merge';

type Variant = 'h1' | 'h2' | 'h3' | 'h4' | 'eyebrow';
type Color   = 'default' | 'white' | 'muted' | 'inherit';

export interface Props {
  /** Visual scale + default semantic element. Defaults to h2. */
  variant?: Variant;
  /** Override semantic element independently of visual scale. */
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'p' | 'span';
  /** Text colour preset. Defaults to 'default'. */
  color?: Color;
  /** Render HTML string via set:html instead of using the slot. */
  html?: string;
  class?: string;
}

const { variant = 'h2', as: asOverride, color = 'default', html, class: className = '' } = Astro.props;

// Default semantic element per variant
const defaultElement: Record<Variant, string> = {
  h1: 'h1', h2: 'h2', h3: 'h3', h4: 'h4', eyebrow: 'p',
};
const Tag = (asOverride ?? defaultElement[variant as Variant]) as any;

// Visual scale per variant — all use Barlow Condensed (font-display)
const scale: Record<string, string> = {
  h1:      'text-h1 font-display font-normal leading-none',
  h2:      'text-h2 font-display font-normal leading-none',
  h3:      'text-h3 font-display font-normal leading-none',
  h4:      'text-h4 font-display font-normal leading-none',
  eyebrow: 'type-eyebrow',
};

const colorClass = (() => {
  if (color === 'inherit') return '';
  if (color === 'muted')   return 'text-muted';
  if (color === 'white')   return 'text-page';
  return variant === 'eyebrow' ? 'text-accent' : 'text-heading';
})();

// twMerge only handles color vs className so `text-h2` (font-size utility) is
// never stripped by twMerge's text-* conflict resolution.
const overrideCls = twMerge(colorClass, className);
const cls = [scale[variant as string] ?? '', overrideCls].filter(Boolean).join(' ');
---

{html ? <Tag class={cls} set:html={html} /> : <Tag class={cls}><slot /></Tag>}
