---
/**
 * Site footer — Figma node 112:316.
 * 5-col dark layout · rock-texture overlay · social icons in bottom bar.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import RemoteImage from '~/components/common/Image.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { site } from '~/config/site';
import { CONTACT } from '~/config/contact';
import { getFooterMediaContent } from '~/lib/content';
import logoDark from '~/assets/icons/logo-dark.svg';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links?: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
}

const {
  links = [],
  secondaryLinks = [],
  footNote = '',
} = Astro.props;

const servicesCol    = links.find((c) => c.title === 'SERVICES');
const areasCol       = links.find((c) => c.title === 'SERVICE AREAS');
const whoWeServeCol  = links.find((c) => c.title === 'WHO WE SERVE');
const companyCol     = links.find((c) => c.title === 'COMPANY');
const footerMedia = await getFooterMediaContent();
const backgroundImage = footerMedia?.backgroundImage;
---

<footer class="not-prose relative w-full overflow-hidden text-page" style="background-color: #0e0d0c;">

  {backgroundImage?.src && (
    <RemoteImage
      src={backgroundImage.src}
      alt=""
      width={1600}
      height={500}
      widths={[640, 960, 1200, 1600, 1920]}
      layout="cover"
      quality={64}
      loading="lazy"
      class="absolute inset-0 h-full w-full max-w-none object-cover"
    />
  )}

  {/* Dark overlay — sits above the texture */}
  <div class="absolute inset-0 bg-[rgba(14,13,12,0.92)]" aria-hidden="true"></div>

  <div class="site-frame relative z-10 flex flex-col gap-16 pb-10 pt-24">

    {/* ── 5-column grid ─────────────────────────────────────────── */}
    <div class="grid grid-cols-1 gap-10 border-b border-[rgba(96,94,90,0.2)] pb-16 sm:grid-cols-2 lg:grid-cols-5">

      {/* ── Col 1: Brand ──────────────────────────────────────── */}
      <div class="flex flex-col justify-between gap-8">
        <div class="flex flex-col gap-[7px]">
          {/* Logo */}
          <a href={getHomePermalink()} class="inline-flex h-10 shrink-0" aria-label={site.name}>
            <Image src={logoDark} alt="" width={149} height={40} class="h-10 w-auto" />
          </a>

          {/* Company name */}
          <p class="font-display text-[20px] font-bold leading-6 tracking-[0.5px] text-page-end uppercase">
            {site.name}
          </p>

          {/* Contact info — plain text, no icons */}
          <div class="mt-1 flex flex-col gap-[2px]">
            <p class="font-body text-[14px] font-normal leading-[22.75px] text-page/80">
              {CONTACT.license} &bull; Licensed &amp; Insured
            </p>
            <p class="font-body text-[14px] font-normal leading-[22.75px] text-page/80">
              O&#x02BB;ahu, Hawai&#x02BB;i
            </p>
            <a
              href={CONTACT.phone.href}
              class="font-body text-[14px] font-normal leading-[22.75px] text-page-end transition-colors hover:text-nav-cta"
            >
              {CONTACT.phone.display}
            </a>
          </div>
        </div>

        {/* Legal links — Privacy Policy • Terms • Accessibility */}
        {secondaryLinks.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            {secondaryLinks.map(({ text, href }, i) => (
              <>
                {i > 0 && <span class="font-body text-[12px] font-medium leading-4 text-page/40" aria-hidden="true">&bull;</span>}
                <a
                  href={href}
                  class="font-body text-[12px] font-medium leading-4 tracking-[0.6px] text-page/60 uppercase transition-colors hover:text-page-end"
                >
                  {text}
                </a>
              </>
            ))}
          </div>
        )}
      </div>

      {/* ── Col 2: Services ───────────────────────────────────── */}
      {servicesCol && (
        <div class="flex flex-col gap-4">
          <p class="font-display text-[20px] font-semibold leading-6 tracking-[1px] text-page-end uppercase">
            {servicesCol.title}
          </p>
          <ul class="flex flex-col gap-2">
            {servicesCol.links.map(({ text, href }) => (
              <li>
                <a
                  href={href}
                  class="font-body text-[16px] font-normal leading-6 text-page/80 transition-colors hover:text-page-end"
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* ── Col 3: Service Areas ──────────────────────────────── */}
      {areasCol && (
        <div class="flex flex-col gap-4">
          <p class="font-display text-[20px] font-semibold leading-6 tracking-[1px] text-page-end uppercase">
            {areasCol.title}
          </p>
          <ul class="flex flex-col gap-2">
            {areasCol.links.map(({ text, href }) => (
              <li>
                <a
                  href={href}
                  class="font-body text-[16px] font-normal leading-6 text-page/80 transition-colors hover:text-page-end"
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* ── Col 4: Who We Serve ───────────────────────────────── */}
      {whoWeServeCol && (
        <div class="flex flex-col gap-4">
          <p class="font-display text-[20px] font-semibold leading-6 tracking-[1px] text-page-end uppercase">
            {whoWeServeCol.title}
          </p>
          <ul class="flex flex-col gap-2">
            {whoWeServeCol.links.map(({ text, href }) => (
              <li>
                <a
                  href={href}
                  class="font-body text-[16px] font-normal leading-6 text-page/80 transition-colors hover:text-page-end"
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* ── Col 5: Company ────────────────────────────────────── */}
      {companyCol && (
        <div class="flex flex-col gap-4">
          <p class="font-display text-[20px] font-semibold leading-6 tracking-[1px] text-page-end uppercase">
            {companyCol.title}
          </p>
          <ul class="flex flex-col gap-2">
            {companyCol.links.map(({ text, href }) => (
              <li>
                {href ? (
                  <a
                    href={href}
                    class="font-body text-[16px] font-normal leading-6 text-page/80 transition-colors hover:text-page-end"
                  >
                    {text}
                  </a>
                ) : (
                  <span class="font-body text-[16px] font-normal italic leading-6 text-page/60">
                    {text}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {/* ── Bottom bar: copyright left · social icons right ───────── */}
    <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
      {footNote && (
        <p set:html={footNote} class="font-body text-[16px] font-normal leading-6 text-page/60" />
      )}

      {/* Social icons */}
      <div class="flex items-center gap-4">
        <a href="https://www.instagram.com/vaifoou_construction_llc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-page/60 transition-colors hover:text-page-end">
          <Icon name="tabler:brand-instagram" class="size-5" aria-hidden="true" />
        </a>
        <a href="https://www.facebook.com/p/Vaifoou-Construction-61552740776227/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-page/60 transition-colors hover:text-page-end">
          <Icon name="tabler:brand-facebook" class="size-5" aria-hidden="true" />
        </a>
      </div>
    </div>

  </div>
</footer>
