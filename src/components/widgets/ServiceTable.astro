---
/**
 * ServiceTable — section wrapper for the shared ComparisonTable.
 *
 * Used on every service sub-page. Provides the section chrome (bg, padding,
 * heading, optional note) and delegates all table rendering to ComparisonTable.
 *
 * Supports 2-column (feature + one value) and 3-column (feature + A vs B) layouts.
 */
import ComparisonTable from '~/components/ui/ComparisonTable.astro';

export interface TableRow {
  /** Row label shown in the Feature column. */
  feature: string;
  /** First data column value. */
  val1: string;
  /** Second data column value. Omit for a 2-col table. */
  val2?: string;
}

export interface Props {
  /** Small category label folded into the heading. */
  eyebrow?: string;
  /** Section H2. */
  heading: string;
  /** Optional introductory paragraph below the heading (supports HTML via set:html). */
  note?: string;
  /** Optional paragraph below the table (supports HTML via set:html). */
  footerNote?: string;
  /** Header for the first data column. */
  col1: string;
  /** Header for the second data column — omit for a 2-col table. */
  col2?: string;
  /** Table rows. */
  rows: TableRow[];
}

const { eyebrow, heading, note, footerNote, col1, col2, rows } = Astro.props;
const displayHeading = eyebrow ? `${eyebrow}: ${heading}` : heading;
---

<section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
  <div class="site-frame flex flex-col gap-12">
    {/* Section header */}
    <div class="flex max-w-[896px] flex-col gap-1">
      <h2
        class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
      >
        {displayHeading}
      </h2>
      {note && <p class="pt-2 font-body text-[16px] font-normal leading-7 text-banner-note" set:html={note} />}
    </div>

    {/* Table — delegated to ComparisonTable */}
    <ComparisonTable
      featureLabel="Feature"
      columns={col2 ? [col1, col2] : [col1]}
      rows={rows.map(({ feature, val1, val2 }) => ({
        feature,
        values: col2 ? [val1, val2 ?? ''] : [val1],
      }))}
    />

    {footerNote && <p class="font-body text-[16px] font-normal leading-7 text-banner-note" set:html={footerNote} />}
  </div>
</section>
