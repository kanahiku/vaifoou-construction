---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import IconPointGrid from '~/components/ui/IconPointGrid.astro';
import IconPointBand from '~/components/ui/IconPointBand.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ServiceDirectory from '~/components/ui/ServiceDirectory.astro';
import Timeline from '~/components/ui/Timeline.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import BulletCard from '~/components/ui/BulletCard.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import Content from '~/components/widgets/Content.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import ReviewsGrid from '~/components/widgets/ReviewsGrid.astro';
import type { ServiceSection } from '~/lib/content/types';
import type { ReviewSource } from '~/lib/reviews';
import { cardVariant, introClass, isDarkSurface, pointVariant } from '~/lib/content/sectionTheme';

export interface Props {
  sections: ServiceSection[];
}

const { sections } = Astro.props;

function iconLayout(section: Extract<ServiceSection, { _type: 'iconPointsSection' }>) {
  return section.layout === 'band' ? 'band' : 'grid';
}

function cardGridClass(count: number) {
  if (count >= 6) return 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6';
  if (count === 4) return 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6';
  if (count === 3) return 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6';
  return 'grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6';
}

function infoGridClass(count: number) {
  if (count === 4) return 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4';
  if (count === 2) return 'grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4';
  return 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4';
}

function reviewSources(section: ServiceSection): ReviewSource[] {
  if (section._type === 'yelpReviewsSection') return ['yelp'];
  if (section._type === 'liveReviewsSection') {
    if (section.sources === 'google') return ['google'];
    if (section.sources === 'yelp') return ['yelp'];
    return ['google', 'yelp'];
  }
  return ['google', 'yelp'];
}

---

{
  sections.map((section, index) => {
    const surface = ('surface' in section && section.surface) || 'white';
    const isDark = isDarkSurface(surface);
    const introColor = introClass(surface);
    const hasIntro = 'intro' in section && Boolean(section.intro);

    if (section._type === 'splitContentSection') {
      return (
        <Content
          isReversed={'isReversed' in section ? Boolean(section.isReversed) : false}
          isDark={isDark}
          title={section.heading}
          classes={isDark ? { title: 'text-white' } : undefined}
          callToAction={
            section.ctaText
              ? {
                  variant: isDark ? 'ghost-dark' : 'ghost-light',
                  text: section.ctaText,
                  href: section.ctaHref || '/form',
                }
              : undefined
          }
        >
          <Fragment slot="content">
            {section.paragraphs.map((paragraph, paragraphIndex) => (
              <p class:list={[paragraphIndex > 0 && 'mt-4', isDark ? 'text-white/70' : 'text-muted']}>{paragraph}</p>
            ))}
            {section.linkText && section.linkHref && (
              <p class="mt-4">
                <a
                  href={section.linkHref}
                  class:list={[
                    isDark ? 'font-semibold text-page transition-colors hover:text-white' : 'btn-link',
                  ]}
                >
                  {section.linkText}
                </a>
              </p>
            )}
          </Fragment>
          <Fragment slot="image">
            {section.image?.src ? (
              <Image
                src={section.image.src}
                alt={section.image.alt}
                class="w-full h-full object-cover"
                widths={[400, 768, 1200]}
                sizes="(max-width: 768px) 100vw, 50vw"
                width={700}
                height={700}
                layout="cover"
                format="webp"
              />
            ) : (
              <HeroImagePlaceholder fill label={section.imagePlaceholder || `${section.heading} photo placeholder`} />
            )}
          </Fragment>
          <Fragment slot="bg">
            <SectionBg variant={surface} />
          </Fragment>
        </Content>
      );
    }

    return (
      <WidgetWrapper containerClass="max-w-container mx-auto" isDark={isDark}>
        {section._type === 'editorialSection' ? (
          <>
            <Headline isDark={isDark} title={section.heading} classes={{ container: 'mb-[20px] text-left md:mx-0' }} />
            <div class="space-y-5">
              {section.paragraphs.map((paragraph) => (
                <p class:list={['text-[16px] md:text-[17px] font-normal leading-[160%]', introColor]}>
                  {paragraph}
                </p>
              ))}
            </div>
          </>
        ) : (
          <>
            <Headline
              isDark={isDark}
              title={section.heading}
              classes={{ container: `${hasIntro ? 'mb-[9px]' : 'mb-[30px]'} text-left md:mx-0` }}
            />
            {hasIntro && (
              <p
                class:list={[
                  'text-[16px] md:text-[17px] font-normal leading-[160%] text-left max-w-3xl mb-[30px]',
                  introColor,
                ]}
              >
                {section.intro}
              </p>
            )}
          </>
        )}

        {section._type === 'iconPointsSection' &&
          (iconLayout(section) === 'band' ? (
            <IconPointBand
              items={section.items.map((item) => ({
                title: item.title,
                description: item.description,
                icon: item.icon || 'tabler:point',
              }))}
              variant={pointVariant(surface)}
            />
          ) : (
            <IconPointGrid
              items={section.items.map((item) => ({
                title: item.title,
                description: item.description,
                icon: item.icon || 'tabler:point',
              }))}
              variant={pointVariant(surface)}
            />
          ))}

        {section._type === 'timelineSection' && (
          <Timeline isDark={isDark} surface={surface === 'white' ? 'white' : 'grey'} items={section.steps} />
        )}

        {section._type === 'infoCardsSection' && (
          <div class={infoGridClass(section.items.length)}>
            {section.items.map((card) => (
              <InfoCard
                title={card.title}
                description={card.description}
                icon={card.icon}
                variant={cardVariant(surface)}
                border={surface !== 'white'}
              />
            ))}
          </div>
        )}

        {section._type === 'linkedCardsSection' &&
          (section.display === 'directory' || (section.display !== 'cards' && section.items.length === 5) ? (
            <ServiceDirectory items={section.items} variant={pointVariant(surface)} />
          ) : (
            <div class={cardGridClass(section.items.length)}>
              {section.items.map((card) => (
                <ServiceCard
                  title={card.title}
                  description={card.description}
                  href={card.href}
                  linkText={card.linkText}
                  variant={cardVariant(surface)}
                />
              ))}
            </div>
          ))}

        {section._type === 'comparisonTableSection' && (
          <ComparisonTable
            featureLabel={section.featureLabel}
            columns={section.column3
              ? [section.column1, section.column2, section.column3]
              : [section.column1, section.column2]}
            rows={section.rows.map((row) => ({
              feature: row.feature,
              values: section.column3
                ? [row.cell1, row.cell2, row.cell3 ?? '']
                : [row.cell1, row.cell2],
            }))}
          />
        )}

        {section._type === 'bulletCardsSection' && (
          <div class={section.items.length === 2 ? 'grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6' : cardGridClass(section.items.length)}>
            {section.items.map((card) => (
              <BulletCard title={card.title} items={card.items} variant={cardVariant(surface)} />
            ))}
          </div>
        )}

        {section._type === 'checklistSection' && (
          <ul class="space-y-4">
            {section.items.map((item) => (
              <li class="flex items-start gap-3">
                <Icon
                  name="tabler:check"
                  class:list={['mt-0.5 shrink-0 w-5 h-5', isDark ? 'text-accent' : 'text-primary']}
                  aria-hidden="true"
                />
                <span
                  class:list={['text-[16px] md:text-[17px] font-normal leading-[160%]', introColor]}
                >
                  {item.text}
                </span>
              </li>
            ))}
          </ul>
        )}

        {section._type === 'quoteCardsSection' && (
          <div
            class:list={[
              'grid grid-cols-1 gap-4 md:gap-6',
              section.items.length === 1
                ? 'md:grid-cols-1 max-w-xl'
                : section.items.length === 2
                  ? 'md:grid-cols-2'
                  : 'md:grid-cols-3',
            ]}
          >
            {section.items.map((item) => (
              <div
                class:list={[
                  'rounded-lg p-6 flex flex-col h-full',
                  surface === 'white' ? 'bg-card-light' : 'border border-accent/60 bg-card-dark',
                ]}
              >
                <p
                  class:list={[
                    'text-[14px] md:text-[15px] font-normal leading-[160%] flex-1',
                    surface === 'white' ? 'text-muted' : 'text-white/60',
                  ]}
                >
                  “{item.quote}”
                </p>
                <p
                  class:list={[
                    'mt-auto pt-4 text-[16px] md:text-[18px] font-medium',
                    surface === 'white' ? 'text-heading' : 'text-white',
                  ]}
                >
                  {item.name}
                </p>
              </div>
            ))}
          </div>
        )}

        {(section._type === 'yelpReviewsSection' || section._type === 'liveReviewsSection') && (
          <ReviewsGrid
            showHeader={false}
            sources={reviewSources(section)}
            variant={cardVariant(surface)}
            isDark={isDark}
          />
        )}

        <Fragment slot="bg">
          <SectionBg variant={surface} />
        </Fragment>
      </WidgetWrapper>
    );
  })
}
