---
import { Icon } from 'astro-icon/components';
import { trimSlash } from '~/utils/permalinks';
import type { NavLink } from '~/lib/content/types';

export interface Props {
  links?: NavLink[];
  class?: string;
}

const { links = [], class: className = '' } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isPathActive = (href?: string) => {
  if (!href) return false;
  const hrefPath = `/${trimSlash(new URL(href, Astro.url).pathname)}`;
  if (hrefPath === '/') return currentPath === '/';
  return currentPath === hrefPath || currentPath.startsWith(`${hrefPath}/`);
};
const hasActiveDescendant = (items?: NavLink[]): boolean => {
  if (!items?.length) return false;
  return items.some((item) => isPathActive(item.href) || hasActiveDescendant(item.links));
};
const navLinkClass =
  'inline-flex items-center font-body text-[14px] font-semibold leading-[18px] tracking-[0.7px] text-banner-note uppercase whitespace-nowrap hover:text-accent';
---

<ul class={className}>
  {
    links.map(({ text, href, links: childLinks }) => {
      const isDropdown = Boolean(childLinks?.length);
      const isDropdownActive = isPathActive(href) || hasActiveDescendant(childLinks);
      if (!isDropdown) {
        return (
          <li>
            <a class:list={[navLinkClass, { 'aw-link-active': isPathActive(href) }]} href={href}>
              {text}
            </a>
          </li>
        );
      }

      return (
        <li class="dropdown relative">
          <div>
            {href ? (
              <a class:list={[navLinkClass, 'inline-flex items-center gap-1', { 'aw-link-active': isDropdownActive }]} href={href}>
                {text}
                <Icon name="tabler:chevron-down" class="size-3.5" aria-hidden="true" />
              </a>
            ) : (
              <span class:list={[navLinkClass, 'inline-flex cursor-default items-center gap-1 select-none', { 'aw-link-active': isDropdownActive }]}>
                {text}
                <Icon name="tabler:chevron-down" class="size-3.5" aria-hidden="true" />
              </span>
            )}
          </div>

          <ul class="dropdown-menu" role="list">
            {childLinks!.map(({ text: childText, href: childHref, links: grandChildLinks }) => {
              const hasSub = Boolean(grandChildLinks?.length);

              if (!hasSub) {
                return (
                  <li>
                    <a
                      class:list={[{ 'aw-link-active': isPathActive(childHref) }]}
                      href={childHref}
                    >
                      {childText}
                    </a>
                  </li>
                );
              }

              /* Item that itself has children → renders a right-side flyout */
              return (
                <li class="sub-dropdown relative">
                  <a
                    class:list={[
                      'flex items-center gap-1',
                      { 'aw-link-active': isPathActive(childHref) },
                    ]}
                    href={childHref}
                  >
                    {childText}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="size-3 shrink-0 opacity-50"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 18l6-6-6-6" />
                    </svg>
                  </a>

                  <ul class="sub-dropdown-menu" role="list">
                    {grandChildLinks!.map(({ text: gcText, href: gcHref }) => (
                      <li>
                        <a
                          class:list={[{ 'aw-link-active': isPathActive(gcHref) }]}
                          href={gcHref}
                        >
                          {gcText}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })}
          </ul>
        </li>
      );
    })
  }
</ul>
