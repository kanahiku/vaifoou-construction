---
/**
 * Pre-footer conversion band — Nav tab, every page.
 * Three global CTAs configured from src/config/cta.ts.
 */
import Button from '~/components/ui/Button.astro';
import {
  CATERING_CTA_HREF,
  CATERING_CTA_LABEL,
  LOCATION_CTA_HREF,
  LOCATION_CTA_LABEL,
  PRIMARY_CTA_HREF,
  PRIMARY_CTA_LABEL,
} from '~/config/cta';

export interface Props {
  id?: string;
}

const { id = 'conversion-band' } = Astro.props;
---

<section {...id ? { id } : {}} class="not-prose w-full bg-page">
  <div
    class="mx-auto flex w-full max-w-container flex-col items-stretch gap-3 px-5 py-12 sm:px-8 md:flex-row md:items-center md:justify-center md:gap-4 md:px-16 md:py-16"
  >
    <Button variant="primary" text={PRIMARY_CTA_LABEL} href={PRIMARY_CTA_HREF} hideNote class="justify-center" />
    <Button
      variant="ghost"
      tone="light"
      text={LOCATION_CTA_LABEL}
      href={LOCATION_CTA_HREF}
      hideNote
      class="justify-center"
    />
    <Button
      variant="ghost"
      tone="light"
      text={CATERING_CTA_LABEL}
      href={CATERING_CTA_HREF}
      hideNote
      class="justify-center"
    />
  </div>
</section>
