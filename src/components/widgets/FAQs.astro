---
/**
 * FAQs — accordion widget.
 *
 * Two modes:
 *
 * 1. Default (isDark=false) — existing cream/sage accordion inside WidgetWrapper.
 *    Used on light-background pages.
 *
 * 2. Editorial dark (isDark=true) — premium dark layout.
 *    - Full-width blueberry (bg-section-dark) section — sits between the
 *      LocalSourcing sage-green and the CTABanner deep-cacao for a cinematic
 *      closing sequence.
 *    - Desktop 2-column: editorial heading column (5/12) + accordion (7/12).
 *    - Questions rendered in Norca Rough (font-rough) for typographic weight.
 *    - Generous padding, thin page/20 rules between items.
 *    - Expand/collapse toggle in hibiscus accent.
 */

import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Faqs as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  items = [],
  id,
  isDark = false,
  animate = true,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Light mode CSS variable classes (unchanged)
const itemBorder = 'border-faq-light';
const questionColor = classes?.question ?? 'text-faq-question-light';
const answerColor = classes?.answer ?? 'text-faq-answer-light';
const toggleBase = 'border-faq-toggle-light text-faq-toggle-light';
const toggleActive = 'group-open:border-accent group-open:text-accent';
const displayTitle = tagline ? `${tagline}: ${title}` : title;
---

{
  isDark ? (
    <section {...(id ? { id } : {})} class="not-prose relative w-full bg-dark" aria-label="Frequently asked questions">
      <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16">
        {/* ── Centered section header ──────────────────────────── */}
        <div class="flex flex-col items-start gap-4 pb-12 pt-16 md:pb-16 md:pt-24">
          {displayTitle && <h2 class="font-rough text-h2 font-normal leading-none text-page" set:html={displayTitle} />}
          {subtitle && <p class="font-sans text-[15px] leading-relaxed text-page/50 max-w-sm mt-1">{subtitle}</p>}
        </div>

        {/* ── Numbered FAQ rows ────────────────────────────────── */}
        <div class="pb-16 md:pb-24">
          {items.length > 0 &&
            items.map(({ title: itemTitle, description }, index) => (
              <details
                class:list={['group border-b border-page/10 py-1', index === 0 && 'border-t border-page/10']}
                name="faq-accordion"
              >
                <summary class="flex cursor-pointer select-none list-none items-start gap-5 py-6 md:gap-8 md:py-8">
                  {/* ── Number badge — large, muted accent ── */}
                  <span
                    class="shrink-0 w-10 md:w-14 font-rough text-[22px] md:text-[28px] leading-[1.1] text-accent/65 mt-0.5"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, '0')}.
                  </span>

                  {/* ── Question text ── */}
                  <h3 class="flex-1 font-rough text-h3 leading-snug text-page pr-2 md:pr-4">{itemTitle}</h3>

                  {/* ── Expand toggle ── */}
                  <span
                    class="mt-1 flex h-8 w-8 flex-shrink-0 items-center justify-center border border-page/25 bg-white text-heading/60 shadow-sm transition-all duration-200 group-open:border-accent group-open:text-accent"
                    aria-hidden="true"
                  >
                    <span class="relative h-2.5 w-2.5">
                      <span class="absolute left-0 top-1/2 h-[1.5px] w-full -translate-y-1/2 bg-current"></span>
                      <span class="absolute left-1/2 top-0 h-full w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-200 group-open:scale-y-0"></span>
                    </span>
                  </span>
                </summary>

                {/* ── Answer — indented under question ── */}
                <div class="pb-7 pl-[60px] pr-12 md:pl-[88px] md:pr-16">
                  <p class="font-sans text-[15px] leading-relaxed text-page/50" set:html={description} />
                </div>
              </details>
            ))}
        </div>
      </div>
    </section>
  ) : (
    <WidgetWrapper
      id={id}
      isDark={false}
      animate={animate}
      containerClass={`max-w-container mx-auto ${classes?.container ?? ''}`}
      bg={bg}
    >
      {(displayTitle || subtitle) && (
        <div class="flex max-w-[896px] flex-col gap-1 mb-[30px]">
          {displayTitle && (
            <h2
              class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
              set:html={displayTitle}
            />
          )}
          {subtitle && <p class="mt-2 font-body text-[15px] leading-7 text-banner-note" set:html={subtitle} />}
        </div>
      )}

      {items.length > 0 && (
        <div
          class:list={[
            animate &&
              'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
          ]}
        >
          {items.map(({ title: itemTitle, description }, index) => (
            <details class:list={['group py-1', index > 0 && `border-t ${itemBorder}`]} name="faq-accordion">
              <summary class="flex items-center justify-between gap-4 cursor-pointer py-4 list-none select-none">
                <h3 class={`text-[16px] md:text-[18px] font-sans font-medium leading-snug pr-4 ${questionColor}`}>
                  {itemTitle}
                </h3>
                <span
                  class={`flex-shrink-0 w-7 h-7 flex items-center justify-center border bg-white shadow-sm transition-colors duration-200 ${toggleBase} ${toggleActive}`}
                  aria-hidden="true"
                >
                  <span class="relative h-2.5 w-2.5">
                    <span class="absolute left-0 top-1/2 h-[1.5px] w-full -translate-y-1/2 bg-current"></span>
                    <span class="absolute left-1/2 top-0 h-full w-[1.5px] -translate-x-1/2 bg-current transition-transform duration-200 group-open:scale-y-0"></span>
                  </span>
                </span>
              </summary>
              <div class="pb-5 pr-10">
                <p
                  class={`text-[15px] md:text-[16px] font-normal leading-[160%] ${answerColor}`}
                  set:html={description}
                />
              </div>
            </details>
          ))}
        </div>
      )}
    </WidgetWrapper>
  )
}

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
