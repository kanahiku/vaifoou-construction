---
/**
 * Testimonials — Homepage 59:438. "Loved across the island."
 *
 * Visual spec:
 *   bg-page (cream #EFE9DE). Centered eyebrow + h2 header.
 *   Horizontal CSS marquee of review cards (450px each), gap-3.
 *   Edge fade: CSS mask fades at left + right.
 *   Pauses on hover.
 *
 * Card anatomy (bg-card #FAF4E8, p-4, gap-5):
 *   1. Platform logo (Google / Yelp) + 5-star row (rotate −1.82°)
 *   2. Wreck-Script 22px quote (rotate −2.21°)
 *   3. Right-aligned attribution: Norca name (heading) + location (accent) (rotate −2.17°)
 *
 * Implementation:
 *   Cards duplicated for seamless loop: CSS translate −50% = one full set → perfect join.
 *   No JavaScript. 100% GPU-accelerated.
 */

import Heading from '~/components/ui/Heading.astro';
import { sanityClient } from '~/lib/sanity/client';

export type ReviewPlatform = 'google' | 'yelp';

export interface TestimonialItem {
  quote: string;
  name: string;
  location: string;
  platform?: ReviewPlatform;
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  /** Pass testimonials explicitly to skip the Sanity fetch (e.g. in Storybook/tests). */
  testimonials?: TestimonialItem[];
  id?: string;
}

const { eyebrow = 'Reviews', heading = 'Loved across the island.', testimonials: propTestimonials, id } = Astro.props;

// Fetch from Sanity; fall back to prop overrides if provided.
let testimonials: TestimonialItem[] = propTestimonials ?? [];

if (!propTestimonials) {
  try {
    const raw = await sanityClient.fetch<TestimonialItem[]>(
      `*[_type == "testimonial"] | order(order asc, name asc) {
        quote, name, location, platform
      }`
    );
    if (raw && raw.length > 0) testimonials = raw;
  } catch (e) {
    // Sanity unreachable at build time — silently use empty array
    console.warn('[Testimonials] Sanity fetch failed:', (e as Error).message);
  }
}

// Duplicate for seamless loop
const doubled = [...testimonials, ...testimonials];
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-page py-16 md:py-[120px]"
>
  {/* ── Centered header ── */}
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16">
    <div class="flex flex-col items-center gap-6 text-center">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      {heading && <Heading variant="h2">{heading}</Heading>}
    </div>
  </div>

  {/* ── Marquee track ── */}
  <div class="t-mask mt-10 md:mt-16" aria-label="Customer reviews">
    <div class="t-track flex items-stretch gap-3">
      {doubled.map((item) => (
        <article class="t-slide flex h-[244px] w-[min(85vw,450px)] shrink-0 flex-col gap-5 bg-card p-4">

          {/* Platform logo + stars */}
          <div class="flex items-start gap-1.5">
            <span class="inline-flex h-6 items-center rounded-sm border border-heading/15 px-2 text-[11px] font-medium uppercase tracking-wide text-heading/70">
              {item.platform === 'yelp' ? 'Yelp' : 'Google'}
            </span>

            {/* 5-star row — rotate −1.82° matching Figma */}
            <div class="-rotate-[1.82deg]" role="img" aria-label="5 out of 5 stars">
              <svg width="139" height="20" viewBox="0 0 139 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {[0,1,2,3,4].map((i) => (
                  <g transform={`translate(${i * 27.8}, 0)`}>
                    <path
                      d="M10 1.5l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.77l-4.77 2.44.91-5.32L2.27 7.12l5.34-.78L10 1.5z"
                      stroke="#3D2819"
                      stroke-width="1"
                      fill="none"
                    />
                  </g>
                ))}
              </svg>
            </div>
          </div>

          {/* Quote — flex-1 so attribution is always pinned to the bottom */}
          <p class="type-quote -rotate-[2.21deg] flex-1 text-heading leading-[1.2]">
            {item.quote}
          </p>

          {/* Attribution — right-aligned, Norca Regular 14px */}
          <div class="-rotate-[2.17deg] flex flex-col items-end gap-3 text-right font-heading text-button leading-none">
            <span class="text-heading">{item.name}</span>
            <span class="text-accent">{item.location}</span>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Edge fade mask */
  .t-mask {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 24px,
      black calc(100% - 24px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 24px,
      black calc(100% - 24px),
      transparent 100%
    );
  }

  @media (min-width: 768px) {
    .t-mask {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 80px,
        black calc(100% - 80px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 80px,
        black calc(100% - 80px),
        transparent 100%
      );
    }
  }

  /* Marquee: translate exactly -50% → one full set → seamless loop */
  @keyframes t-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .t-track {
    width: max-content;
    animation: t-marquee 50s linear infinite;
  }

  .t-mask:hover .t-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-track { animation: none; }
  }
</style>
