---
import FormContainer from '~/components/ui/Form.astro';
import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CONTACT } from '~/config/contact';
import type { Contact as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  inputs,
  textarea,
  disclaimer,
  button,
  description,

  id,
  classes = {},
} = Astro.props;

const addressLine = `${CONTACT.address.street}, ${CONTACT.address.cityLine}`;
---

<section {...id ? { id } : {}} class="not-prose w-full scroll-mt-[72px] bg-page">
  <div class:list={['mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]', classes?.container]}>
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch">
      <aside class="flex h-full flex-col gap-8 bg-section-dark px-6 py-8 md:px-10 md:py-12">
        <div class="flex flex-col gap-4">
          <Heading variant="eyebrow" color="white" class="text-page/55">{CONTACT.businessName}</Heading>
          <Heading variant="h2" color="white">Contact Details</Heading>
          <Text variant="body-lg" color="white" class="max-w-md text-page/65">
            Reach our team for project questions, quote requests, and general inquiries.
          </Text>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          <div class="flex flex-col gap-2 border-t border-page/15 pt-5">
            <Heading variant="eyebrow" color="white" class="text-page/55">Email</Heading>
            <a
              href={`mailto:${CONTACT.email}`}
              class="font-sans text-body-lg text-page transition-opacity hover:opacity-80"
            >
              {CONTACT.email}
            </a>
          </div>

          <div class="flex flex-col gap-2 border-t border-page/15 pt-5">
            <Heading variant="eyebrow" color="white" class="text-page/55">Phone</Heading>
            <a href={CONTACT.phone.href} class="font-sans text-body-lg text-page transition-opacity hover:opacity-80">
              {CONTACT.phone.display}
            </a>
          </div>

          <div class="flex flex-col gap-2 border-t border-page/15 pt-5 sm:col-span-2 lg:col-span-1">
            <Heading variant="eyebrow" color="white" class="text-page/55">Address</Heading>
            <address class="not-italic">
              <Text variant="body-lg" color="white" as="span" class="block">{CONTACT.address.street}</Text>
              <Text variant="body-lg" color="white" as="span" class="block text-page/70"
                >{CONTACT.address.cityLine}</Text
              >
            </address>
          </div>
        </div>

        <div class="mt-auto flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <Button variant="primary" text="Email Us" href={`mailto:${CONTACT.email}`} hideNote={true} />
          <Button
            variant="ghost"
            tone="dark"
            text="Get Directions"
            href={CONTACT.address.mapsDirectionsHref}
            target="_blank"
            hideNote={true}
          />
        </div>
      </aside>

      <div class="flex h-full flex-col bg-card px-6 py-8 shadow-card-mist md:px-10 md:py-12">
        <div class="mb-8 flex flex-col gap-4">
          {title && <Heading variant="h2" html={title} />}
          {subtitle && <Text variant="body-lg" color="muted" class="max-w-2xl" html={subtitle} />}
        </div>

        {
          inputs && (
            <FormContainer
              inputs={inputs}
              textarea={textarea}
              disclaimer={disclaimer}
              button={button}
              description={description}
            />
          )
        }
      </div>
    </div>

    <div class="mt-3 min-h-[280px] overflow-hidden bg-section-grey aspect-[1200/420]">
      <iframe
        src={CONTACT.address.mapsEmbedSrc}
        title={`Map of ${CONTACT.businessName} at ${addressLine}`}
        class="h-full w-full border-0"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </div>
</section>
