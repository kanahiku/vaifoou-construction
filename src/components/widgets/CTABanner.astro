---
/**
 * CTABanner — page CTA closer.
 */

import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  disclaimer?: string;
  id?: string;

  /** @deprecated Legacy template props — accepted but ignored. */
  showAfterHoursNote?: boolean;
  /** @deprecated Legacy template prop — accepted but ignored. */
  license?: string;
  /** @deprecated Legacy template props — accepted but ignored. */
  extraLines?: string[];
}

const {
  eyebrow,
  title,
  subtitle,
  ctaText = 'Request a Quote',
  ctaHref = '/contact',
  secondaryCtaText,
  secondaryCtaHref,
  id,
} = Astro.props;
const displayTitle = eyebrow ? `${eyebrow}: ${title}` : title;
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-section-dark py-20 md:py-32 lg:py-40"
>
  {/* ── Decorative motif overlay ── */}
  <div
    class="pointer-events-none absolute inset-0 opacity-20"
    style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 28px 28px; color: var(--aw-color-bg-page);"
    aria-hidden="true"
  ></div>

  <div class="relative z-[1] mx-auto flex w-full max-w-container flex-col items-center gap-8 px-5 text-center sm:px-8 md:px-16">

    {/* ── Top ornamental rule ──────────────────────────────── */}
    <div class="flex w-full max-w-xs items-center gap-4">
      <div class="h-px flex-1 bg-page/20"></div>
      <span class="font-script text-[22px] leading-none text-accent" aria-hidden="true">✦</span>
      <div class="h-px flex-1 bg-page/20"></div>
    </div>

    <div class="flex w-full flex-col items-center gap-6">
      {/* ── Display headline — h1 scale, full visual weight ─── */}
      <Heading
        variant="h1"
        color="inherit"
        class="max-w-3xl text-balance text-page"
      >
        {displayTitle}
      </Heading>

      {/* ── Subtitle ─────────────────────────────────────────── */}
      {subtitle && (
        <Text variant="body-lg" class="max-w-lg text-balance text-page/55">
          {subtitle}
        </Text>
      )}

      {/* ── CTAs ─────────────────────────────────────────────── */}
      <div class="flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row sm:items-center">
        <Button
          variant="primary"
          text={ctaText}
          href={ctaHref}
          hideNote={true}
          class="w-full sm:w-auto"
        />
        {secondaryCtaText && secondaryCtaHref && (
          <Button
            variant="ghost"
            tone="dark"
            text={secondaryCtaText}
            href={secondaryCtaHref}
            hideNote={true}
            class="w-full sm:w-auto"
          />
        )}
      </div>
    </div>

    {/* ── Bottom ornamental rule ───────────────────────────── */}
    <div class="flex w-full max-w-xs items-center gap-4">
      <div class="h-px flex-1 bg-page/20"></div>
      <span class="font-script text-[22px] leading-none text-accent" aria-hidden="true">✦</span>
      <div class="h-px flex-1 bg-page/20"></div>
    </div>

  </div>
</section>
