---
/**
 * BrickMotifCTA — light-background CTA closing section with brick-motif texture.
 *
 * Used as the last section on all service sub-pages.
 * Phone, licence and trust-bar items are wired automatically from config.
 * Only pass `heading` (required) and optionally `eyebrow` / `note`.
 * Explicit eyebrow text is folded into the heading instead of rendered separately.
 */
import { Image } from 'astro:assets';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import brickMotif from '~/assets/brick-motif-wide-light.svg';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

export interface Props {
  /** Optional label folded into the heading. */
  eyebrow?: string;
  /** Section H2 — the page-specific CTA headline. */
  heading: string;
  /**
   * Subtitle paragraph below the heading.
   * Defaults to the standard Sunday-closed note.
   * Supports HTML entities; passed via set:html.
   */
  note?: string;
}

const {
  eyebrow,
  heading,
  note = "We bring our family\u2019s 25+ year trade legacy to every project site. Contact us to schedule an estimate. Please note we are closed on Sundays.",
} = Astro.props;
const displayHeading = eyebrow ? `${eyebrow}: ${heading}` : heading;

const trustItems = [
  CONTACT.license,
  'Licensed & Insured',
  "Serving All of O'ahu",
];
---

<section class="w-full bg-card py-6 md:py-24">
  <div class="site-frame">
    <div class="@container relative w-full overflow-hidden border border-banner-line bg-section-grey p-4 shadow-[0_20px_25px_-5px_rgb(0_0_0/0.1),0_8px_10px_-6px_rgb(0_0_0/0.1)] md:p-24">

      {/* Brick-motif texture */}
      <Image
        src={brickMotif}
        alt=""
        width={2560}
        height={1200}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left-top"
        aria-hidden="true"
      />

      {/* Heading + note */}
      <div class="relative z-10 flex max-w-[768px] flex-col items-start gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]">
          {displayHeading}
        </h2>
        <p class="mt-4 font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]" set:html={note} />
      </div>

      {/* CTAs */}
      <div class="relative z-10 flex flex-wrap items-center gap-4 py-16">
        <a
          href={PRIMARY_CTA_HREF}
          class="inline-flex items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
        >
          {PRIMARY_CTA_LABEL}
        </a>
        <a
          href={CONTACT.phone.href}
          class="inline-flex items-center justify-center gap-2 bg-banner-text px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
        >
          <PhoneIcon />{CONTACT.phone.display}
        </a>
      </div>

      {/* Trust strip */}
      <p class="relative z-10 flex w-full flex-wrap items-center gap-x-5 gap-y-2">
        {trustItems.map((item, i) => (
          <>
            {i > 0 && (
              <span class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-dot uppercase" aria-hidden="true">•</span>
            )}
            <span class="whitespace-nowrap font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-note uppercase">{item}</span>
          </>
        ))}
      </p>

    </div>
  </div>
</section>
