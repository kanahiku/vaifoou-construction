---
import { twMerge } from 'tailwind-merge';
import { CONTACT } from '~/config/contact';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class={twMerge('block shrink-0 font-heading text-[20px] leading-none text-heading', className)}>
  {CONTACT.businessName}
</span>
