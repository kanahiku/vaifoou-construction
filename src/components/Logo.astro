---
import { Image } from 'astro:assets';
import { twMerge } from 'tailwind-merge';
import logoSrc from '~/assets/icons/logo-light.svg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Image
  src={logoSrc}
  alt="Vaifoou Construction"
  height={40}
  class={twMerge('h-10 w-auto object-contain', className)}
/>
