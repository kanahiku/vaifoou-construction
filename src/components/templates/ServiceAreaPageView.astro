---
/**
 * ServiceAreaPageView — template for every service-area location page
 * (/service-areas/<slug>/).
 *
 * All text and images come from the Sanity `serviceAreaPage` document whose `path` matches.
 * The "Explore Other Service Areas" grid lists every other area document. The page file only
 * passes the path.
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import FillImage from '~/components/ui/FillImage.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { getServiceAreaPage } from '~/lib/content';

export interface Props {
  path: string;
}

const { path } = Astro.props;
const page = await getServiceAreaPage(path);
if (!page) throw new Error(`Sanity serviceAreaPage document missing for "${path}". Run \`npm run seed:areas\`.`);

const { hero, intro, services, projects, faqs, cta } = page;
const metadata = { title: page.seo.title, description: page.seo.description };

const arrowIcon = `<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z"/></svg>`;
---

<Layout metadata={metadata}>
  {/* ── Hero ────────────────────────────────────────────────── */}
  <SubServiceHero title={hero.heading} body={hero.body} image={hero.image?.src} imageAlt={hero.image?.alt} />

  {/* ── Intro split — text left, image right ────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      <div class="flex flex-1 flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          {intro.heading}
        </h2>
        <p
          class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]"
        >
          {intro.body}
        </p>
      </div>
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage src={intro.image?.src} alt={intro.image?.alt} width={700} height={525} quality={68} />
      </div>
    </div>
  </section>

  {/* ── Services grid — 2-col linked cards ─────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          {services.heading}
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          services.cards.map(({ name, href, description }) => (
            <a
              href={href}
              class="group flex flex-col gap-3 border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-8"
            >
              <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[22px]">
                {name}
              </h3>
              <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{description}</p>
              <span class="mt-auto flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase">
                View service <Fragment set:html={arrowIcon} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Projects teaser — image left, text right ────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-20">
    <div class="site-frame flex flex-col gap-8 md:flex-row md:items-center md:gap-12">
      <div class="relative w-full shrink-0 overflow-hidden md:w-[480px]" style="aspect-ratio: 4/3;">
        <FillImage src={projects.image?.src} alt={projects.image?.alt} width={800} height={600} quality={68} />
      </div>
      <div class="flex flex-col gap-1">
        <h2
          class="font-display text-[26px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[36px]"
        >
          {projects.heading}
        </h2>
        <p class="mt-3 font-body text-[15px] leading-7 text-banner-note">{projects.body}</p>
        <a
          href={projects.ctaHref}
          class="mt-3 inline-flex items-center gap-2 font-display text-[14px] font-bold tracking-[0.7px] text-nav-cta uppercase hover:text-accent"
        >
          {projects.ctaLabel} <Fragment set:html={arrowIcon} />
        </a>
      </div>
    </div>
  </section>

  {/* ── Other area cross-links (every other area document) ──── */}
  <ServiceLinks
    categoryLabel="Service Areas"
    items={page.otherAreas.map(({ name, path }) => ({ title: name, href: path }))}
    maxItems={page.otherAreas.length}
  />

  {/* ── FAQ accordion ───────────────────────────────────────── */}
  <FAQs
    title={faqs.heading}
    items={faqs.items.map(({ question, answer }) => ({ title: question, description: answer }))}
  >
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ──────────────────────────────────────────── */}
  <BrickMotifCTA heading={cta.heading} note={cta.note} />
</Layout>
