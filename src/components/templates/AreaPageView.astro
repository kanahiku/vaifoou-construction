---
/**
 * AreaPageView — shared template for every service-area sub-page.
 *
 * Pass all page data as props; this template owns every repeated
 * section (intro split, services grid, recent-work split, FAQs, CTA).
 * The page file holds only data — no markup.
 *
 * Parallel to ServicePageView.astro which does the same for service pages.
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import FillImage from '~/components/ui/FillImage.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { getServiceAreaLocationMedia, getServiceCategoryPageMedia } from '~/lib/content';

export interface AreaService {
  name: string;
  href: string;
  description: string;
}

export interface AreaLink {
  title: string;
  href: string;
}

export interface FaqItem {
  title: string;
  description: string;
}

export interface Props {
  /** <title> tag and meta description */
  metadata: {
    title: string;
    description: string;
  };

  /** SubServiceHero props */
  hero: {
    eyebrow: string;
    title: string;
    body: string;
    imagePlaceholder?: string;
  };

  /** Intro split section — text left, image right */
  intro: {
    /** Short label folded into the section heading (e.g. "Wahiawa" or "Our Home Base") */
    eyebrow: string;
    /** Section H2 */
    heading: string;
    /** One or two body paragraphs */
    body: string;
    imagePlaceholder?: string;
  };

  /** 2-col linked service cards */
  services: AreaService[];
  /** H2 for the services section */
  servicesHeading: string;

  /** Recent-work split — image left, text right */
  recentWork: {
    heading: string;
    /** 1–2 sentence project description for this area */
    description: string;
    imagePlaceholder?: string;
  };

  /** Other area cross-links passed to ServiceLinks */
  otherAreas: AreaLink[];

  /** FAQ accordion */
  faqs: {
    title: string;
    items: FaqItem[];
  };

  /** BrickMotifCTA heading */
  ctaHeading: string;
}

const { metadata, hero, intro, services, servicesHeading, recentWork, otherAreas, faqs, ctaHeading } = Astro.props;

const arrowIcon = `<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z"/></svg>`;
const [media, rockWallMedia, retainingWallMedia, cmuBlockWallMedia, concreteMedia] = await Promise.all([
  getServiceAreaLocationMedia(Astro.url.pathname),
  getServiceCategoryPageMedia('/services/rock-walls/'),
  getServiceCategoryPageMedia('/services/retaining-walls/'),
  getServiceCategoryPageMedia('/services/cmu-block-walls/'),
  getServiceCategoryPageMedia('/services/concrete/'),
]);
const heroImage = media?.heroImage;
const introImage = media?.introImage;
const serviceProjectImages = [
  rockWallMedia?.projectImage,
  retainingWallMedia?.projectImage,
  cmuBlockWallMedia?.projectImage,
  concreteMedia?.projectImage,
].filter((image) => image?.src);
const areaImageSeed = [...Astro.url.pathname].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const recentWorkImage =
  serviceProjectImages.length > 0
    ? serviceProjectImages[areaImageSeed % serviceProjectImages.length]
    : media?.recentWorkImage;
const introHeading = intro.heading;
const servicesSectionHeading = servicesHeading;
const recentWorkHeading = recentWork.heading;
const recentWorkDescription =
  'Explore our recent work and see the quality, care, and craftsmanship we bring to every project. From start to finish, our team is committed to dependable service, careful attention to detail, and results built to last.';
---

<Layout metadata={metadata}>

  {/* ── Hero ────────────────────────────────────────────────── */}
  <SubServiceHero
    title={hero.title}
    body={hero.body}
    image={heroImage?.src}
    imageAlt={heroImage?.alt ?? hero.imagePlaceholder}
  />

  {/* ── Intro split — text left, image right ────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      <div class="flex flex-1 flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">
          {introHeading}
        </h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]" set:html={intro.body} />
      </div>
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage src={introImage?.src} alt={introImage?.alt ?? intro.imagePlaceholder} width={700} height={525} quality={68} />
      </div>
    </div>
  </section>

  {/* ── Services grid — 2-col linked cards ─────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">
          {servicesSectionHeading}
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {services.map(({ name, href, description }) => (
          <a href={href} class="group flex flex-col gap-3 border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-8">
            <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[22px]">
              {name}
            </h3>
            <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{description}</p>
            <span class="mt-auto flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase">
              View service <Fragment set:html={arrowIcon} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Recent work — image left, text right ────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-20">
    <div class="site-frame flex flex-col gap-8 md:flex-row md:items-center md:gap-12">
      <div class="relative w-full shrink-0 overflow-hidden md:w-[480px]" style="aspect-ratio: 4/3;">
        <FillImage src={recentWorkImage?.src} alt={recentWorkImage?.alt ?? recentWork.imagePlaceholder} width={800} height={600} quality={68} />
      </div>
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-[26px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[36px]">
          {recentWorkHeading}
        </h2>
        <p class="mt-3 font-body text-[15px] leading-7 text-banner-note">{recentWorkDescription}</p>
        <a href="/projects/" class="mt-3 inline-flex items-center gap-2 font-display text-[14px] font-bold tracking-[0.7px] text-nav-cta uppercase hover:text-accent">
          View Our Work <Fragment set:html={arrowIcon} />
        </a>
      </div>
    </div>
  </section>

  {/* ── Other area cross-links ───────────────────────────────── */}
  <ServiceLinks categoryLabel="Service Areas" items={otherAreas} maxItems={otherAreas.length} />

  {/* ── FAQ accordion ───────────────────────────────────────── */}
  <FAQs title={faqs.title} items={faqs.items}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ──────────────────────────────────────────── */}
  <BrickMotifCTA heading={ctaHeading} />

</Layout>
