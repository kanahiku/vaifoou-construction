---
import type { TocItem } from '~/lib/content/blogArticle';
import { Icon } from 'astro-icon/components';

export interface Props {
  toc: TocItem[];
  /** Author name shown in the author card. */
  author?: string;
  /** Keyword tags displayed as chips. */
  tags?: string[];
  /** Article title — used to pre-fill share text. */
  postTitle?: string;
  /** Canonical article URL — used to build share links. */
  postUrl?: string;
  ctaTitle?: string;
  ctaHref?: string;
  variant?: 'sticky' | 'inline';
}

const {
  toc,
  author,
  tags,
  postTitle = '',
  postUrl = '',
  ctaTitle = 'Have a question?',
  ctaHref = '/contact/',
  variant = 'sticky',
} = Astro.props;

const isSticky = variant === 'sticky';

---

<blog-toc-nav
  class:list={[
    'block',
    isSticky
      ? 'hidden lg:block lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto'
      : 'lg:hidden mb-10',
  ]}
>


  {/* ── Table of contents ─────────────────────────────────────── */}
  {
    toc.length > 0 && (
      <nav aria-label="On this page">
        {isSticky ? (
          <p class="mb-3 font-body text-[12px] font-medium uppercase tracking-wider text-muted">
            On this page
          </p>
        ) : (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-body text-[12px] font-medium uppercase tracking-wider text-muted [&::-webkit-details-marker]:hidden">
              On this page
              <span class="text-[16px] leading-none text-heading transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <ol class="mt-3 space-y-2.5">
              {toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    data-toc-link
                    class="block font-body text-[14px] font-normal leading-[150%] text-muted hover:text-heading md:text-[15px]"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}

        {isSticky && (
          <ol class="space-y-2.5">
            {toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-toc-link
                  class="block font-body text-[14px] font-normal leading-[150%] text-muted hover:text-heading md:text-[15px]"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ol>
        )}
      </nav>
    )
  }

  {/* ── Tags (sticky only) ────────────────────────────────────── */}
  {
    isSticky && tags && tags.length > 0 && (
      <div class:list={['mt-6', toc.length > 0 && 'border-t border-banner-line pt-6']}>
        <p class="mb-2.5 font-body text-[11px] font-bold uppercase tracking-wider text-muted">Tags</p>
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="border border-banner-line bg-page px-2.5 py-1 font-body text-[12px] font-medium text-muted">
              {tag}
            </span>
          ))}
        </div>
      </div>
    )
  }


</blog-toc-nav>

<style>
  blog-toc-nav a[data-toc-link][aria-current='location'] {
    color: var(--aw-color-text-heading, #222);
    font-weight: 500;
    text-decoration: none;
  }
</style>

{
  isSticky && (
    <script>
      // ── TOC scroll-spy ──────────────────────────────────────────────────────
      class BlogTocNav extends HTMLElement {
        abort?: () => void;

        connectedCallback() {
          const links = Array.from(this.querySelectorAll('a[data-toc-link]'));
          const items: { link: Element; target: HTMLElement }[] = [];

          for (const link of links) {
            const id = decodeURIComponent(link.getAttribute('href') || '').replace('#', '');
            const target = id ? document.getElementById(id) : null;
            if (target) items.push({ link, target });
          }

          if (items.length) {
            const marker = () => {
              const header = document.getElementById('header');
              const headerH = header?.getBoundingClientRect().height ?? 72;
              return Math.max(headerH + 56, 168);
            };

            const sync = () => {
              const line = marker();
              let active = items[0];
              for (const item of items) {
                if (item.target.getBoundingClientRect().top <= line) active = item;
              }
              for (const item of items) {
                if (item === active) item.link.setAttribute('aria-current', 'location');
                else item.link.removeAttribute('aria-current');
              }
            };

            sync();
            window.addEventListener('scroll', sync, { passive: true });
            window.addEventListener('resize', sync);
            window.addEventListener('hashchange', sync);
            this.abort = () => {
              window.removeEventListener('scroll', sync);
              window.removeEventListener('resize', sync);
              window.removeEventListener('hashchange', sync);
            };
          }


        }

        disconnectedCallback() {
          this.abort?.();
        }
      }

      if (!customElements.get('blog-toc-nav')) {
        customElements.define('blog-toc-nav', BlogTocNav);
      }
    </script>
  )
}
