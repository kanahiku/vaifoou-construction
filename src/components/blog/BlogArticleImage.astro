---
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  image?: ContentImage;
  caption?: string;
  eager?: boolean;
  class?: string;
}

const { image, caption, eager = false, class: className = 'my-8' } = Astro.props;
---

{
  image?.src && (
    <figure class={className}>
      <div class="relative w-full aspect-[16/9] overflow-hidden rounded-md bg-[#EFEFEF]">
        <Image
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover"
          widths={[400, 768, 1200]}
          sizes="(max-width: 768px) 100vw, 70vw"
          width={1200}
          height={675}
          layout="cover"
          format="webp"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      </div>
      {caption && (
        <figcaption class="mt-3 text-[14px] md:text-[15px] font-normal leading-[160%] text-muted">{caption}</figcaption>
      )}
    </figure>
  )
}
