---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import TestimonialCard from '~/components/ui/TestimonialCard.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { getReviewsPageMediaContent, getTestimonials } from '~/lib/content';
import { REVIEW_PROFILES } from '~/config/social';
import { site } from '~/config/site';

export const prerender = false;

const testimonials = await getTestimonials();
const media = await getReviewsPageMediaContent();
const heroImage = media?.heroImage;
const thumbtackTestimonials = [
  {
    quote:
      'They were very respectful, efficient and treated us like family! Great group of people that built a Top of the line 2 tier retaining wall in our backyard that will be enjoyed by our family for years to come! Thank you guys!',
    name: 'Aaron A.',
    location: undefined,
    tenure: undefined,
    platform: 'thumbtack' as const,
  },
  {
    quote: 'Amazing transformation. Hard workers and fast. Beautiful job',
    name: 'Deborah M.',
    location: undefined,
    tenure: undefined,
    platform: 'thumbtack' as const,
    reviewedAt: '2025-02-14',
  },
];
const yelpTestimonials = testimonials.slice(0, 4).map((testimonial) => ({
  ...testimonial,
  platform: 'yelp' as const,
}));
const featuredTestimonials = [...yelpTestimonials, ...thumbtackTestimonials].slice(0, 6);

const metadata = {
  title: `Reviews & Testimonials | ${site.name}`,
  description: `Read what O'ahu property owners and homeowners say about Vaifoou Construction's masonry and concrete work.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Vaifoou Construction Reviews"
    body="Read feedback from people who have worked with Vaifoou Construction on rock walls, concrete, retaining walls, and other masonry projects on Oʻahu."
    image={heroImage?.src}
    imageAlt={heroImage?.alt}
    imagePlaceholder="Vaifoou Construction completed project photo"
  />

  {/* ── Featured reviews ──────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          Featured Customer Reviews
        </h2>
        <p
          class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]"
        >
          Feedback from customers who have worked with Vaifoou Construction.
        </p>
      </div>

      {
        featuredTestimonials.length ? (
          <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
            {featuredTestimonials.map((t) => (
              <TestimonialCard
                tone="featured"
                quote={t.quote}
                name={t.name}
                location={t.location}
                tenure={t.tenure}
                platform={t.platform}
                reviewedAt={t.reviewedAt}
              />
            ))}
          </div>
        ) : (
          <div class="flex flex-col gap-4 border border-banner-line bg-white p-8 md:p-12">
            <p class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[22px]">
              Coming Soon
            </p>
            <p class="font-body text-[16px] font-normal leading-7 text-banner-note">
              Client reviews and testimonials will appear here as they are published.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {/* ── Review profiles ───────────────────────────────────────── */}
  {
    REVIEW_PROFILES.length > 0 && (
      <section class="w-full border-b border-banner-line bg-heading py-6 md:py-24">
        <div class="site-frame flex flex-col gap-10 md:gap-14">
          <div class="flex max-w-[896px] flex-col gap-1">
            <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-page uppercase md:text-[44px] md:leading-[52px]">
              Reviews From Across the Web
            </h2>
            <p class="mt-3 font-body text-[16px] font-normal leading-7 text-page/70 md:mt-4 md:text-[18px] md:leading-[29.25px]">
              Customer feedback about Vaifoou Construction can be found on independent review platforms.
            </p>
          </div>

          <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 md:gap-8">
            {REVIEW_PROFILES.map((profile) => (
              <article class="flex h-full flex-col border border-accent/40 bg-card-dark p-6 md:p-8">
                <span
                  class="inline-flex size-11 items-center justify-center border border-page/25 text-page"
                  aria-hidden="true"
                >
                  <Icon name={profile.icon} class="size-5" />
                </span>
                <h3 class="mt-5 font-display text-[28px] font-bold leading-8 tracking-[0.4px] text-page uppercase">
                  {profile.title}
                </h3>
                <p class="mt-3 flex-1 font-body text-[15px] font-normal leading-7 text-page/75">{profile.note}</p>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-8 inline-flex w-fit items-center justify-center border border-page/40 px-6 py-3 font-display text-[16px] font-bold leading-6 tracking-[1px] text-page uppercase transition-colors hover:bg-page hover:text-heading"
                >
                  {profile.linkText}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <BrickMotifCTA
    heading="Request a Site Consultation"
    note="If something is happening with your wall, walkway, or concrete, you do not need to know the solution before you call. Vaifoou can look at the site and help determine what work should be considered next. Please note we are closed on Sundays."
  />
</Layout>
