---
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import FillImage from '~/components/ui/FillImage.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';
import { getAudiencePageMedia } from '~/lib/content';

const metadata = {
  title: `O'ahu Commercial Masonry & Concrete | ${site.name}`,
  description: `Masonry and concrete for O'ahu property owners, property managers, HOAs and contractors. We build heavy-duty CMU and retaining walls. Request an estimate.`,
};

const audienceMedia = await getAudiencePageMedia(Astro.url.pathname);
const heroImage = audienceMedia?.heroImage;
const introImage = audienceMedia?.introImage;

const arrowIcon = `<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z"/></svg>`;

const services = [
  {
    name: 'Commercial Concrete',
    href: '/services/concrete/',
    description: 'New foundation pours and heavy-duty flatwork for high-traffic areas.',
  },
  {
    name: 'CMU & Block Walls',
    href: '/services/cmu-block-walls/',
    description: 'Division walls, block fences and CMU retaining walls built for long-term stability.',
  },
  {
    name: 'Retaining Walls',
    href: '/services/retaining-walls/',
    description: 'Heavy-duty structural support to manage commercial property terrain.',
  },
  {
    name: 'Custom Rock Walls',
    href: '/services/rock-walls/',
    description: 'Property boundaries built with hand-selected volcanic basalt.',
  },
];

const experiencePoints = [
  {
    heading: 'Clear Project Management',
    body: 'We coordinate directly with your site supervisors to maintain strict project schedules.',
  },
  {
    heading: 'Site Safety Standards',
    body: 'Our crews follow strict safety protocols to protect your tenants and employees during construction.',
  },
  {
    heading: 'Clean Work Site',
    body: 'We secure the work area at the end of every shift and remove all construction debris before handover.',
  },
];

const subLinks = [
  { title: 'Property Managers & Landlords', href: '/who-we-work-with/commercial/property-managers-landlords/' },
  { title: 'HOA Masonry & Concrete', href: '/who-we-work-with/commercial/hoa/' },
  { title: 'Masonry & Concrete Subcontracting', href: '/who-we-work-with/commercial/contractors/' },
];

const faqs = [
  {
    title: 'Do you act as a general contractor?',
    description:
      'No. We hold a C-31 Masonry Contractor license, CT-39534, and focus on masonry and concrete. We work directly with property owners and managers, and as a subcontractor to general contractors.',
  },
  {
    title: 'Do you perform commercial foundation repair?',
    description:
      'We pour new foundations for commercial builds but we do not perform structural foundation repair. We also do not install micropiles or tiebacks.',
  },
  {
    title: 'Can you handle the landscaping after the concrete is poured?',
    description:
      'We focus exclusively on masonry and concrete construction. We do not provide landscape design or general landscaping services.',
  },
  {
    title: 'Do you work on Sundays?',
    description: 'No. We are closed on Sundays.',
  },
  {
    title: "Do you bid on projects outside of O'ahu?",
    description: "No, our commercial service area is strictly limited to the island of O'ahu.",
  },
];
---

<Layout metadata={metadata}>
  {/* ── Hero ──────────────────────────────────────────────────────── */}
  <SubServiceHero
    title="O'ahu Commercial Masonry & Concrete"
    body="Masonry and concrete for O'ahu property owners, property managers, HOAs and contractors."
    image={heroImage?.src}
    imageAlt={heroImage?.alt}
  />

  {/* ── Intro split ───────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      <div class="flex flex-1 flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          Trusted by O&apos;ahu Property Managers
        </h2>
        <p
          class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]"
        >
          We work directly with commercial property owners, property managers and HOAs across the island, and as a
          masonry and concrete subcontractor to general contractors. We back our work with a 25+ year family legacy in
          the local masonry trade and our workmanship guarantee.
        </p>
        <p
          class="mt-4 font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]"
        >
          Upgrading your personal home?
        </p>
        <a
          href="/who-we-work-with/residential/"
          class="mt-2 inline-flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase transition-colors hover:text-accent"
        >
          View Residential Masonry &amp; Concrete <Fragment set:html={arrowIcon} />
        </a>
      </div>
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage src={introImage?.src} alt={introImage?.alt} width={700} height={525} quality={68} />
      </div>
    </div>
  </section>

  {/* ── Services grid ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          Commercial Masonry Services
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          services.map(({ name, href, description }) => (
            <a
              href={href}
              class="group flex flex-col gap-3 border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-8"
            >
              <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[22px]">
                {name}
              </h3>
              <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{description}</p>
              <span class="mt-auto flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase">
                View service <Fragment set:html={arrowIcon} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── The Commercial Experience ─────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          The Commercial Experience
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          experiencePoints.map(({ heading, body }) => (
            <div class="flex flex-col gap-3 border border-banner-line bg-card p-6 md:p-8">
              <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[20px]">
                {heading}
              </h3>
              <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Who we work with — sub-page links ─────────────────────────── */}
  <ServiceLinks
    categoryLabel="Commercial Clients"
    items={subLinks}
    maxItems={3}
    viewAllHref="/who-we-work-with/commercial/"
    viewAllLabel="View All Commercial Services"
  />

  {/* ── FAQ accordion ─────────────────────────────────────────────── */}
  <FAQs title="Commercial Masonry FAQs" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ────────────────────────────────────────────────── */}
  <BrickMotifCTA heading="Start Your Commercial Project" />
</Layout>
