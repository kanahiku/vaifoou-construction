---
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import FillImage from '~/components/ui/FillImage.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';
import { getAudiencePageMedia } from '~/lib/content';

const metadata = {
  title: `O'ahu Residential Masonry & Concrete | ${site.name}`,
  description: `Custom rock walls and concrete flatwork for O'ahu homeowners. We build secure property boundaries backed by a 25+ year family legacy. Request an estimate.`,
};

const audienceMedia = await getAudiencePageMedia(Astro.url.pathname);
const heroImage = audienceMedia?.heroImage;
const introImage = audienceMedia?.introImage;
const projectImage = audienceMedia?.projectImage;

const arrowIcon = `<svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z"/></svg>`;

const services = [
  {
    name: 'Custom Rock Walls',
    href: '/services/rock-walls/',
    description: 'Property boundaries built with hand-selected volcanic basalt.',
  },
  {
    name: 'Retaining Walls',
    href: '/services/retaining-walls/',
    description: "Rock and CMU retaining walls built for O'ahu's hillside terrain.",
  },
  {
    name: 'CMU & Block Fences',
    href: '/services/cmu-block-walls/',
    description: 'Structural division fences and security walls built for long-term stability.',
  },
  {
    name: 'Concrete Driveways & Patios',
    href: '/services/concrete/',
    description: 'New driveway pours and custom outdoor living spaces built for durability.',
  },
];

const experiencePoints = [
  {
    heading: 'Respect For Your Property',
    body: 'We establish clear access paths for our heavy equipment to minimize impact on your existing yard.',
  },
  {
    heading: 'Clear Project Timelines',
    body: 'Our crews maintain strict schedules to reduce disruption to your daily home life and your neighbors.',
  },
  {
    heading: 'Clean Work Site',
    body: 'We secure the work area at the end of every day and remove all construction debris before the final handover.',
  },
];

const faqs = [
  {
    title: 'Can you rebuild a failing rock wall?',
    description: 'Yes. We demolish failing, bulging or collapsed rock walls and rebuild them. See Rock Wall Repair.',
  },
  {
    title: 'Do you work on existing properties or just new builds?',
    description: 'We handle both new residential construction and property upgrades for existing homes across the island.',
  },
  {
    title: 'How do you handle my existing landscaping?',
    description: 'We do not provide landscape design, landscaping or plant replacement. When a concrete pour needs it, we remove trees and shrubs as site preparation only.',
  },
  {
    title: 'Do you perform residential foundation repair?',
    description: 'No. We pour new foundations for residential builds but we do not perform structural foundation repair, micropile drilling, or tiebacks.',
  },
  {
    title: "Do you serve homeowners outside of O'ahu?",
    description: "No, our service area is strictly limited to the island of O'ahu.",
  },
];
---

<Layout metadata={metadata}>

  {/* ── Hero ──────────────────────────────────────────────────────── */}
  <SubServiceHero
    title="O'ahu Residential Masonry & Concrete"
    body="Custom rock walls and concrete flatwork for O'ahu homeowners."
    image={heroImage?.src}
    imageAlt={heroImage?.alt}
  />

  {/* ── Intro split ───────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      <div class="flex flex-1 flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Upgrading O&apos;ahu Properties</h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]">
          We work directly with local homeowners to build secure property boundaries and durable concrete surfaces. We back every project with a 25+ year family legacy in the local masonry trade and our workmanship guarantee.
        </p>
        <p class="mt-4 font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]">
          Managing a commercial property or HOA?{' '}
          <a href="/who-we-work-with/commercial/" class="text-nav-cta transition-colors hover:text-accent">
            View Commercial Masonry &amp; Concrete
          </a>
        </p>
      </div>
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage src={introImage?.src} alt={introImage?.alt} width={700} height={525} quality={68} />
      </div>
    </div>
  </section>

  {/* ── Services grid ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Residential Masonry Services</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {services.map(({ name, href, description }) => (
          <a href={href} class="group flex flex-col gap-3 border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-8">
            <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[22px]">
              {name}
            </h3>
            <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{description}</p>
            <span class="mt-auto flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase">
              View service <Fragment set:html={arrowIcon} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── The Homeowner Experience ──────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">The Homeowner Experience</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {experiencePoints.map(({ heading, body }) => (
          <div class="flex flex-col gap-3 border border-banner-line bg-card p-6 md:p-8">
            <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[20px]">
              {heading}
            </h3>
            <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Recent work image ─────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-20">
    <div class="site-frame flex flex-col gap-8 md:flex-row md:items-center md:gap-12">
      <div class="relative w-full shrink-0 overflow-hidden md:w-[480px]" style="aspect-ratio: 4/3;">
        <FillImage src={projectImage?.src} alt={projectImage?.alt} width={800} height={600} quality={68} />
      </div>
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-[26px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[36px]">Our Work on O&apos;ahu</h2>
        <p class="mt-3 font-body text-[15px] leading-7 text-banner-note">From new concrete driveways to hand-laid volcanic basalt boundaries, browse our completed residential projects across the island.</p>
        <a href="/projects/" class="mt-3 inline-flex items-center gap-2 font-display text-[14px] font-bold tracking-[0.7px] text-nav-cta uppercase hover:text-accent">
          View Our Work <Fragment set:html={arrowIcon} />
        </a>
      </div>
    </div>
  </section>

  {/* ── FAQ accordion ─────────────────────────────────────────────── */}
  <FAQs title="Residential Masonry FAQs" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ────────────────────────────────────────────────── */}
  <BrickMotifCTA
    heading="Start Your Residential Project"
    note="Connect with our team to discuss your property requirements. Please note we are closed on Sundays to put God first."
  />

</Layout>
