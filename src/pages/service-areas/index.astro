---
/**
 * Service Areas hub — /service-areas/
 * All text and images come from the Sanity `serviceAreasHubPage` singleton; the community grid lists
 * every `serviceAreaPage` document (see getServiceAreasHub()).
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import FillImage from '~/components/ui/FillImage.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { getServiceAreasHub } from '~/lib/content';

const page = await getServiceAreasHub();
if (!page) throw new Error('Sanity serviceAreasHubPage document missing (singleton-service-areas-hub). Run `npm run seed:areas`.');

const { hero, intro, communities, faqs, cta } = page;
const metadata = { title: page.seo.title, description: page.seo.description };
---

<Layout metadata={metadata}>

  {/* ── Hero ─────────────────────────────────────────────────── */}
  <SubServiceHero
    title={hero.heading}
    body={hero.subheading}
    image={hero.image?.src}
    imageAlt={hero.image?.alt}
  />

  {/* ── Island-Wide Description ───────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      {/* Left — text */}
      <div class="flex flex-1 flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">{intro.heading}</h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]">
          {intro.body}
        </p>
      </div>
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage src={intro.image?.src} alt={intro.image?.alt} width={700} height={525} quality={68} />
      </div>
    </div>
  </section>

  {/* ── Communities Grid ─────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">

      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">{communities.heading}</h2>
        <p class="mt-1 max-w-2xl font-body text-[16px] font-normal leading-7 text-banner-note">
          {communities.body}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3 xl:grid-cols-4">
        {communities.areas.map(({ name, path }) => (
          <a
            href={path}
            class="group flex flex-col gap-2 border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta"
          >
            <span class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[20px]">
              {name}
            </span>
            <span class="flex items-center gap-1.5 font-display text-[15px] font-bold leading-5 tracking-[0.5px] text-nav-cta uppercase transition-colors group-hover:text-accent">
              {communities.cardLabel}
              <svg xmlns="http://www.w3.org/2000/svg" class="size-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  {/* ── FAQs ─────────────────────────────────────────────────── */}
  <FAQs
    title={faqs.heading}
    items={faqs.items.map(({ question, answer }) => ({ title: question, description: answer }))}
  >
    <div slot="bg" class="absolute inset-0 bg-page"></div>
  </FAQs>

  {/* ── CTA ──────────────────────────────────────────────────── */}
  <BrickMotifCTA
    heading={cta.heading}
    note={cta.note}
  />

</Layout>
