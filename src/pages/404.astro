---
import Layout from '~/layouts/Layout.astro';
import Button from '~/components/ui/Button.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { getRedirect } from '~/lib/content';

// Slug changed in Studio? Send old URLs to the new one (301) instead of a dead page.
const requested = new URL(Astro.request.url).pathname;
const redirect = await getRedirect(requested);
if (redirect?.to) return Astro.redirect(redirect.to, redirect.permanent === false ? 302 : 301);

Astro.response.status = 404;

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-3xl font-semibold md:text-3xl">Sorry, we couldn't find this page.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          But don't worry, you can find plenty of other things on our homepage.
        </p>
        <Button variant="primary" text="Back to homepage" href={getHomePermalink()} hideNote={true} />
      </div>
    </div>
  </section>
</Layout>
