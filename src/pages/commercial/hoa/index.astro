---
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `HOA Masonry & Concrete | ${site.name}`,
  description: `Vaifoou Construction provides masonry and concrete services for HOAs across O'ahu, including bid documentation and common-area work.`,
};

const siblingsLinks = [
  { title: 'Property Managers & Landlords', href: '/who-we-work-with/commercial/property-managers-landlords/' },
  { title: 'Masonry & Concrete Subcontracting', href: '/who-we-work-with/commercial/contractors/' },
];

const faqs = [
  {
    title: 'Do you provide formal bid documentation?',
    description: 'Yes. We supply the detailed bid documentation necessary to support your board and committee process.',
  },
  {
    title: 'Do you handle common-area repairs?',
    description: 'Yes. We execute masonry and concrete projects specifically for shared community spaces and common-area work.',
  },
  {
    title: 'Are your installations guaranteed?',
    description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee.",
  },
];
---

<Layout metadata={metadata}>

  {/* ── Hero ──────────────────────────────────────────────────────── */}
  <SubServiceHero
    eyebrow="Commercial"
    title="HOA Masonry & Concrete"
    body="We execute masonry and concrete projects for Homeowner Associations across O'ahu. Our crews manage common-area work and supply the detailed bid documentation required for your board and committee process."
    imagePlaceholder="HOA masonry project photo"
  />

  {/* ── Intro section ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-6 md:max-w-[720px]">
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">HOA Services: Built for HOA Requirements</h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]">
          We execute masonry and concrete projects for Homeowner Associations across O&apos;ahu. Our crews manage common-area work and supply the detailed bid documentation required for your board and committee process. Every project is backed by our workmanship guarantee.
        </p>
      </div>
    </div>
  </section>

  {/* ── Comparison table ──────────────────────────────────────────── */}
  <ServiceTable
    eyebrow="Comparison"
    heading="HOA vs. Standard Residential"
    col1="HOA Requirements"
    col2="Standard Residential"
    rows={[
      { feature: 'Approval',       val1: 'Board and committee process',        val2: 'Single homeowner decision' },
      { feature: 'Documentation',  val1: 'Formal bid documentation',           val2: 'Standard estimate' },
      { feature: 'Project Scope',  val1: 'Common-area work',                   val2: 'Private property' },
    ]}
  />

  {/* ── Sibling commercial service links ──────────────────────────── */}
  <ServiceLinks
    categoryLabel="Commercial Services"
    items={siblingsLinks}
    maxItems={3}
    viewAllHref="/who-we-work-with/commercial/"
    viewAllLabel="View All Commercial Services"
  />

  {/* ── FAQ accordion ─────────────────────────────────────────────── */}
  <FAQs title="Frequently Asked Questions" tagline="HOA Masonry" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ────────────────────────────────────────────────── */}
  <BrickMotifCTA heading="Request a Site Consultation" />

</Layout>
