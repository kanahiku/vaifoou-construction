---
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Property Managers & Landlords | ${site.name}`,
  description: `Vaifoou Construction provides reliable masonry and concrete services for property managers and landlords across O'ahu.`,
};

const siblingsLinks = [
  { title: 'HOA Masonry & Concrete',        href: '/who-we-work-with/commercial/hoa/' },
  { title: 'Masonry & Concrete Subcontracting', href: '/who-we-work-with/commercial/contractors/' },
];

const faqs = [
  {
    title: 'Do you coordinate work around active tenants?',
    description: 'Yes. We schedule our site work specifically to minimize disruption for your active tenants.',
  },
  {
    title: 'Do you handle multi-unit properties?',
    description: 'Yes. We manage masonry and concrete projects for multi-unit properties and repeat maintenance contracts.',
  },
  {
    title: 'Are your installations guaranteed?',
    description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee.",
  },
];
---

<Layout metadata={metadata}>

  {/* ── Hero ──────────────────────────────────────────────────────── */}
  <SubServiceHero
    eyebrow="Commercial"
    title="Property Managers & Landlords"
    body="We execute masonry and concrete projects for O'ahu property managers and landlords. Our crews handle multi-unit repairs and repeat maintenance contracts."
    imagePlaceholder="Property management masonry project photo"
  />

  {/* ── Intro section ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-6 md:max-w-[720px]">
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Property Management: Built for Property Managers</h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]">
          We execute masonry and concrete projects for O&apos;ahu property managers and landlords. Our crews handle multi-unit repairs and repeat maintenance contracts. We coordinate directly with owners and schedule site work around active tenants to minimize disruption. Every project is backed by our workmanship guarantee.
        </p>
      </div>
    </div>
  </section>

  {/* ── Comparison table ──────────────────────────────────────────── */}
  <ServiceTable
    eyebrow="Comparison"
    heading="Commercial vs. Residential"
    col1="Commercial Management"
    col2="Standard Residential"
    rows={[
      { feature: 'Scheduling',      val1: 'Coordinated around active tenants', val2: 'Direct homeowner schedule' },
      { feature: 'Project Scope',   val1: 'Multi-unit and repeat work',        val2: 'Single property projects' },
      { feature: 'Communication',   val1: 'Direct coordination with owners',   val2: 'Owner-occupant updates' },
    ]}
  />

  {/* ── Sibling commercial service links ──────────────────────────── */}
  <ServiceLinks
    categoryLabel="Commercial Services"
    items={siblingsLinks}
    maxItems={3}
    viewAllHref="/who-we-work-with/commercial/"
    viewAllLabel="View All Commercial Services"
  />

  {/* ── FAQ accordion ─────────────────────────────────────────────── */}
  <FAQs title="Frequently Asked Questions" tagline="Property Management" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── CTA closer ────────────────────────────────────────────────── */}
  <BrickMotifCTA heading="Request a Site Consultation" />

</Layout>
