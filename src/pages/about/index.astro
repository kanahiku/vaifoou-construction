---
/**
 * About — /about/
 * Our Story, 25+ Year Legacy, Values, Team
 */
import Layout from '~/layouts/PageLayout.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import FillImage from '~/components/ui/FillImage.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import { getAboutPage } from '~/lib/content';

const page = await getAboutPage();
if (!page) throw new Error('Sanity aboutPage document missing. Run `npm run seed:about`.');
const { hero, story, legacy, values, crew, cta } = page;

const metadata = { title: page.seo.title, description: page.seo.description, ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  <SubServiceHero
    title={hero.heading}
    body={hero.body}
    image={hero.image?.src}
    imageAlt={hero.image?.alt}
    imageWidth={2400}
    imageHeight={960}
    imageWidths={[640, 960, 1200, 1600, 2000, 2400]}
    imageQuality={90}
    showCtas={false}
  />

  {/* ── Our Story ────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-12 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:gap-16">
      {/* Intro */}
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          {story.heading}
        </h2>
        <p class="mt-3 max-w-3xl font-body text-[17px] font-normal leading-[1.75] text-banner-note">
          {story.body}
        </p>
      </div>

      {/* 25+ Year Legacy — split layout */}
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_400px] lg:items-start">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-1">
            <h2
              class="font-display text-[26px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[38px]"
            >
              {legacy.heading}
            </h2>
          </div>
          <div class="flex flex-col gap-5 font-body text-[17px] font-normal leading-[1.75] text-banner-note">
            {legacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          {/* Timeline accent */}
          <div class="flex flex-col gap-0 border-l-2 border-nav-cta pl-5">
            {
              legacy.timeline.map(({ year, label }) => (
                <div class="flex flex-col gap-0.5 py-4 border-b border-banner-line last:border-0">
                  <p class="font-display text-[13px] font-bold tracking-[0.65px] text-nav-cta uppercase">{year}</p>
                  <p class="font-body text-[15px] font-normal leading-6 text-heading">{label}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-3 lg:sticky lg:top-24">
          <div class="relative w-full overflow-hidden" style="aspect-ratio: 4 / 5;">
            <FillImage src={legacy.image?.src} alt={legacy.image?.alt} width={800} height={1000} quality={68} />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Our Values ───────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-12 md:py-20">
    <div class="site-frame flex flex-col gap-10">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          {values.heading}
        </h2>
        <p class="mt-3 max-w-2xl font-body text-[17px] font-normal leading-[1.75] text-banner-note">
          {values.body}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 md:gap-8">
        {
          values.items.map(({ label, body }) => (
            <div class="flex flex-col gap-4 border border-banner-line bg-white p-6 sm:p-8">
              <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[20px]">
                {label}
              </h3>
              <p class="font-body text-[15px] font-normal leading-7 text-banner-note">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Our Crew ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-12 md:py-20">
    <div class="site-frame flex flex-col gap-10">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          {crew.heading}
        </h2>
        <p class="mt-3 max-w-3xl font-body text-[17px] font-normal leading-[1.75] text-banner-note">
          {crew.body}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          crew.members.map(({ name, role }) => (
            <div class="flex flex-col gap-1 border border-banner-line bg-white p-5">
              <h3 class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase">
                {name}
              </h3>
              <p class="font-body text-[13px] font-bold leading-4 tracking-[1px] text-nav-cta uppercase">{role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── CTA ──────────────────────────────────────────────────── */}
  <BrickMotifCTA
    heading={cta.heading}
    note={cta.note}
  />
</Layout>
