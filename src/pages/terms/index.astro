---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { CONTACT } from '~/config/contact';

const metadata = {
  title: `Terms of Use | ${CONTACT.businessName}`,
  description: `Read the website terms of use for ${CONTACT.businessName}.`,
  ignoreTitleTemplate: true,
};

const h2 = 'font-display text-[20px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[24px]';
const body = 'mt-2 font-body text-[15px] leading-7 text-banner-note md:text-[16px]';
---

<Layout metadata={metadata}>

  {/* ── Page hero ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-heading py-14 md:py-20">
    <div class="site-frame flex flex-col gap-1">
      <p class="flex items-center gap-2 font-body text-[12px] font-bold leading-4 tracking-[1.2px] text-page/50 uppercase">
        <span class="h-3 w-1.5 rounded-full bg-nav-cta" aria-hidden="true"></span>
        Legal
      </p>
      <h1 class="font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[56px]">
        Terms of Use
      </h1>
    </div>
  </section>

  {/* ── Body ───────────────────────────────────────────────────── */}
  <WidgetWrapper containerClass="max-w-container mx-auto">
    <div class="max-w-3xl space-y-10 md:space-y-14">

      <section>
        <p class={body}>
          These terms govern your access to vaifoouconstruction.com. By browsing this website, you agree to these operational conditions.
        </p>
      </section>

      <section>
        <h2 class={h2}>Website Content</h2>
        <p class={body}>
          All text, photography and branding on this site belong to {CONTACT.businessName}. Unauthorized reproduction is strictly prohibited.
        </p>
      </section>

      <section>
        <h2 class={h2}>Service Estimates and Agreements</h2>
        <p class={body}>
          Online estimate requests do not constitute binding legal contracts. All project scopes, timeline estimates, pricing parameters, and workmanship guarantees are formalized in writing following a direct on-site consultation.
        </p>
      </section>

      <section>
        <h2 class={h2}>Liability</h2>
        <p class={body}>
          {CONTACT.businessName} provides website information for general reference. We are not liable for decisions made based solely on web content prior to an on-site consultation.
        </p>
      </section>

    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <BrickMotifCTA heading="Ready to Start Your Project?" />

</Layout>
