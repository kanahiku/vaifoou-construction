---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { CONTACT } from '~/config/contact';

const metadata = {
  title: `Privacy Policy | ${CONTACT.businessName}`,
  description: `Learn how ${CONTACT.businessName} collects and protects your personal information on our website.`,
  ignoreTitleTemplate: true,
};

const h2 = 'font-display text-[20px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[24px]';
const body = 'mt-2 font-body text-[15px] leading-7 text-banner-note md:text-[16px]';
const linkClass = 'text-nav-cta underline underline-offset-2 hover:text-accent';
---

<Layout metadata={metadata}>

  {/* ── Page hero ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-heading py-14 md:py-20">
    <div class="site-frame flex flex-col gap-1">
      <p class="flex items-center gap-2 font-body text-[12px] font-bold leading-4 tracking-[1.2px] text-page/50 uppercase">
        <span class="h-3 w-1.5 rounded-full bg-nav-cta" aria-hidden="true"></span>
        Legal
      </p>
      <h1 class="font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[56px]">
        Privacy Policy
      </h1>
    </div>
  </section>

  {/* ── Body ───────────────────────────────────────────────────── */}
  <WidgetWrapper containerClass="max-w-container mx-auto">
    <div class="max-w-3xl space-y-10 md:space-y-14">

      <section>
        <p class={body}>
          {CONTACT.businessName} respects your privacy. This policy outlines how we handle the information collected through vaifoouconstruction.com.
        </p>
      </section>

      <section>
        <h2 class={h2}>Information Collection</h2>
        <p class={body}>
          We collect personal data when you submit an estimate request or contact our team directly. This information includes your name and phone number. We also collect your project address and specific site details. Our website also collects basic browsing analytics to monitor site performance.
        </p>
      </section>

      <section>
        <h2 class={h2}>Data Usage</h2>
        <p class={body}>
          We use your submitted information exclusively to review your project requirements and schedule site consultations. We do not sell your personal data to marketing agencies or third parties.
        </p>
      </section>

      <section>
        <h2 class={h2}>Contact Us</h2>
        <p class={body}>
          For questions regarding your data or to request record removal, contact us at{' '}
          <a href="mailto:vaifoou4@gmail.com" class={linkClass}>vaifoou4@gmail.com</a>{' '}
          or call{' '}
          <a href={CONTACT.phone.href} class={linkClass}>{CONTACT.phone.display}</a>.
        </p>
      </section>

    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <BrickMotifCTA heading="Questions About Your Data?" />

</Layout>
