---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import InfoCard from '~/components/ui/InfoCard.astro';
import Timeline from '~/components/ui/Timeline.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import { site } from '~/config/site';
import { PRIMARY_CTA_LABEL, PRIMARY_CTA_HREF } from '~/config/cta';

const metadata = {
  title: site.name,
  description: site.description,
  ignoreTitleTemplate: true,
};

const services = [
  {
    title: 'Residential Construction',
    description: 'Placeholder service copy for the upcoming design and content pass.',
    icon: 'tabler:home',
  },
  {
    title: 'Commercial Projects',
    description: 'A reusable card section ready to be restyled once the Figma system lands.',
    icon: 'tabler:building',
  },
  {
    title: 'Renovations',
    description: 'Keep this starter content light so the real site can be composed from Figma.',
    icon: 'tabler:tool',
  },
];

const processSteps = [
  {
    title: 'Consultation',
    description: 'Gather project goals, site details, budget range, and timeline.',
    icon: 'tabler:messages',
  },
  {
    title: 'Planning',
    description: 'Define scope, materials, approvals, and the build schedule.',
    icon: 'tabler:clipboard-list',
  },
  {
    title: 'Construction',
    description: 'Coordinate the work with clear updates from kickoff through handoff.',
    icon: 'tabler:hammer',
  },
];
---

<Layout metadata={metadata}>
  <Hero2
    id="home-hero"
    variant="split-dark"
    overlapHeader={false}
    hideImage
    tagline="New client starter"
    title="Vaifoou Construction"
    content="A clean starter site for the new construction project. The design system, homepage sections, and final content will be rebuilt from the Figma MCP references."
    actions={[
      { variant: 'primary', text: PRIMARY_CTA_LABEL, href: PRIMARY_CTA_HREF },
      { variant: 'ghost-dark', text: 'View starter sections', href: '#services' },
    ]}
  />

  <WidgetWrapper id="services">
    <Headline
      tagline="Starter content"
      title="Reusable Service Cards"
      subtitle="These are placeholders only. The real service structure should come from the Figma homepage."
    />
    <div class="grid gap-5 md:grid-cols-3">
      {services.map((item) => <InfoCard {...item} variant="light" />)}
    </div>
    <Fragment slot="bg">
      <SectionBg variant="white" />
    </Fragment>
  </WidgetWrapper>

  <WidgetWrapper id="process">
    <Headline
      tagline="Starter flow"
      title="Simple Project Process"
      subtitle="This keeps a reusable timeline pattern available without carrying over old project copy."
    />
    <Timeline items={processSteps} defaultIcon="tabler:circle-check" surface="grey" />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    eyebrow="Next step"
    title="Ready for the Figma build."
    subtitle="Send the design system and homepage MCP links and this starter can be reshaped into the new site."
    ctaText={PRIMARY_CTA_LABEL}
    ctaHref={PRIMARY_CTA_HREF}
  />
</Layout>
