---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { CONTACT } from '~/config/contact';

const metadata = {
  title: `Accessibility Statement | ${CONTACT.businessName}`,
  description: `${CONTACT.businessName} is committed to ensuring digital accessibility for all website visitors.`,
  ignoreTitleTemplate: true,
};

const h2 = 'font-display text-[20px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[24px]';
const body = 'mt-2 font-body text-[15px] leading-7 text-banner-note md:text-[16px]';
const linkClass = 'text-nav-cta transition-colors hover:text-accent';
---

<Layout metadata={metadata}>

  {/* ── Page hero ─────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-heading py-14 md:py-20">
    <div class="site-frame flex flex-col gap-1">
      <h1 class="font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[56px]">Legal: Accessibility Statement</h1>
    </div>
  </section>

  {/* ── Body ───────────────────────────────────────────────────── */}
  <WidgetWrapper containerClass="max-w-container mx-auto">
    <div class="max-w-3xl space-y-10 md:space-y-14">

      <section>
        <p class={body}>
          {CONTACT.businessName} is committed to digital accessibility. We are working toward conformance with the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA on vaifoouconstruction.com.
        </p>
      </section>

      <section>
        <h2 class={h2}>Ongoing Improvements</h2>
        <p class={body}>
          The site is built with semantic headings, keyboard navigation, alt text on images and color contrast in mind. We review pages as they are added, and we fix issues as they are reported to us.
        </p>
      </section>

      <section>
        <h2 class={h2}>Feedback and Assistance</h2>
        <p class={body}>
          If you encounter any barriers while using our website or require assistance reading our service information, contact us directly. Call{' '}
          <a href={CONTACT.phone.href} class={linkClass}>{CONTACT.phone.display}</a>{' '}
          or email{' '}
          <a href="mailto:vaifoou4@gmail.com" class={linkClass}>vaifoou4@gmail.com</a>.
        </p>
      </section>

    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <BrickMotifCTA heading="Need Help Accessing Our Site?" />

</Layout>
