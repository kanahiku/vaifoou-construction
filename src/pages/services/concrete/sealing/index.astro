---
/**
 * Concrete Sealing — /services/concrete/sealing/
 * Content: docs/service/concrete-service/…Concrete Sealing.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';
import { photos } from '~/data/photos';

const metadata = {
  title: `Concrete Sealing | ${site.name}`,
  description: `Protect your O'ahu concrete surfaces with professional sealing by Vaifoou Construction. Contact us to schedule a site estimate.`,
};

const tableRows = [
  { feature: 'Surface Protection', val1: 'Resists moisture and stains', val2: 'Vulnerable to absorption' },
  { feature: 'Decorative Finish', val1: 'Preserves color and texture', val2: 'Fades over time' },
  { feature: 'Structural Lifespan', val1: 'Extends the life of the pour', val2: 'Accelerates surface wear' },
];

const links = [
  { title: 'Concrete Driveways',           href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways',         href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios',              href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways',   href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations',         href: '/services/concrete/foundations/' },
  { title: 'Stem Walls',                   href: '/services/concrete/stem-walls/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
];

const faqs = [
  { title: 'Why is concrete sealing important?', description: 'It protects the structural surface from moisture and preserves the appearance of decorative work.' },
  { title: 'How often should I seal my concrete?', description: 'We recommend a regular resealing cycle to maintain ongoing surface protection and prevent aesthetic fading.' },
  { title: 'Are your services guaranteed?', description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Concrete Sealing"
    body="We apply professional concrete sealer to protect your surfaces from moisture, UV damage, and daily wear across O'ahu. Routine sealing is one of the most cost-effective ways to preserve your concrete investment long-term. Every installation is backed by our workmanship guarantee."
    image={photos.commercial.src}
    imageAlt={photos.commercial.alt}
  />
  <ServiceTable
    heading="Routine Maintenance vs. Unsealed Concrete"
    col1="Routine Sealing"
    col2="Unsealed Concrete"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Request a Site Consultation" />
</Layout>
