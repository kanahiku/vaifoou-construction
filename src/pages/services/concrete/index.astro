---
/**
 * Concrete Services hub page — /services/concrete/
 * Content: docs/service/Vaifoou Construction Service Pages - Concrete Services.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import brickMotif from '~/assets/brick-motif-wide-light.svg';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

const metadata = {
  title: "O'ahu Concrete Contractor | Vaifoou Construction",
  description: "Concrete driveways, patios, walkways, steps, foundations and stamped concrete for homes and businesses across O'ahu. Request an estimate.",
  ignoreTitleTemplate: true,
};

const subServices = [
  { title: 'Concrete Driveways',         href: '/services/concrete/driveways/',          description: 'New driveway installations built for daily vehicle traffic.' },
  { title: 'Sidewalks & Walkways',        href: '/services/concrete/sidewalks/',          description: 'Residential pathways and commercial curb layouts.' },
  { title: 'Concrete Patios',             href: '/services/concrete/patios/',             description: 'Custom patios and lanai extensions.' },
  { title: 'Steps & Stairways',           href: '/services/concrete/steps/',              description: 'Structural access steps and custom stairway construction.' },
  { title: 'Concrete Foundations',        href: '/services/concrete/foundations/',        description: 'New foundation pours only. We do not do foundation repair.' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/', description: 'Custom patterns and finish options for decorative flatwork.' },
  { title: 'Concrete Sealing',            href: '/services/concrete/sealing/',            description: 'Surface protection for new pours and stamped layouts.' },
];

const steps = [
  { n: '01', title: 'Consultation',       body: 'We review your property and define the exact project requirements.' },
  { n: '02', title: 'Site Preparation',   body: 'Our team prepares the ground and sets the forms for structural accuracy. We handle necessary tree and shrub removal strictly for site preparation.' },
  { n: '03', title: 'The Pour',           body: 'We pour and place the concrete within the forms.' },
  { n: '04', title: 'Finishing',          body: 'The team finishes the surface, and seals stamped and decorative work.' },
];

const faqs = [
  {
    q: 'What types of concrete finishes do you offer?',
    a: 'We provide standard flatwork finishes and custom stamped concrete layouts. We will help you select the best surface option during your initial consultation.',
  },
  {
    q: 'Do you repair existing structural foundations?',
    a: 'No. We pour new foundations but we do not perform structural foundation repair. We also do not perform micropile drilling or tieback installations.',
  },
  {
    q: 'Do you handle tree removal before pouring a driveway?',
    a: 'Tree and shrub removal is only available as necessary site preparation prior to our concrete pours. We do not provide general landscaping services.',
  },
  {
    q: 'Do you offer concrete sealing?',
    a: 'Yes. We seal new stamped and decorative concrete, and reseal it as a return service to keep the finish protected.',
  },
  {
    q: "Do you pour concrete outside of O'ahu?",
    a: "No, our service area is strictly limited to the island of O'ahu.",
  },
];

const related = [
  { title: 'Rock Walls',        href: '/services/rock-walls/' },
  { title: 'Retaining Walls',   href: '/services/retaining-walls/' },
  { title: 'CMU & Block Walls', href: '/services/cmu-block-walls/' },
];
---

<Layout metadata={metadata}>

  {/* ── HERO ─────────────────────────────────────────────────── */}
  <section class="relative w-full overflow-hidden border-b border-banner-line min-h-[400px] md:min-h-[500px]">
    <HeroImagePlaceholder fill hideLabel class="absolute inset-0" label="Concrete project image placeholder" />
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgb(28 27 26 / 90%) 0%, rgb(28 27 26 / 72%) 55%, rgb(28 27 26 / 30%) 100%);" aria-hidden="true"></div>
    <div class="site-frame relative z-10 flex flex-col items-start gap-4 pb-16 pt-16 md:pb-24 md:pt-24">
      <h1 class="max-w-[896px] font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[72px] md:tracking-[-0.8px]">O'ahu Concrete &amp; Flatwork Services</h1>
      <p class="max-w-[640px] font-display text-[16px] font-semibold leading-snug tracking-[0.2px] text-page/80 md:text-[22px] md:leading-[32px]">Driveways, patios, walkways, steps, foundations and decorative concrete poured for long-term durability.</p>
      <div class="flex flex-wrap items-center gap-4 pb-8 pt-2 md:pb-12 md:pt-6">
        <a href={PRIMARY_CTA_HREF} class="inline-flex items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]">{PRIMARY_CTA_LABEL}</a>
        <a href={CONTACT.phone.href} class="inline-flex items-center justify-center gap-2 border border-muted/30 bg-banner-text px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"><PhoneIcon />Call {CONTACT.phone.display}</a>
      </div>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-muted/30 pt-6">
        {[CONTACT.license, 'Licensed & Insured', "Serving All of O'ahu"].map((item, i) => (<>{i > 0 && <span class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-dot uppercase" aria-hidden="true">•</span>}<span class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-page/80 uppercase">{item}</span></>))}
      </p>
    </div>
  </section>

  {/* ── INTRO ─────────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      {/* Left — text */}
      <div class="flex flex-1 flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Poured For Long-Term Durability</h2>
        <p class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]">We pour custom concrete layouts for residential and commercial properties across the island. Our crews handle flatwork, new foundations and decorative concrete. Every project is backed by a 25+ year family legacy in the O'ahu masonry trade and comes with our workmanship guarantee.</p>
      </div>
      {/* Right — image */}
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <!-- TODO: replace with <Image> when asset is ready — concrete pour project photo -->
        <HeroImagePlaceholder fill class="absolute inset-0" label="Concrete construction photo" />
      </div>
    </div>
  </section>

  {/* ── CONCRETE SERVICES GRID ───────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1 border-b border-banner-line pb-6">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Custom Concrete Services</h2>
      </div>
      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3 lg:grid-cols-4 md:gap-8">
        {subServices.map(({ title, href, description }) => (
          <article class="flex h-full flex-col border border-banner-line bg-white p-6 md:p-8">
            <h3 class="font-display text-[18px] font-semibold leading-6 tracking-[0.2px] text-heading uppercase md:text-[20px]">{title}</h3>
            <p class="mt-3 flex-1 font-body text-[14px] font-normal leading-6 text-banner-note">{description}</p>
            <a href={href} class="mt-5 inline-flex items-center gap-1.5 font-display text-[12px] font-bold leading-4 tracking-[0.5px] text-nav-cta uppercase transition-colors hover:text-heading">
              View {title}
              <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="currentColor"/></svg>
            </a>
          </article>
        ))}
      </div>
      {/* Project photo + View Our Work */}
      <div class="flex flex-col gap-0 border border-banner-line bg-page overflow-hidden md:flex-row md:items-stretch min-h-[320px] md:min-h-[400px]">
        {/* Left — image (50%) */}
        <div class="relative w-full md:w-1/2" style="aspect-ratio: 4/3;">
          <!-- TODO: replace with <Image> when asset is ready — completed concrete project photo -->
          <HeroImagePlaceholder fill class="absolute inset-0" label="Concrete project image placeholder" />
        </div>
        {/* Right — text + CTA (50%) */}
        <div class="flex w-full flex-col justify-center gap-5 p-8 md:w-1/2 md:p-12">
          <p class="font-body text-[16px] font-normal leading-7 text-banner-note md:text-[17px]">Real photo of a completed concrete driveway or patio project on O'ahu, labeled by location.</p>
          <a href="/projects/" class="self-start inline-flex items-center gap-2 bg-nav-cta px-6 py-3 font-display text-[13px] font-bold leading-4 tracking-[1px] text-page-end uppercase transition-colors hover:bg-heading">
            View Our Work
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="currentColor"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── PROCESS ──────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:gap-14">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">The Construction Process</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-4 md:gap-8">
        {steps.map(({ n, title, body }) => (
          <div class="flex flex-col gap-3 border-l-2 border-nav-cta pl-5">
            <span class="font-display text-[32px] font-bold leading-none tracking-[-0.5px] text-nav-cta/30">{n}</span>
            <h3 class="font-display text-[18px] font-bold leading-5 tracking-[0.3px] text-heading uppercase">{title}</h3>
            <p class="font-body text-[14px] font-normal leading-6 text-banner-note">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── FAQs ─────────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:gap-14">
      <div class="flex max-w-[896px] flex-col gap-1 border-b border-banner-line pb-6">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">Concrete Construction FAQs</h2>
      </div>
      <div class="flex flex-col divide-y divide-banner-line">
        {faqs.map(({ q, a }) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4">
              <span class="font-display text-[17px] font-semibold leading-6 tracking-[0.17px] text-heading uppercase md:text-[19px]">{q}</span>
              <span class="flex size-8 shrink-0 items-center justify-center border border-banner-line bg-white text-heading/50 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="pb-5 font-body text-[15px] font-normal leading-7 text-banner-note md:max-w-[80%]">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ── RELATED SERVICES ─────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-20">
    <div class="site-frame flex flex-col gap-8">
      <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">
        Explore Related Masonry Services
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
        {related.map(({ title, href }) => (
          <a href={href} class="flex items-center justify-between border border-banner-line bg-card px-6 py-5 font-display text-[16px] font-semibold leading-5 tracking-[0.5px] text-heading uppercase transition-colors hover:border-nav-cta hover:text-nav-cta md:text-[18px]">
            {title}
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0"><path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="currentColor"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA BANNER ───────────────────────────────────────────── */}
  <section class="w-full bg-card py-6 md:py-24">
    <div class="site-frame">
      <div class="@container relative w-full overflow-hidden border border-banner-line bg-section-grey p-4 shadow-[0_20px_25px_-5px_rgb(0_0_0/0.1),0_8px_10px_-6px_rgb(0_0_0/0.1)] md:p-24">
        <Image src={brickMotif} alt="" width={2560} height={1200} class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left-top" aria-hidden="true" />
        <div class="relative z-10 flex max-w-[768px] flex-col items-start">
          <h2 class="mb-4 font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]">Start Your O'ahu Concrete Project</h2>
          <p class="font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]">Connect with our team to discuss your concrete flatwork requirements. Please note we are closed on Sundays.</p>
        </div>
        <div class="relative z-10 flex flex-wrap items-center gap-4 py-16">
          <a href={PRIMARY_CTA_HREF} class="inline-flex items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]">{PRIMARY_CTA_LABEL}</a>
          <a href={CONTACT.phone.href} class="inline-flex items-center justify-center gap-2 bg-banner-text px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"><PhoneIcon />Call {CONTACT.phone.display}</a>
        </div>
        <p class="relative z-10 flex w-full flex-wrap items-center gap-x-5 gap-y-2">
          {[CONTACT.license, 'Licensed & Insured', "Serving All of O'ahu"].map((item, i) => (<>{i > 0 && <span class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-dot uppercase" aria-hidden="true">•</span>}<span class="whitespace-nowrap font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-note uppercase">{item}</span></>))}
        </p>
      </div>
    </div>
  </section>

</Layout>
