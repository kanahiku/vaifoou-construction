---
/**
 * Concrete Foundations — /services/concrete/foundations/
 * Content: docs/service/concrete-service/…Concrete Foundations.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Concrete Foundations | ${site.name}`,
  description: `Vaifoou Construction pours new concrete foundations for residential and commercial builds across O'ahu. Contact us for a site estimate.`,
};

const tableRows = [
  { feature: 'Primary Focus',        val1: 'New foundation pours',           val2: 'Structural foundation repair' },
  { feature: 'Site Application',     val1: 'Ground-up construction',          val2: 'Retrofitting existing structures' },
  { feature: 'Specialized Elements', val1: 'Standard structural footings',    val2: 'Micropiles and tiebacks' },
];

const links = [
  { title: 'Concrete Driveways',           href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways',         href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios',              href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways',   href: '/services/concrete/steps/' },
  { title: 'Stem Walls',                   href: '/services/concrete/stem-walls/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
  { title: 'Concrete Sealing',             href: '/services/concrete/sealing/' },
];

const faqs = [
  { title: 'Do you repair existing foundations?',          description: 'No. We focus exclusively on new foundation work. We do not offer structural foundation repair.' },
  { title: 'Do you install micropiles or tiebacks?',       description: 'No. We do not handle micropiles or tiebacks. Our crews specialize in standard new concrete pours.' },
  { title: 'Are your installations guaranteed?',           description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Concrete Foundations"
    body="We pour concrete foundations for new residential and commercial builds across O'ahu. Our crews specialize exclusively in ground-up construction. Because our expertise is dedicated entirely to new foundation pours, structural repair work falls outside our service scope. Every new installation is backed by our family's 25+ year trade legacy and workmanship guarantee."
  />
  <ServiceTable
    heading="Foundation Service Scope"
    col1="Included Services"
    col2="Excluded Services"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Concrete Foundation FAQs" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Request a Site Consultation" />
</Layout>
