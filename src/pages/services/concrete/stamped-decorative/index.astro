---
/**
 * Stamped & Decorative Concrete — /services/concrete/stamped-decorative/
 * Content: docs/service/concrete-service/…Stamped & Decorative Concrete.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';
import { photos } from '~/data/photos';

const metadata = {
  title: `Stamped & Decorative Concrete | Vaifoou Construction LLC`,
  description: `Vaifoou Construction pours stamped and decorative concrete with various pattern and finish options across O'ahu. Contact us for an estimate.`,
};

const tableRows = [
  { feature: 'Aesthetic', val1: 'Custom patterns and textures', val2: 'Traditional textured surface' },
  { feature: 'Maintenance', val1: 'Requires regular sealing', val2: 'Minimal maintenance required' },
  { feature: 'Application', val1: 'Patios, driveways, and entries', val2: 'High-traffic utility pathways' },
];

const links = [
  { title: 'Concrete Driveways',         href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways',       href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios',            href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways', href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations',       href: '/services/concrete/foundations/' },
  { title: 'Stem Walls',                 href: '/services/concrete/stem-walls/' },
  { title: 'Concrete Sealing',           href: '/services/concrete/sealing/' },
];

const faqs = [
  { title: 'What pattern and finish options do you offer?', description: 'We provide a variety of decorative patterns and custom finish options designed to complement your property style.' },
  { title: 'Does decorative concrete require special maintenance?', description: 'Yes. Stamped surfaces require routine maintenance to maintain their color and texture. We handle this directly through our Concrete Sealing service.' },
  { title: 'Are your installations guaranteed?',                            description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Stamped & Decorative Concrete"
    body="We pour stamped and decorative concrete for residential and commercial properties across O'ahu. Our crews provide multiple pattern and finish options to match your exact design requirements. Every installation is backed by our family's 25+ year trade legacy and workmanship guarantee."
    image={photos.commercial.src}
    imageAlt={photos.commercial.alt}
  />
  <ServiceTable
    heading="Finish Options"
    note="Choosing a decorative finish allows you to elevate the look of standard flatwork. To protect these specialized finishes over time, we strongly recommend establishing a regular maintenance schedule through our dedicated Concrete Sealing service."
    col1="Stamped & Decorative Finish"
    col2="Standard Broom Finish"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA
    heading="Request a Site Consultation"
    note="We bring our family's 25+ year trade legacy to every project site. Contact us to schedule an estimate."
  />
</Layout>
