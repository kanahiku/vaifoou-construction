---
/**
 * Stamped & Decorative Concrete — /services/concrete/stamped-decorative/
 * Content: docs/service/concrete-service/…Stamped & Decorative Concrete.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Stamped & Decorative Concrete | ${site.name}`,
  description: `Elevate your property with decorative concrete finishes. Vaifoou Construction handles stamped and custom concrete across O\u02BBahu.`,
};

const tableRows = [
  { feature: 'Aesthetic',   val1: 'Patterns and custom textures',        val2: 'Plain broom surface' },
  { feature: 'Cost',        val1: 'Higher — custom finish work',          val2: 'Lower — standard finish' },
  { feature: 'Best For',    val1: 'High-visibility driveways and patios', val2: 'Sidewalks and functional utility areas' },
];

const links = [
  { title: 'Concrete Driveways',         href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways',       href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios',            href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways', href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations',       href: '/services/concrete/foundations/' },
  { title: 'Stem Walls',                 href: '/services/concrete/stem-walls/' },
  { title: 'Concrete Sealing',           href: '/services/concrete/sealing/' },
];

const faqs = [
  { title: 'What surfaces can you apply decorative concrete finishes to?', description: 'We apply decorative and stamped finishes to driveways, patios, walkways, and steps.' },
  { title: 'Is stamped concrete more expensive than standard broom finish?', description: 'Yes. Decorative finishes require additional labour and materials, so the cost is higher than a standard broom finish.' },
  { title: 'Are your installations guaranteed?',                            description: 'Yes. Every site we manage across O\u02BBahu is backed by a workmanship guarantee.' },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    eyebrow="Concrete Services"
    title="Stamped & Decorative Concrete"
    body="We install custom stamped and decorative concrete finishes to elevate the aesthetic of your driveways, patios, and walkways across O\u02BBahu. Our family brings a 25+ year trade legacy to every project site. Every installation is backed by our workmanship guarantee."
    imagePlaceholder="Stamped and decorative concrete photo"
  />
  <ServiceTable
    eyebrow="Comparison"
    heading="Decorative vs. Standard Broom Finish"
    col1="Stamped & Decorative Finish"
    col2="Standard Broom Finish"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Concrete Services" items={links} />
  <FAQs title="Stamped & Decorative Concrete FAQs" tagline="Common Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Start Your Decorative Concrete Project" />
</Layout>
