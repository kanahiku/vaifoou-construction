---
/**
 * Stem Walls — /services/concrete/stem-walls/
 * Content: docs/service/concrete-service/…Stem Walls.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceDetailSection from '~/components/widgets/ServiceDetailSection.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Stem Walls | ${site.name}`,
  description: `Vaifoou Construction pours structural concrete stem walls for residential and commercial projects across O'ahu. Contact us for a site estimate.`,
};

const processSteps = [
  {
    title: 'Site Evaluation and Trenching',
    description:
      'We assess lot elevation and dig a trench along the building footprint to house the foundational footing.',
  },
  {
    title: 'Footing Installation',
    description:
      'We pour a continuous concrete footing inside the trench. This wide base spreads the heavy weight of the structure evenly across the ground.',
  },
  {
    title: 'Forming and Reinforcement',
    description:
      'Our crews build vertical wooden forms on top of the cured footing. We secure structural steel reinforcement inside the forms to bind the wall directly to the base.',
  },
  {
    title: 'Concrete Pouring',
    description:
      'We pour ready-mix concrete directly into the vertical forms. We consolidate the wet mixture to eliminate air pockets and ensure a dense structural wall.',
  },
  {
    title: 'Curing and Form Removal',
    description:
      'The concrete cures to achieve proper strength. We dismantle the wooden forms to expose the finished wall and verify anchor placements for framing.',
  },
];

const structuralElements = [
  {
    title: 'Heavy-Duty Concrete',
    description:
      'We use structural-grade ready-mix concrete formulated to handle the compressive weight of your entire house.',
    icon: 'tabler:box-seam',
  },
  {
    title: 'Structural Reinforcement',
    description:
      'We install metal reinforcement within the wooden forms to provide the tensile strength needed against soil pressure.',
    icon: 'tabler:box-seam',
  },
  {
    title: 'Moisture Protection',
    description: 'Elevating the base structure above ground level provides moisture control.',
    icon: 'tabler:wall',
  },
  {
    title: 'Anchor Systems',
    description:
      'We embed anchor bolts into the top of the wet concrete wall to provide a rigid attachment point for your floor joists.',
    icon: 'tabler:corner-up-right',
  },
];

const tableRows = [
  { feature: 'Primary Function', val1: 'Transfers the load of the house to the foundation' },
  { feature: 'Site Application', val1: 'Ideal for lots with slopes or uneven elevation' },
  { feature: 'Moisture Control', val1: 'Elevates the base structure above ground level' },
];

const applications = [
  {
    title: 'Sloped Lots',
    description:
      'We build vertical supports to create a completely level platform for framing on uneven hillside terrain.',
    icon: 'tabler:mountain',
  },
  {
    title: 'Flood Zone Elevation',
    description: 'We construct stem walls to lift the ground floor of a new home safely above required flood lines.',
    icon: 'tabler:droplets',
  },
  {
    title: 'Utility Access',
    description:
      'We use this structural base to elevate the floor joists, providing necessary crawlspace access for sub-floor plumbing and electrical routing.',
    icon: 'tabler:trowel',
  },
];

const links = [
  { title: 'Concrete Driveways', href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways', href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios', href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways', href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations', href: '/services/concrete/foundations/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
  { title: 'Concrete Sealing', href: '/services/concrete/sealing/' },
];

const faqs = [
  {
    title: 'What is the purpose of a stem wall?',
    description:
      'It is the structural base that connects your foundation pad to the vertical walls of the building, often used to manage uneven lot elevations. It elevates your living space above the dirt and provides a completely level platform for framing.',
  },
  {
    title: 'Do you offer this as a standalone service?',
    description:
      'Yes. We maintain stem walls as a dedicated service separate from standard slab foundations to meet specific structural requirements. We can build these specific structures even if we are not pouring a traditional flat monolithic slab for the main floor.',
  },
  {
    title: 'Are your installations guaranteed?',
    description:
      "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee. We stand strictly by our forming and pouring procedures.",
  },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Stem Walls"
    body="We pour concrete stem walls for residential and commercial projects across O'ahu. These structures connect your foundation directly to your building's framing, creating a perfectly level base on sloped terrain. Every installation is backed by our family's 25+ year trade legacy and workmanship guarantee."
  />
  <ServiceDetailSection heading="Our Stem Wall Construction Process" items={processSteps} variant="timeline" />
  <ServiceDetailSection heading="Materials and Structural Elements" items={structuralElements} surface="card" />
  <ServiceTable heading="Stem Wall Support Structure" col1="Role of a Stem Wall" rows={tableRows} />
  <ServiceDetailSection heading="Applications" items={applications} animateItems={false} />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs} animate={false}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA
    heading="Request a Site Consultation"
    note="Our team is strictly closed on Sundays to put God first. Contact us to schedule your site visit."
  />
</Layout>
