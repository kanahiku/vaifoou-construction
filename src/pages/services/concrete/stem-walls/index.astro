---
/**
 * Stem Walls — /services/concrete/stem-walls/
 * Content: docs/service/concrete-service/…Stem Walls.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Stem Walls | ${site.name}`,
  description: `Vaifoou Construction builds concrete stem walls for residential and commercial structures across O'ahu. Contact us for a site estimate.`,
};

const tableRows = [
  { feature: 'Primary Function', val1: 'Transfers the load of the house to the foundation' },
  { feature: 'Site Application', val1: 'Ideal for lots with slopes or uneven elevation' },
  { feature: 'Moisture Control', val1: 'Elevates the base structure above ground level' },
];

const links = [
  { title: 'Concrete Driveways',           href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways',         href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios',              href: '/services/concrete/patios/' },
  { title: 'Concrete Steps & Stairways',   href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations',         href: '/services/concrete/foundations/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
  { title: 'Concrete Sealing',             href: '/services/concrete/sealing/' },
];

const faqs = [
  { title: 'What is the purpose of a stem wall?',           description: 'It is the structural base that connects your foundation pad to the vertical walls of the building, often used to manage uneven lot elevations.' },
  { title: 'Do you offer this as a standalone service?',    description: 'Yes. We maintain stem walls as a dedicated service separate from standard slab foundations to meet specific structural requirements.' },
  { title: 'Are your installations guaranteed?',             description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Stem Walls"
    body="We construct concrete stem walls for residential and commercial buildings across O'ahu. A stem wall is the short concrete wall that runs between your foundation footing and the frame of the structure above. Our family brings a 25+ year trade legacy to every project site. Every installation is backed by our workmanship guarantee."
  />
  <ServiceTable
    heading="Stem Wall Support Structure"
    col1="Role of a Stem Wall"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Request a Site Consultation" />
</Layout>
