---
/**
 * Concrete Patios — /services/concrete/patios/
 * Content: docs/service/concrete-service/…Concrete Patios.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceDetailSection from '~/components/widgets/ServiceDetailSection.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Concrete Patios & Lanai Extensions | ${site.name}`,
  description: `Vaifoou Construction pours custom concrete patios and lanai extensions for properties across O'ahu. Contact us to schedule a site estimate.`,
};

const processSteps = [
  {
    title: 'Site Consultation',
    description:
      'We assess your backyard space to determine the exact footprint for your new outdoor living area. This visit ensures we plan for proper drainage away from your home.',
  },
  {
    title: 'Excavation and Prep',
    description:
      'Our crews dig out grass and topsoil to reach a stable base layer. We haul the excavated dirt away to keep the property clean before pouring.',
  },
  {
    title: 'Sub-Base Compaction',
    description:
      'We compact base aggregate tightly to create a solid foundation. We establish a slight slope so heavy rain flows safely into the yard rather than pooling against your house.',
  },
  {
    title: 'Forming and Pouring',
    description:
      'We stake rigid wooden forms along the perimeter. Our team pours ready-mix concrete continuously and levels the wet surface for a flat seating area.',
  },
  {
    title: 'Finishing and Curing',
    description:
      'We apply the chosen surface texture and cut necessary control joints. The slab cures fully before we remove the forms.',
  },
];

const materials = [
  {
    title: 'Surface Traction',
    description: 'We apply a standard broom finish to provide solid foot grip for traditional patios.',
    icon: 'tabler:trowel',
  },
  {
    title: 'Moisture Control',
    description:
      'We tool straight control joints into the wet concrete. These deliberate grooves guide natural expansion to prevent random surface cracking.',
    icon: 'tabler:droplets',
  },
  {
    title: 'Decorative Upgrades',
    description: 'We can apply stamped patterns to replicate natural stone for premium outdoor living spaces.',
    icon: 'tabler:trowel',
  },
  {
    title: 'Water Management',
    description:
      'We grade the sub-base to direct water correctly, preventing heavy rain from flooding your attached lanai.',
    icon: 'tabler:droplets',
  },
];

const tableRows = [
  {
    feature: 'Application',
    val1: 'Independent outdoor seating space',
    val2: 'Expanding existing covered living areas',
  },
  { feature: 'Location', val1: 'Open backyard or garden', val2: 'Attached directly to the home structure' },
  {
    feature: 'Finish Options',
    val1: 'Standard broom finish or decorative',
    val2: 'Custom matched to existing property style',
  },
];

const applications = [
  {
    title: 'Backyard Seating',
    description:
      'We pour independent concrete pads in open backyards or gardens to create durable outdoor seating spaces.',
    icon: 'tabler:home',
  },
  {
    title: 'Lanai Extensions',
    description:
      'We pour structural slabs attached directly to the home to expand your existing covered living footprint.',
    icon: 'tabler:home',
  },
  {
    title: 'Recreational Decks',
    description:
      'We install flatwork around residential properties with proper traction finishes to create safe, usable lounge areas.',
    icon: 'tabler:home',
  },
];

const links = [
  { title: 'Concrete Driveways', href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways', href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Steps & Stairways', href: '/services/concrete/steps/' },
  { title: 'Concrete Foundations', href: '/services/concrete/foundations/' },
  { title: 'Stem Walls', href: '/services/concrete/stem-walls/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
  { title: 'Concrete Sealing', href: '/services/concrete/sealing/' },
];

const faqs = [
  {
    title: 'Do you pour concrete for lanai extensions?',
    description:
      'Yes. We regularly pour concrete for lanai extensions to expand your existing living footprint. We ensure the new slab ties cleanly into your existing home foundation for a seamless transition.',
  },
  {
    title: 'What concrete do you use for patios and lanai extensions?',
    description: 'We source fresh ready-mix concrete from local suppliers to easily handle heavy outdoor furniture.',
  },
  {
    title: 'Are your installations guaranteed?',
    description:
      "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee. We stand behind our complete patio installation process.",
  },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Concrete Patios"
    body="We pour concrete patios to expand your usable outdoor living space. Our crews handle everything from standard backyard patios to structural lanai extensions. We bring our family's 25+ year trade legacy to every project across O'ahu. Every installation is backed by our workmanship guarantee."
  />
  <ServiceDetailSection heading="Our Patio Installation Process" items={processSteps} variant="timeline" />
  <ServiceDetailSection heading="Materials and Finishing Options" items={materials} surface="card" />
  <ServiceTable
    heading="Standard Patios vs. Lanai Extensions"
    col1="Standard Concrete Patio"
    col2="Lanai Extension"
    rows={tableRows}
  />
  <ServiceDetailSection heading="Applications" items={applications} animateItems={false} />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs} animate={false}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA
    heading="Request a Site Consultation"
    note="We bring our family’s 25+ year trade legacy to every project site. Contact us to schedule an estimate."
  />
</Layout>
