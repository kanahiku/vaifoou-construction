---
/**
 * Concrete Steps & Stairways — /services/concrete/steps/
 * Content: docs/service/concrete-service/…Concrete Steps & Stairways.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceDetailSection from '~/components/widgets/ServiceDetailSection.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Concrete Steps & Stairways | ${site.name}`,
  description: `Vaifoou Construction pours durable concrete steps and custom stairways for properties across O'ahu. Contact us to schedule a site estimate.`,
};

const processSteps = [
  {
    title: 'Site Consultation and Measurement',
    description:
      'We evaluate your property to map out the exact elevation changes. This allows us to calculate the precise rise and run required to build safe and comfortable steps.',
  },
  {
    title: 'Excavation and Grading',
    description:
      'Our crews dig out the hillside or remove your existing damaged stairs. We compact the exposed dirt to create a highly stable base for the heavy concrete structure.',
  },
  {
    title: 'Forming and Pouring',
    description:
      'We build rigid wooden forms to shape each individual riser and tread. We pour the ready-mix concrete continuously from the bottom up to ensure complete structural integrity.',
  },
  {
    title: 'Finishing and Curing',
    description:
      'We apply a traction finish to the wet treads. The concrete cures fully inside the wooden forms before we dismantle them and clear the job site.',
  },
];

const materials = [
  {
    title: 'Surface Traction',
    description:
      'We apply a heavy broom finish to all stair treads. This creates deep ridges that provide essential foot grip during wet island weather.',
    icon: 'tabler:trowel',
  },
  {
    title: 'Structural Reinforcement',
    description:
      'We install metal reinforcement within the wooden forms before pouring. This strengthens the concrete to handle constant pedestrian weight.',
    icon: 'tabler:box-seam',
  },
  {
    title: 'Custom Dimensions',
    description:
      'We build treads and risers to fit your specific property elevation perfectly. This provides a much safer alternative to generic pre-cast steps.',
    icon: 'tabler:ruler-measure',
  },
];

const tableRows = [
  { feature: 'Application', val1: 'Simple entryways or porches', val2: 'Significant property elevation changes' },
  { feature: 'Design', val1: 'Basic functional treads', val2: 'Custom dimensions and landings' },
  { feature: 'Proof of Work', val1: 'Available upon request', val2: 'Viewable in our project gallery' },
];

const applications = [
  {
    title: 'Entryway Porches',
    description: 'We build functional steps to safely connect your front door to the main walkway.',
    icon: 'tabler:home',
  },
  {
    title: 'Hillside Access',
    description:
      'We construct extended stairways with custom landings to navigate steep slopes and significant property elevation changes.',
    icon: 'tabler:stairs',
  },
  {
    title: 'Commercial Transitions',
    description: 'We pour heavy-duty concrete stairs engineered for high-traffic commercial environments.',
    icon: 'tabler:building',
  },
];

const links = [
  { title: 'Concrete Driveways', href: '/services/concrete/driveways/' },
  { title: 'Sidewalks & Walkways', href: '/services/concrete/sidewalks/' },
  { title: 'Concrete Patios', href: '/services/concrete/patios/' },
  { title: 'Concrete Foundations', href: '/services/concrete/foundations/' },
  { title: 'Stem Walls', href: '/services/concrete/stem-walls/' },
  { title: 'Stamped & Decorative Concrete', href: '/services/concrete/stamped-decorative/' },
  { title: 'Concrete Sealing', href: '/services/concrete/sealing/' },
];

const faqs = [
  {
    title: 'Do you build custom stairways?',
    description:
      'Yes. We pour standard steps and construct custom stairways to fit your specific property elevation. We measure the exact slope to calculate the safest step height for your layout.',
  },
  {
    title: 'Can I see examples of your previous stairway work?',
    description:
      "Yes. Stairways are a dedicated category in our project gallery where you can review our previous installations. This allows you to see real results from our local O'ahu sites.",
  },
  {
    title: 'Are your installations guaranteed?',
    description:
      "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee. We stand strictly by our forming, pouring, and finishing processes.",
  },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Concrete Steps & Stairways"
    body="We pour concrete steps and construct custom stairways to safely manage elevation changes on your property. We build for both residential and commercial applications across O'ahu. A stable set of stairs prevents tripping hazards on uneven terrain. Our family brings a 25+ year trade legacy to every project site, and every installation is backed by our workmanship guarantee."
  />
  <ServiceDetailSection heading="Our Stairway Installation Process" items={processSteps} variant="timeline" />
  <ServiceDetailSection heading="Materials and Finishing Options" items={materials} surface="card" />
  <ServiceTable
    heading="Standard Steps vs. Custom Stairways"
    col1="Standard Concrete Steps"
    col2="Custom Stairways"
    rows={tableRows}
  />
  <ServiceDetailSection heading="Applications" items={applications} animateItems={false} />
  <ServiceLinks categoryLabel="Concrete Services" items={links} maxItems={links.length} />
  <FAQs title="Frequently Asked Questions" items={faqs} animate={false}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA
    heading="Request a Site Consultation"
    note="We bring our family’s 25+ year trade legacy to every project site. Contact us to schedule an estimate."
  />
</Layout>
