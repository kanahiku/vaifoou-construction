---
/**
 * Veneer Rock Walls — /services/rock-walls/veneer/
 * Content: docs/service/roxk-wall/…Veneer Rock Walls.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';
import { photos } from '~/data/photos';

const metadata = {
  title: `Veneer Rock Walls | ${site.name}`,
  description: `Maximize your property space with veneer rock walls. We install palletized rock veneer with flat corners across O'ahu.`,
};

const tableRows = [
  { feature: 'Property Space',    val1: 'Saves roughly two feet of space',    val2: 'Requires full structural footprint' },
  { feature: 'Material Handling', val1: 'Lighter and arrives palletized',      val2: 'Traditional heavy delivery' },
  { feature: 'Corner Finish',     val1: 'Flat corners available',              val2: 'Standard masonry corners' },
];

const links = [
  { title: 'Rock Wall Repair',            href: '/services/rock-walls/repair/' },
  { title: 'Rock Retaining Walls',        href: '/services/rock-walls/retaining/' },
  { title: 'Planter & Garden Rock Walls', href: '/services/rock-walls/planter-garden/' },
];

const faqs = [
  { title: 'How much space does a veneer wall save?',    description: 'Building with veneer saves roughly two feet of property space compared with standard block construction.' },
  { title: 'What materials do you use?',                 description: 'We build with hand-selected volcanic basalt. The veneer material is lighter to carry and arrives palletized.' },
  { title: 'Are your installations guaranteed?',         description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Veneer Rock Walls"
    body="We build veneer rock walls for residential and commercial properties across O'ahu. This application offers a distinct space-saving advantage for tight property lines. The material arrives palletized for highly efficient site handling and is lighter to carry. We utilize available flat corners to deliver a seamless finish. Every installation is backed by our workmanship guarantee."
    image={photos.veneer.src}
    imageAlt={photos.veneer.alt}
  />
  <ServiceTable
    eyebrow="Comparison"
    heading="Veneer vs. Standard Construction"
    col1="Veneer Rock Wall"
    col2="Standard Block Construction"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Rock Wall Services" items={links} />
  <FAQs title="Veneer Rock Wall FAQs" tagline="Common Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Request a Site Consultation" />
</Layout>
