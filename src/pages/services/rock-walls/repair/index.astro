---
/**
 * Rock Wall Repair — /services/rock-walls/repair/
 * Content: docs/service/roxk-wall/…Rock Wall Repair.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import ServiceTable from '~/components/widgets/ServiceTable.astro';
import ServiceLinks from '~/components/widgets/ServiceLinks.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { site } from '~/config/site';

const metadata = {
  title: `Rock Wall Repair & Rebuilds | ${site.name}`,
  description: `Vaifoou Construction handles the demolition and complete reconstruction of compromised or collapsed rock walls on O'ahu.`,
};

const tableRows = [
  { feature: 'Safety',    val1: 'Removes the failed structure entirely',      val2: 'Underlying failure remains' },
  { feature: 'Process',   val1: 'Complete demolition and reconstruction',      val2: 'Mortar added to existing cracks' },
  { feature: 'Longevity', val1: 'Long-term stability',                         val2: 'Temporary aesthetic fix' },
];

const links = [
  { title: 'Veneer Rock Walls',           href: '/services/rock-walls/veneer/' },
  { title: 'Rock Retaining Walls',        href: '/services/rock-walls/retaining/' },
  { title: 'Planter & Garden Rock Walls', href: '/services/rock-walls/planter-garden/' },
];

const faqs = [
  { title: 'Do you patch cracks or rebuild the wall?',  description: 'We focus on complete demolition and structural rebuilds for failing or collapsed walls to ensure long-term safety and stability.' },
  { title: 'What materials do you use for rebuilds?',   description: 'We construct the replacement structure using hand-selected volcanic basalt.' },
  { title: 'Are your installations guaranteed?',        description: "Yes. Every site we manage across O'ahu is backed by a workmanship guarantee." },
];
---

<Layout metadata={metadata}>
  <SubServiceHero
    title="Rock Wall Repair"
    body="We manage rock wall repair and structural rebuilds for residential and commercial properties across O'ahu. When a barrier fails, our crews handle the complete demolition of the compromised masonry. We then execute a ground-up reconstruction to replace bulging or collapsed structures using hand-selected volcanic basalt."
  />
  <ServiceTable
    eyebrow="Comparison"
    heading="Structural Rebuilds vs. Surface Patching"
    col1="Full Structural Rebuild"
    col2="Surface Patching"
    rows={tableRows}
  />
  <ServiceLinks categoryLabel="Rock Wall Services" items={links} />
  <FAQs title="Rock Wall Repair FAQs" tagline="Common Questions" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>
  <BrickMotifCTA heading="Request a Site Consultation" />
</Layout>
