---
/**
 * Rock Walls service page — /services/rock-walls/
 * Content: docs/service/Vaifoou Construction Service Pages - Rock Walls.docx
 */
import Layout from '~/layouts/PageLayout.astro';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import FillImage from '~/components/ui/FillImage.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';
import { getServiceCategoryPageMedia } from '~/lib/content';

const metadata = {
  title: "O'ahu Rock Wall Construction | Vaifoou Construction",
  description:
    "Custom rock walls and retaining structures built with hand-selected volcanic basalt. Serving homes and businesses across O'ahu. Request an estimate.",
  ignoreTitleTemplate: true,
};

const subServices = [
  {
    title: 'Veneer Rock Walls',
    href: '/services/rock-walls/veneer/',
    description: 'Space-saving palletised stone featuring flat corners and a clean finish.',
  },
  {
    title: 'Rock Wall Repair',
    href: '/services/rock-walls/repair/',
    description: 'Demolition and rebuilds of failing, bulging or collapsed rock walls.',
  },
  {
    title: 'Rock Retaining Walls',
    href: '/services/rock-walls/retaining/',
    description: 'Hillside retaining walls built with natural volcanic stone.',
  },
  {
    title: 'Planter & Garden Rock Walls',
    href: '/services/rock-walls/planter-garden/',
    description: 'Custom masonry borders for residential property layouts.',
  },
];

const steps = [
  { n: '01', title: 'Consultation', body: 'We review your property and define the exact project requirements.' },
  {
    n: '02',
    title: 'Excavation',
    body: 'Our team prepares the site and hillside foundation for structural stability.',
  },
  { n: '03', title: 'Construction', body: 'We hand-select volcanic basalt and set each stone in place.' },
  { n: '04', title: 'Finishing', body: 'The team details the final build for a clean presentation.' },
];

const faqs = [
  {
    title: 'What materials do you use for custom walls?',
    description:
      'We construct our rock walls using hand-selected volcanic basalt. This dense natural stone makes a heavy, durable wall with a classic local finish.',
  },
  {
    title: 'Do you repair existing rock walls?',
    description:
      'Yes, we handle complete demolition and reconstruction of failing structures. Our crews remove the failed section and rebuild the wall. See Rock Wall Repair.',
  },
  {
    title: 'What is a veneer rock wall?',
    description:
      'Veneer rock walls arrive on pallets and feature flat corners. The material is lighter to carry, and compared with standard block, it can save roughly two feet of property space.',
  },
  {
    title: 'Do you handle the landscaping around the new wall?',
    description:
      'We focus exclusively on masonry and concrete construction. We do not provide landscape design or general landscaping services.',
  },
  {
    title: "Do you build walls outside of O'ahu?",
    description: "No, our service area is strictly limited to the island of O'ahu.",
  },
];

const related = [
  { title: 'Retaining Walls', href: '/services/retaining-walls/' },
  { title: 'CMU & Block Walls', href: '/services/cmu-block-walls/' },
  { title: 'Concrete Services', href: '/services/concrete/' },
];

const serviceMedia = await getServiceCategoryPageMedia('/services/rock-walls/');
const heroPhoto = serviceMedia?.heroImage;
const introPhoto = serviceMedia?.introImage;
const projectPhoto = serviceMedia?.projectImage;
---

<Layout metadata={metadata}>
  {/* ── HERO ─────────────────────────────────────────────────── */}
  <section class="relative w-full overflow-hidden border-b border-banner-line min-h-[400px] md:min-h-[500px]">
    <FillImage src={heroPhoto?.src} alt={heroPhoto?.alt} eager width={1600} height={640} quality={72} />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgb(28 27 26 / 90%) 0%, rgb(28 27 26 / 72%) 55%, rgb(28 27 26 / 30%) 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="site-frame relative z-10 flex flex-col items-start gap-4 pb-16 pt-16 md:pb-24 md:pt-24">
      <h1
        class="max-w-[896px] font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[72px] md:tracking-[-0.8px]"
      >
        O'ahu Rock Wall Construction
      </h1>
      <p
        class="max-w-[640px] font-display text-[16px] font-semibold leading-snug tracking-[0.2px] text-page/80 md:text-[22px] md:leading-[32px]"
      >
        Custom property boundaries and retaining structures built with hand-selected volcanic basalt.
      </p>
      <div class="flex w-full flex-col items-stretch gap-4 pb-8 pt-2 sm:w-auto sm:flex-row sm:items-center md:pb-12 md:pt-6">
        <a
          href={PRIMARY_CTA_HREF}
          class="inline-flex w-full items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading sm:w-auto md:text-[20px]"
          >{PRIMARY_CTA_LABEL}</a
        >
        <a
          href={CONTACT.phone.href}
          class="inline-flex w-full items-center justify-center gap-2 border border-muted/30 bg-banner-text px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading sm:w-auto md:text-[20px]"
          ><PhoneIcon />Call {CONTACT.phone.display}</a
        >
      </div>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-muted/30 pt-6">
        {
          [CONTACT.license, 'Licensed & Insured', "Serving All of O'ahu"].map((item, i) => (
            <>
              {i > 0 && (
                <span
                  class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-banner-dot uppercase"
                  aria-hidden="true"
                >
                  •
                </span>
              )}
              <span class="font-display text-[13px] font-bold leading-4 tracking-[0.65px] text-page/80 uppercase">
                {item}
              </span>
            </>
          ))
        }
      </p>
    </div>
  </section>

  {/* ── INTRO ─────────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:flex-row md:items-center md:gap-16">
      {/* Left — text */}
      <div class="flex flex-1 flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          Built Strong For Hawaii&rsquo;s Land
        </h2>
        <p
          class="mt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:mt-4 md:text-[18px] md:leading-[29.25px]"
        >
          Our masonry crews construct custom property boundaries and rock retaining walls using hand-selected volcanic
          basalt. A well-built rock wall gives you a lasting property boundary and holds back soil on hillside terrain.
          Every build is backed by a 25+ year family legacy in the O'ahu masonry trade and comes with our workmanship
          guarantee.
        </p>
      </div>
      {/* Right — image */}
      <div class="relative w-full shrink-0 overflow-hidden md:w-[440px]" style="aspect-ratio: 4/3;">
        <FillImage
          src={introPhoto?.src}
          alt={introPhoto?.alt}
          width={700}
          height={525}
          widths={[320, 480, 700]}
          sizes="(max-width: 768px) 100vw, 440px"
          quality={68}
        />
      </div>
    </div>
  </section>

  {/* ── SUB-SERVICES ─────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          Custom Rock Wall Services
        </h2>
      </div>
      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 md:gap-8">
        {
          subServices.map(({ title, href, description }) => (
            <a
              href={href}
              class="group flex h-full flex-col border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-8"
            >
              <h3 class="font-display text-[20px] font-semibold leading-6 tracking-[0.2px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[22px]">
                {title}
              </h3>
              <p class="mt-3 flex-1 font-body text-[15px] font-normal leading-6 text-banner-note">{description}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 font-display text-[13px] font-bold leading-4 tracking-[0.5px] text-nav-cta uppercase">
                View {title}
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  class="shrink-0 transition-transform group-hover:translate-x-0.5"
                >
                  <path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="currentColor" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
      {/* Project photo + View Projects */}
      <div
        class="flex flex-col gap-0 border border-banner-line bg-page overflow-hidden md:flex-row md:items-stretch min-h-[320px] md:min-h-[400px]"
      >
        {/* Left — image (50%) */}
        <div class="relative w-full md:w-1/2" style="aspect-ratio: 4/3;">
          <FillImage
            src={projectPhoto?.src}
            alt={projectPhoto?.alt}
            width={800}
            height={600}
            widths={[320, 480, 700, 900]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={68}
          />
        </div>
        {/* Right — text + CTA (50%) */}
        <div class="flex w-full flex-col justify-center gap-5 p-8 md:w-1/2 md:p-12">
          <h3 class="font-display text-[24px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[32px]">
            View Our Projects
          </h3>
          <p class="font-body text-[16px] font-normal leading-7 text-banner-note md:text-[17px]">
            Explore our recent work and see the quality, care, and craftsmanship we bring to every project. From start
            to finish, our team is committed to dependable service, careful attention to detail, and results built to
            last.
          </p>
          <a
            href="/projects/"
            class="self-start inline-flex items-center bg-nav-cta px-6 py-3 font-display text-[13px] font-bold leading-4 tracking-[1px] text-page-end uppercase transition-colors hover:bg-heading"
          >
            View Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── PROCESS ──────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-10 md:gap-14">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
        >
          The Construction Process
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-4 md:gap-8">
        {
          steps.map(({ n, title, body }) => (
            <div class="flex flex-col gap-3 border-l-2 border-nav-cta pl-5">
              <span class="font-display text-[32px] font-bold leading-none tracking-[-0.5px] text-nav-cta/30">{n}</span>
              <h3 class="font-display text-[18px] font-bold leading-5 tracking-[0.3px] text-heading uppercase">
                {title}
              </h3>
              <p class="font-body text-[14px] font-normal leading-6 text-banner-note">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── FAQs ─────────────────────────────────────────────────── */}
  <FAQs title="Rock Wall Construction FAQs" items={faqs}>
    <div slot="bg" class="absolute inset-0 bg-card"></div>
  </FAQs>

  {/* ── RELATED SERVICES ─────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-20">
    <div class="site-frame flex flex-col gap-8">
      <h2
        class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]"
      >
        Explore Related Masonry Services
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
        {
          related.map(({ title, href }) => (
            <a
              href={href}
              class="group flex items-center justify-between border border-banner-line bg-card px-6 py-5 font-display text-[16px] font-semibold leading-5 tracking-[0.5px] text-heading uppercase transition-colors hover:border-nav-cta hover:bg-section-grey/40 hover:text-nav-cta focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:text-[18px]"
            >
              {title}
              <svg
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="shrink-0 transition-transform group-hover:translate-x-0.5"
              >
                <path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="currentColor" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── CTA BANNER ───────────────────────────────────────────── */}
  <BrickMotifCTA
    heading="Start Your O'ahu Rock Wall Project"
    note="Connect with our team to discuss your rock wall requirements. Please note we are closed on Sundays."
    phoneLabel={`Call ${CONTACT.phone.display}`}
  />
</Layout>
