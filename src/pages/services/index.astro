---
/**
 * Services hub page — /services/
 * All text and images come from the Sanity `servicesHubPage` singleton (see getServicesHub()).
 * Design: matches homepage section patterns (H2 · body · cards · CTA banner)
 */
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import SanityImage from '~/components/common/Image.astro';
import ComparisonTable from '~/components/ui/ComparisonTable.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import iconRockWall from '~/assets/icons/rock-wall.svg';
import iconRetainingWall from '~/assets/icons/retaining-wall.svg';
import iconWalls from '~/assets/icons/walls.svg';
import iconHammer from '~/assets/icons/hammer.svg';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';
import { getServicesHub } from '~/lib/content';

const page = await getServicesHub();
if (!page) throw new Error('Sanity servicesHubPage document missing (singleton-services-hub). Run `npm run seed:services`.');

const { hero, intro, capabilities, scope, cta } = page;
const metadata = { title: page.seo.title, description: page.seo.description, ignoreTitleTemplate: true };

/* Capability card icons — local SVGs, selected per card in Sanity */
const serviceIcons: Record<string, ImageMetadata> = {
  'rock-wall': iconRockWall,
  'retaining-wall': iconRetainingWall,
  walls: iconWalls,
  hammer: iconHammer,
};

const heroImage = hero.image;
const servicesImageAlt = "Vaifoou Construction masonry and concrete services on O'ahu";
---

<Layout metadata={metadata}>
  {
    /* ═══════════════════════════════════════════════════════════
      SECTION 1 — PAGE HERO
      Dark bg · H1 · subtitle · 2 CTAs
  ════════════════════════════════════════════════════════════ */
  }
  <section class="relative w-full overflow-hidden border-b border-banner-line min-h-[400px] md:min-h-[500px]">
    {
      heroImage?.src ? (
        <SanityImage
          src={heroImage.src}
          alt={heroImage.alt || servicesImageAlt}
          class="absolute inset-0 h-full w-full max-w-none object-cover"
          widths={[640, 960, 1200, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          width={1600}
          height={640}
          layout="cover"
          format="webp"
          quality={72}
        />
      ) : (
        <HeroImagePlaceholder fill hideLabel class="absolute inset-0" label="Services hero image placeholder" />
      )
    }

    {/* Gradient overlay */}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgb(28 27 26 / 90%) 0%, rgb(28 27 26 / 72%) 55%, rgb(28 27 26 / 30%) 100%);"
      aria-hidden="true"
    >
    </div>

    {/* Content */}
    <div class="site-frame relative z-10 flex flex-col items-start gap-4 pb-16 pt-16 md:pb-24 md:pt-24">
      <h1
        class="max-w-[896px] font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[72px] md:tracking-[-0.8px]"
      >
        {hero.heading}
      </h1>

      <p
        class="max-w-[640px] font-display text-[16px] font-semibold leading-snug tracking-[0.2px] text-page/80 md:text-[24px] md:leading-[34px] md:tracking-[0.24px]"
      >
        {hero.subheading}
      </p>

      <div
        class="flex w-full flex-col items-stretch gap-4 pb-8 pt-2 sm:w-auto sm:flex-row sm:items-center md:pb-12 md:pt-6"
      >
        <a
          href={PRIMARY_CTA_HREF}
          class="inline-flex w-full items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading sm:w-auto md:text-[20px]"
        >
          {PRIMARY_CTA_LABEL}
        </a>
        <a
          href={CONTACT.phone.href}
          class="inline-flex w-full items-center justify-center gap-2 border border-muted/30 bg-banner-text px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading sm:w-auto md:text-[20px]"
        >
          <PhoneIcon />
          Call {CONTACT.phone.display}
        </a>
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════
      SECTION 2 — AUDIENCE PATHWAYS
      bg-page · H2 · body · 2 audience cards
  ════════════════════════════════════════════════════════════ */
  }
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]"
        >
          {intro.heading}
        </h2>
        <p
          class="max-w-[896px] pt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]"
        >
          {intro.body}
        </p>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-10">
        {
          intro.audienceCards.map(({ title, ctaLabel, href, label, image }) => (
            <article class="flex h-full flex-col overflow-hidden border border-banner-line bg-card">
              <div class="relative h-48 w-full shrink-0 md:h-[240px]">
                {image?.src ? (
                  <SanityImage
                    src={image.src}
                    alt={image.alt || `${label} masonry and concrete services by Vaifoou Construction`}
                    class="absolute inset-0 h-full w-full max-w-none object-cover"
                    widths={[480, 640, 828, 960, 1200]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    width={900}
                    height={370}
                    layout="cover"
                    format="webp"
                    quality={82}
                  />
                ) : (
                  <HeroImagePlaceholder fill class="absolute inset-0" label={`${label} image placeholder`} />
                )}
              </div>
              <div class="flex flex-1 flex-col p-6 md:p-10">
                <h3 class="font-display text-[22px] font-semibold leading-7 tracking-[0.22px] text-heading uppercase md:text-[26px] md:leading-8">
                  {title}
                </h3>
                <div class="mt-auto pt-8">
                  <a
                    href={href}
                    class="cta-md inline-flex w-fit items-center justify-center bg-nav-cta text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase transition-colors hover:bg-heading md:text-[18px]"
                  >
                    {ctaLabel}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════
      SECTION 3 — CORE CAPABILITIES
      bg-card · 2×2 clickable service card grid
  ════════════════════════════════════════════════════════════ */
  }
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]"
        >
          {capabilities.heading}
        </h2>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 md:gap-8">
        {
          capabilities.items.map(({ icon, title, href, description }) => (
            <a
              href={href}
              class="group flex h-full flex-col border border-banner-line bg-white p-6 transition-colors hover:border-nav-cta hover:bg-section-grey/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-nav-cta md:p-10"
            >
              <div class="flex flex-col gap-3 flex-1">
                {/* Icon inline with title */}
                <h3 class="flex items-center gap-2.5 font-display text-[22px] font-semibold leading-none tracking-[0.22px] text-heading uppercase transition-colors group-hover:text-nav-cta md:text-[26px]">
                  <span class="flex size-5 shrink-0 items-center justify-center" aria-hidden="true">
                    <Image src={serviceIcons[icon] ?? iconRockWall} alt="" width={20} height={20} class="h-5 w-5 object-contain" />
                  </span>
                  {title}
                </h3>
                <p class="font-body text-[16px] font-normal leading-6 text-banner-note">{description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════
      SECTION 4 — SERVICE SCOPE TABLE
      bg-page · "What We Build" vs "What We Do Not Cover"
  ════════════════════════════════════════════════════════════ */
  }
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-8 md:gap-12">
      <div class="flex max-w-[896px] flex-col gap-1">
        <h2
          class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[40px] md:leading-[48px] md:tracking-[-0.2px]"
        >
          {scope.heading}
        </h2>
      </div>

      <ComparisonTable
        featureLabel={scope.buildLabel}
        columns={[scope.notCoverLabel]}
        rows={scope.rows.map(({ build, notCover }) => ({ feature: build, values: [notCover] }))}
      />
    </div>
  </section>

  {
    /* ═══════════════════════════════════════════════════════════
      SECTION 5 — CTA BANNER
      Matches homepage CTA section exactly
  ════════════════════════════════════════════════════════════ */
  }
  <BrickMotifCTA
    heading={cta.heading}
    note={cta.note}
    phoneLabel={`Call ${CONTACT.phone.display}`}
  />
</Layout>
