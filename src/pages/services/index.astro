---
/**
 * Services hub page — /services/
 * Content: docs/service/Vaifoou Construction Service Pages - Main.docx
 * Design: matches homepage section patterns (H2 · body · cards · CTA banner)
 */
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import PhoneIcon from '~/components/ui/PhoneIcon.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import brickMotif from '~/assets/brick-motif-wide-light.svg';
import iconRockWall from '~/assets/icons/rock-wall.svg';
import iconWalls from '~/assets/icons/walls.svg';
import iconHammer from '~/assets/icons/hammer.svg';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_HREF, PRIMARY_CTA_LABEL } from '~/config/cta';

const metadata = {
  title: "O'ahu Masonry & Concrete Services | Vaifoou Construction",
  description: "Masonry and concrete services for O'ahu properties. Specializing in rock walls, CMU block, and concrete flatwork. Request an estimate.",
  ignoreTitleTemplate: true,
};

const capabilities = [
  {
    icon: iconRockWall,
    iconW: 22,
    iconH: 12,
    title: 'Rock Walls',
    description:
      'Custom property boundaries and retaining structures built with hand-selected volcanic basalt.',
    subLinks: [
      { text: 'Veneer Rock Walls',   href: '/services/rock-walls/veneer/'   },
      { text: 'Rock Wall Repair',    href: '/services/rock-walls/repair/'   },
      { text: 'Rock Retaining Walls',href: '/services/rock-walls/retaining/'},
    ],
  },
  {
    icon: iconWalls,
    iconW: 18,
    iconH: 14,
    title: 'Retaining Walls',
    description:
      'Rock and CMU options compared for hillside retention.',
    subLinks: [],
  },
  {
    icon: iconWalls,
    iconW: 18,
    iconH: 14,
    title: 'CMU & Block Walls',
    description:
      'Retaining walls and block fences built for long-term stability.',
    subLinks: [],
  },
  {
    icon: iconHammer,
    iconW: 16,
    iconH: 18,
    title: 'Concrete Services',
    description:
      'Custom driveways, new foundations, and decorative surfaces poured for durability.',
    subLinks: [
      { text: 'Driveways',               href: '/services/concrete/driveways/'          },
      { text: 'Sidewalks & Walkways',    href: '/services/concrete/sidewalks/'          },
      { text: 'Patios',                  href: '/services/concrete/patios/'             },
      { text: 'Steps & Stairways',       href: '/services/concrete/steps/'              },
      { text: 'Foundations',             href: '/services/concrete/foundations/'        },
      { text: 'Stamped & Decorative',    href: '/services/concrete/stamped-decorative/' },
      { text: 'Sealing',                 href: '/services/concrete/sealing/'            },
    ],
  },
];

const scopeRows = [
  { build: 'Rock wall construction and repair',      notCover: 'Landscaping and landscape design'   },
  { build: 'Concrete flatwork and foundations',      notCover: 'Structural foundation repair'       },
  { build: 'CMU and block retaining walls',          notCover: 'Micropile drilling and tiebacks'    },
  { build: 'Site preparation for concrete pours',    notCover: 'General tree and shrub removal'     },
];
---

<Layout metadata={metadata}>

  {/* ═══════════════════════════════════════════════════════════
      SECTION 1 — PAGE HERO
      Dark bg · H1 · subtitle · 2 CTAs
  ════════════════════════════════════════════════════════════ */}
  <section class="relative w-full overflow-hidden border-b border-banner-line min-h-[400px] md:min-h-[500px]">

    {/* Background photo placeholder */}
    <HeroImagePlaceholder fill hideLabel class="absolute inset-0" label="Services hero image placeholder" />

    {/* Gradient overlay */}
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgb(28 27 26 / 90%) 0%, rgb(28 27 26 / 72%) 55%, rgb(28 27 26 / 30%) 100%);"
      aria-hidden="true"
    ></div>

    {/* Content */}
    <div class="site-frame relative z-10 flex flex-col items-start gap-4 pb-16 pt-16 md:pb-24 md:pt-24">
      <h1 class="max-w-[896px] font-display text-[36px] font-bold leading-none tracking-[-0.4px] text-page-end uppercase md:text-[72px] md:tracking-[-0.8px]">O'ahu Masonry &amp; Concrete Services</h1>

      <p class="max-w-[640px] font-display text-[16px] font-semibold leading-snug tracking-[0.2px] text-page/80 md:text-[24px] md:leading-[34px] md:tracking-[0.24px]">
        We build custom rock walls, CMU and block walls, and concrete for residential and commercial properties across O'ahu.
      </p>

      <div class="flex flex-wrap items-center gap-4 pb-8 pt-2 md:pb-12 md:pt-6">
        <a
          href={PRIMARY_CTA_HREF}
          class="inline-flex items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
        >
          {PRIMARY_CTA_LABEL}
        </a>
        <a
          href={CONTACT.phone.href}
          class="inline-flex items-center justify-center gap-2 border border-muted/30 bg-banner-text px-10 py-4 text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
        >
          <PhoneIcon />
          Call {CONTACT.phone.display}
        </a>
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════
      SECTION 2 — AUDIENCE PATHWAYS
      bg-page · H2 · body · 2 audience cards
  ════════════════════════════════════════════════════════════ */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">

      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]">Dedicated to Homeowners, Property Managers and Contractors</h2>
        <p class="max-w-[896px] pt-3 font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]">
          Our crews handle new construction, and demolition and rebuilds of failing walls, across the island. We work directly with homeowners, commercial property owners, property managers and HOAs, and as a masonry and concrete subcontractor to general contractors.
        </p>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2 md:gap-10">
        {[
          {
            label: 'Residential',
            title: 'Working on your home?',
            cta: 'View Residential Masonry & Concrete',
            href: '/who-we-work-with/residential/',
          },
          {
            label: 'Commercial & Civil',
            title: 'Managing a commercial property, an HOA or a job site?',
            cta: 'View Commercial Masonry & Concrete',
            href: '/who-we-work-with/commercial/',
          },
        ].map(({ label, title, cta, href }) => (
          <article class="flex h-full flex-col overflow-hidden border border-banner-line bg-card">
            <div class="relative h-48 w-full shrink-0 md:h-[240px]">
              <!-- TODO: replace with <Image> when asset is ready -->
              <HeroImagePlaceholder fill class="absolute inset-0" label={`${label} image placeholder`} />
            </div>
            <div class="flex flex-1 flex-col p-6 md:p-10">
              <h3 class="font-display text-[22px] font-semibold leading-7 tracking-[0.22px] text-heading uppercase md:text-[26px] md:leading-8">
                {title}
              </h3>
              <div class="mt-auto pt-8">
                <a
                  href={href}
                  class="cta-md inline-flex w-fit items-center justify-center gap-2 bg-nav-cta text-center font-display text-[16px] font-bold leading-6 tracking-[1px] text-page-end uppercase transition-colors hover:bg-heading md:text-[18px]"
                >
                  {cta}
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
                    <path d="M12.175 9H0V7H12.175L6.575 1.4L8 0L16 8L8 16L6.575 14.6L12.175 9Z" fill="white"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════
      SECTION 3 — CORE CAPABILITIES
      bg-card · 2×2 service card grid · sub-service links
  ════════════════════════════════════════════════════════════ */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">

      <div class="flex max-w-[896px] flex-col gap-1 border-b border-banner-line pb-6">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]">Core Masonry &amp; Concrete Capabilities</h2>
      </div>

      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 md:gap-8">
        {capabilities.map(({ icon, iconW, iconH, title, description, subLinks }) => (
          <article class="flex h-full flex-col border border-banner-line bg-white p-6 md:p-10">
            <div class="flex flex-col gap-3 flex-1">
              {/* Icon inline with title */}
              <h3 class="flex items-center gap-2.5 font-display text-[22px] font-semibold leading-none tracking-[0.22px] text-heading uppercase md:text-[26px]">
                <Image
                  src={icon}
                  alt=""
                  width={iconW}
                  height={iconH}
                  class="h-[18px] w-auto shrink-0"
                  aria-hidden="true"
                />
                {title}
              </h3>
              <p class="font-body text-[16px] font-normal leading-6 text-banner-note">{description}</p>

              {subLinks.length > 0 && (
                <p class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-1 font-body text-[13px] font-semibold leading-5 tracking-[0.3px] text-nav-cta uppercase">
                  {subLinks.map(({ text, href: subHref }, index) => (
                    <>
                      {index > 0 && <span class="text-muted" aria-hidden="true">·</span>}
                      <a href={subHref} class="transition-colors hover:text-heading">
                        {text}
                      </a>
                    </>
                  ))}
                </p>
              )}
            </div>

          </article>
        ))}
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════
      SECTION 4 — SERVICE SCOPE TABLE
      bg-page · "What We Build" vs "What We Do Not Cover"
  ════════════════════════════════════════════════════════════ */}
  <section class="w-full border-b border-banner-line bg-page py-6 md:py-24">
    <div class="site-frame flex flex-col gap-8 md:gap-12">

      <div class="flex max-w-[896px] flex-col gap-1">
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[40px] md:leading-[48px] md:tracking-[-0.2px]">Service Scope</h2>
      </div>

      <div class="overflow-hidden border border-banner-line">
        {/* Table header */}
        <div class="grid grid-cols-2 border-b border-white/10 bg-footer">
          <div class="px-6 py-4 font-display text-[13px] font-bold leading-4 tracking-[1.3px] text-page-end uppercase">
            What We Build
          </div>
          <div class="border-l border-white/10 px-6 py-4 font-display text-[13px] font-bold leading-4 tracking-[1.3px] text-page-end uppercase">
            What We Do Not Cover
          </div>
        </div>
        {/* Table rows — very subtle alternation */}
        {scopeRows.map(({ build, notCover }, i) => (
          <div class:list={['grid grid-cols-2 border-b border-banner-line last:border-b-0', i % 2 === 0 ? 'bg-white' : 'bg-page']}>
            <div class="flex items-center gap-2 px-6 py-4 font-body text-[15px] font-normal leading-6 text-heading">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-nav-cta" aria-hidden="true"></span>
              {build}
            </div>
            <div class="flex items-center gap-2 border-l border-banner-line px-6 py-4 font-body text-[15px] font-normal leading-6 text-muted">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-muted/40" aria-hidden="true"></span>
              {notCover}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  {/* ═══════════════════════════════════════════════════════════
      SECTION 5 — CTA BANNER
      Matches homepage CTA section exactly
  ════════════════════════════════════════════════════════════ */}
  <section class="w-full bg-card py-6 md:py-24">
    <div class="site-frame">
      <div class="@container relative w-full overflow-hidden border border-banner-line bg-section-grey p-4 shadow-[0_20px_25px_-5px_rgb(0_0_0/0.1),0_8px_10px_-6px_rgb(0_0_0/0.1)] md:p-24">
        {/* Brick motif background */}
        <Image
          src={brickMotif}
          alt=""
          width={2560}
          height={1200}
          class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left-top"
          aria-hidden="true"
        />

        <div class="relative z-10 flex max-w-[768px] flex-col items-start">
          <h2 class="mb-4 font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[56px] md:leading-[60px] md:tracking-[-0.28px]">Start Your O'ahu Masonry Project</h2>
          <p class="font-body text-[16px] font-normal leading-7 text-banner-note md:text-[18px] md:leading-[29.25px]">
            Connect with our team to discuss your concrete or rock wall requirements. Please note we are closed on Sundays.
          </p>
        </div>

        <div class="relative z-10 flex flex-wrap items-center gap-4 py-16">
          <a
            href={PRIMARY_CTA_HREF}
            class="inline-flex items-center justify-center bg-nav-cta px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_10px_15px_-3px_rgb(0_0_0/0.1),0_4px_6px_-4px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
          >
            {PRIMARY_CTA_LABEL}
          </a>
          <a
            href={CONTACT.phone.href}
            class="inline-flex items-center justify-center gap-2 bg-banner-text px-10 py-4 text-center font-display text-[18px] font-bold leading-6 tracking-[1px] text-page-end uppercase shadow-[0_4px_6px_-1px_rgb(0_0_0/0.1),0_2px_4px_-2px_rgb(0_0_0/0.1)] transition-colors hover:bg-heading md:text-[20px]"
          >
            <PhoneIcon />
            Call {CONTACT.phone.display}
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
