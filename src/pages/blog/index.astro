---
import Layout from '~/layouts/PageLayout.astro';
import SubServiceHero from '~/components/widgets/SubServiceHero.astro';
import BlogCard from '~/components/ui/BlogCard.astro';
import BrickMotifCTA from '~/components/widgets/BrickMotifCTA.astro';
import { getBlogPosts } from '~/lib/content';
import { site } from '~/config/site';

export const prerender = false;

const posts = await getBlogPosts();

const metadata = {
  title: `Blog | ${site.name}`,
  description: `Masonry tips, project spotlights and trade insights from the Vaifoou Construction team on O\u02BBahu.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  {/* ── Hero ──────────────────────────────────────────────────────── */}
  <SubServiceHero
    eyebrow="Insights"
    title="Masonry & Concrete Blog"
    body="Tips, project spotlights and trade insights from our O\u02BBahu masonry team."
    imagePlaceholder="Vaifoou Construction blog photo"
  />

  {/* ── Posts grid ────────────────────────────────────────────────── */}
  <section class="w-full border-b border-banner-line bg-card py-6 md:py-24">
    <div class="site-frame flex flex-col gap-12 md:gap-16">

      {/* Section header */}
      <div class="flex max-w-[896px] flex-col gap-1 border-b border-banner-line pb-6">
        <p class="flex items-center gap-2 font-body text-[12px] font-bold leading-4 tracking-[1.2px] text-muted uppercase">
          <span class="h-3 w-1.5 rounded-full bg-nav-cta" aria-hidden="true"></span>
          {posts.length ? `${posts.length} Article${posts.length === 1 ? '' : 's'}` : 'Articles'}
        </p>
        <h2 class="font-display text-[28px] font-bold leading-tight tracking-[-0.2px] text-heading uppercase md:text-[44px] md:leading-[52px]">
          Latest Articles
        </h2>
      </div>

      {/* Grid or empty state */}
      {posts.length ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} variant="light" />
          ))}
        </div>
      ) : (
        <div class="flex flex-col gap-4 border border-banner-line bg-white p-8 md:p-12">
          <p class="font-display text-[18px] font-bold leading-tight tracking-[-0.1px] text-heading uppercase md:text-[22px]">
            Coming Soon
          </p>
          <p class="font-body text-[16px] font-normal leading-7 text-banner-note">
            New articles from our masonry team will appear here as they are published.
          </p>
        </div>
      )}

    </div>
  </section>

  {/* ── CTA closer ────────────────────────────────────────────────── */}
  <BrickMotifCTA heading="Start Your O\u02BBahu Masonry Project" />

</Layout>
