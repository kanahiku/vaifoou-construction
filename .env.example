# ─── Sanity — Astro site (required) ────────────────────────────────────────────
# Project: vaifoou-construction (2481svtr). Tokens stay empty until you add a viewer token.
SANITY_PROJECT_ID=2481svtr
SANITY_DATASET=production
SANITY_API_TOKEN=          # Viewer (read-only) token

# ─── Sanity — Migration script (write access) ──────────────────────────────────
# Only needed when running: npx tsx scripts/migrate-to-sanity.ts
SANITY_WRITE_TOKEN=        # Editor token

# ─── Sanity — Studio ────────────────────────────────────────────────────────────
# Add these in studio/.env (same values as above)
# SANITY_STUDIO_PROJECT_ID=2481svtr
# SANITY_STUDIO_DATASET=production
# SANITY_STUDIO_HOSTNAME=vaifoou-construction

# ─── Contact form (public, baked into HTML) ────────────────────────────────────
# Posts to the shared Cloudflare Worker. Do not put RESEND_API_KEY on Vercel.
# Local: PUBLIC_FORM_ENDPOINT=http://localhost:8787/submit and `npm run forms:dev`
PUBLIC_FORM_ENDPOINT=https://massic-forms.kanahiku.workers.dev/submit
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SITE_SLUG=vaifoou-construction
SITE_NAME=Vaifoou Construction

# ─── Google Tag Manager + Search Console ───────────────────────────────────────
# These are not env vars. Put them in src/config/site.ts:
#   analytics.googleTagManagerId
#   analytics.googleSiteVerificationId

# ─── Site URL ──────────────────────────────────────────────────────────────────
# SITE_URL=https://example.com

# ─── ISR / Sanity publish → live (required in production) ─────────────────────
# These are NOT issued by Sanity or Vercel. Generate them (openssl rand -hex 32).
# Then paste the SAME values into:
#   Vercel → Project → Settings → Environment Variables
#   Sanity → Project → API → Webhooks → Authorization: Bearer <SANITY_REVALIDATE_SECRET>
ISR_BYPASS_TOKEN=
SANITY_REVALIDATE_SECRET=

# ─── Reviews (Google Places + Yelp Fusion) ─────────────────────────────────────
# Server-only. Do not prefix with PUBLIC_. Empty keys skip that source; View all still uses the URLs.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=
YELP_API_KEY=
YELP_BUSINESS_ID=
YELP_REVIEWS_URL=
